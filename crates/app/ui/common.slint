// Ezoo Download – shared look: data types, themes, icons and small widgets.

import { Button, LineEdit, SpinBox, CheckBox as StdCheckBox, ComboBox, ListView, TabWidget, TextEdit, Palette } from "std-widgets.slint";

export struct DownloadRow {
    id: int,
    name: string,
    // file type icon: video, audio, archive, pdf, doc, sheet, slides, text, exe, apk, disc, image, general
    kind: string,
    category: string,
    queue: string,
    size: string,
    status: string,
    progress: float,
    eta: string,
    speed: string,
    last-try: string,
    description: string,
    added: string,
    // part of the multiple selection (Ctrl / Shift click, Ctrl+A)
    sel: bool,
    save-to: string,
    referer: string,
    parent: string,
    // 0 queued, 1 running, 2 paused, 3 complete, 4 error
    state: int,
}

// a column of the download list, in the order shown (drag to move / resize)
export struct ColDef {
    key: string,
    width: length,
}

// which list columns are visible (View > Columns)
export struct Cols {
    q: bool,
    size: bool,
    status: bool,
    eta: bool,
    speed: bool,
    last: bool,
    desc: bool,
    added: bool,
    saveto: bool,
    referer: bool,
    parent: bool,
}

// a category in the sidebar
export struct CatRow {
    name: string,
    // the name in the current language
    label: string,
    // icon kind
    kind: string,
    count: string,
    unfinished: string,
    finished: string,
    builtin: bool,
}

// one row of a simple two/three column list (logins, server exceptions...)
export struct PairRow {
    a: string,
    b: string,
    c: string,
}

// a file found by the site grabber / "download all links"
export struct LinkRow {
    checked: bool,
    name: string,
    kind: string,
    ext: string,
    text: string,
    url: string,
}

export struct QueueRow {
    id: int,
    name: string,
    count: int,
    running: bool,
}

// one connection of a download (progress window)
export struct SegView {
    // this connection is receiving right now
    busy: bool,
    start: float,
    done: float,
    number: string,
    downloaded: string,
    info: string,
}

// ------------------------------------------------------------------ themes
// 0 Light, 1 Dark, 2 Ocean, 3 Midnight

export global Theme {
    in-out property <int> mode: 0;
    // themes: Light, Dark, Ocean blue, Midnight purple, Forest green, Black,
    // Sunset, Teal night, Rose
    out property <bool> dark: mode == 1 || mode == 3 || mode == 5 || mode == 7;
    // Options > General > Text size / Font
    in-out property <float> font-scale: 1.0;
    in-out property <string> font-family: "";
    // a picture behind the main window: how much of it shows through (0..0.8)
    in-out property <float> glass: 0;
    // Arabic: every window reads from right to left
    in-out property <bool> rtl: false;
    out property <color> window: window-base;
    out property <color> panel: panel-base.transparentize(glass);
    out property <color> toolbar-top: toolbar-top-base.transparentize(glass);
    out property <color> toolbar-bottom: toolbar-bottom-base.transparentize(glass);
    out property <color> header-top: header-top-base.transparentize(glass);
    out property <color> header-bottom: header-bottom-base.transparentize(glass);
    out property <color> grid: grid-base.transparentize(glass);
    property <color> window-base: [#f0f0f0, #1e1f22, #e8f1fb, #15131d, #eef5ef, #000000, #fbf1ea, #0f1c1e, #fbf0f4][mode];
    property <color> panel-base: [#ffffff, #26282c, #ffffff, #1d1a29, #ffffff, #0b0b0b, #ffffff, #142527, #ffffff][mode];
    property <color> toolbar-top-base: [#fdfdfd, #2e3136, #2f80ed, #2b2545, #2f9e5b, #121212, #f07b3f, #1b3a3d, #e05a8a][mode];
    property <color> toolbar-bottom-base: [#e7ebf0, #24262a, #1b5fc4, #1e1a33, #1f7a43, #050505, #d4513a, #132b2e, #c23d6e][mode];
    out property <color> toolbar-text: [#1b1f24, #e8eaed, #ffffff, #ece9f6, #ffffff, #f2f2f2, #ffffff, #e3f4f3, #ffffff][mode];
    out property <color> toolbar-hover: [#e5f1fb, #3a3e45, #4a92f0, #3a3260, #45b06f, #262626, #f5955f, #26504f, #e97aa1][mode];
    out property <color> line: [#d9dde3, #3a3d42, #c6d8ef, #352f4d, #c9dfcf, #262626, #efd2c2, #24403f, #efcdda][mode];
    property <color> grid-base: [#eef0f3, #2f3237, #eaf2fc, #26223a, #eaf4ec, #141414, #fbeee6, #1a2e30, #fbedf2][mode];
    property <color> header-top-base: [#ffffff, #2e3136, #f7fbff, #26223a, #f8fcf9, #161616, #fffaf6, #1b3133, #fffafc][mode];
    property <color> header-bottom-base: [#eef1f5, #282a2e, #e3eefb, #201c31, #e2f0e6, #0e0e0e, #f8e5d9, #16292b, #f8e3eb][mode];
    out property <color> text: [#1b1f24, #e8eaed, #13243a, #ece9f6, #15281b, #f2f2f2, #2e1a12, #e3f4f3, #2e1420][mode];
    out property <color> muted: [#5f6b78, #9aa0a6, #557090, #a59fc0, #557a61, #9a9a9a, #8a6352, #8fb3b0, #8a5a6c][mode];
    out property <color> accent: [#1f6feb, #5b9dff, #1565c0, #a78bfa, #1f8a4c, #4ea1ff, #d4513a, #2ec4b6, #c23d6e][mode];
    out property <color> select: [#cce8ff, #264f78, #cfe4ff, #3d3366, #cdebd7, #1f3550, #fbd9c8, #1d4b4b, #f8d3e1][mode];
    out property <color> select-line: [#99d1ff, #3a6ea5, #8dbcf5, #5b4a99, #8ccaa2, #2f5a8a, #eea98a, #2b7470, #eaa0bb][mode];
    out property <color> hover: [#e5f3ff, #2c3440, #e3efff, #2a2541, #e2f3e7, #1a1a1a, #fdeadf, #1b3436, #fde6ee][mode];
    out property <color> ok: dark ? #3fcf7a : #1f9d55;
    out property <color> warn: #e08a00;
    out property <color> err: dark ? #ff6b62 : #d23b32;
    out property <color> bar-bg: dark ? #34373c : #e6e6e6;
    out property <color> input-bg: dark ? #2b2d31 : #ffffff;
}

// A row that runs from right to left for Arabic (Theme.rtl), otherwise
// like HorizontalLayout.
export component HRow inherits FlexboxLayout {
    flex-direction: Theme.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
    flex-wrap: no-wrap;
    alignment: stretch;
}

// The standard check box, with the box on the right for Arabic (Theme.rtl).
export component CheckBox inherits VerticalLayout {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();
    alignment: center;
    if !Theme.rtl: StdCheckBox {
        text: root.text;
        enabled: root.enabled;
        checked <=> root.checked;
        toggled => {
            root.toggled();
        }
    }
    if Theme.rtl: Rectangle {
        min-height: 20px;
        accessible-role: checkbox;
        accessible-checkable: true;
        accessible-checked: root.checked;
        accessible-label: root.text;
        accessible-enabled: root.enabled;
        accessible-action-default => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled();
            }
        }
        opacity: root.enabled ? 1.0 : 0.45;
        rtl-touch := TouchArea {
            enabled: root.enabled;
            clicked => {
                root.checked = !root.checked;
                root.toggled();
            }
        }
        HRow {
            spacing: 12px;
            alignment: start;
            Rectangle {
                width: 18px;
                Rectangle {
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    border-radius: 3px;
                    border-width: root.checked ? 0px : 1px;
                    border-color: Theme.muted;
                    background: root.checked ? Theme.accent : rtl-touch.has-hover ? Theme.hover : Theme.input-bg;
                    if root.checked: Path {
                        x: 3px;
                        y: 3px;
                        width: 12px;
                        height: 12px;
                        viewbox-width: 12;
                        viewbox-height: 12;
                        stroke: white;
                        stroke-width: 1.6px;
                        fill: transparent;
                        commands: "M 1.5 6.5 L 4.5 9.5 L 10.5 2.5";
                    }
                }
            }
            Text {
                text: root.text;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: Theme.text;
            }
        }
    }
}

// Applies the light/dark look to the standard widgets of every window.
export component ThemedWindow inherits Window {
    property <bool> dark: Theme.dark;
    changed dark => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }
    background: Theme.window;
    // 12px is the size Windows gives Slint by default (the message font)
    default-font-size: 12px * Theme.font-scale;
    default-font-family: Theme.font-family;
    icon: @image-url("icon-window.png");
}

// A button of a window's own title bar (windows drawn without the Windows
// frame): "tray" (hide next to the clock), "min" or "close".
export component CaptionButton inherits Rectangle {
    in property <string> kind;
    callback clicked();
    out property <bool> hovered: ca.has-hover;
    width: 44px;
    background: ca.pressed ? (root.kind == "close" ? #c50f1f : Theme.line) : ca.has-hover ? (root.kind == "close" ? #e81123 : Theme.hover) : transparent;
    ca := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Path {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke-width: 1px;
        stroke: root.kind == "close" && ca.has-hover ? white : Theme.text;
        fill: transparent;
        commands: root.kind == "close" ? "M 0 0 L 10 10 M 10 0 L 0 10"
            : root.kind == "min" ? "M 0 5.5 L 10 5.5"
            // an arrow down into a tray
            : "M 5 0 L 5 6.5 M 2.2 3.8 L 5 6.5 L 7.8 3.8 M 0.5 6.5 L 0.5 9.5 L 9.5 9.5 L 9.5 6.5";
    }
}

// Small vector icons for menus, lists and buttons (fonts on Windows don't
// have every symbol, so nothing here depends on a font).
export component Glyph inherits Rectangle {
    // play, progress, openwith, folder, pause, stop, redo, refresh, edit, check,
    // copy, hash, info, close, clock, plus, warn, down, up, caret-down, caret-up,
    // bulb, queue
    in property <string> kind;
    in property <color> tint: Theme.accent;
    width: 16px;
    height: 16px;
    if root.kind == "play": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.tint;
        commands: "M 4 2.5 L 13 8 L 4 13.5 Z";
    }
    if root.kind == "progress": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.6px;
        fill: transparent;
        commands: "M 8 1.8 A 6.2 6.2 0 1 1 7.99 1.8 Z M 8 4.5 L 8 8 L 10.8 9.6";
    }
    if root.kind == "openwith": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M 2 4 L 2 14 L 12 14 L 12 9 M 7 9 L 14 2 M 9 2 L 14 2 L 14 7";
    }
    if root.kind == "folder": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        fill: #f2b531;
        stroke: #c98a10;
        stroke-width: 1px;
        commands: "M 1.5 3.5 L 6 3.5 L 7.5 5 L 14.5 5 L 14.5 13 L 1.5 13 Z";
    }
    if root.kind == "pause": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.tint;
        commands: "M 4 3 L 7 3 L 7 13 L 4 13 Z M 9 3 L 12 3 L 12 13 L 9 13 Z";
    }
    if root.kind == "stop": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.tint;
        commands: "M 3.5 3.5 L 12.5 3.5 L 12.5 12.5 L 3.5 12.5 Z";
    }
    if root.kind == "redo": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.7px;
        fill: transparent;
        commands: "M 13 8 A 5 5 0 1 1 10.5 3.7 M 9.5 1.5 L 11.5 4 L 8.8 5.6";
    }
    if root.kind == "refresh": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M 2.5 7 A 5.5 5.5 0 0 1 12.8 5 M 13.5 9 A 5.5 5.5 0 0 1 3.2 11 M 13 2 L 13 5.2 L 9.8 5.2 M 3 14 L 3 10.8 L 6.2 10.8";
    }
    if root.kind == "edit": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.4px;
        fill: transparent;
        commands: "M 2.5 13.5 L 3.2 10.4 L 10.8 2.8 L 13.2 5.2 L 5.6 12.8 Z M 9.4 4.2 L 11.8 6.6";
    }
    if root.kind == "check": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 2px;
        fill: transparent;
        commands: "M 2.5 8.5 L 6.3 12 L 13.5 4";
    }
    if root.kind == "copy": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.4px;
        fill: transparent;
        commands: "M 5.5 5.5 L 13.5 5.5 L 13.5 14 L 5.5 14 Z M 3 11 L 2.5 11 L 2.5 2 L 10.5 2 L 10.5 3";
    }
    if root.kind == "hash": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.4px;
        fill: transparent;
        commands: "M 6 2 L 4.5 14 M 11.5 2 L 10 14 M 2.5 5.5 L 14 5.5 M 2 10.5 L 13.5 10.5";
    }
    if root.kind == "info": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.4px;
        fill: transparent;
        commands: "M 8 1.8 A 6.2 6.2 0 1 1 7.99 1.8 Z M 8 7 L 8 12 M 8 4.2 L 8 5.4";
    }
    if root.kind == "close": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 2px;
        fill: transparent;
        commands: "M 3.5 3.5 L 12.5 12.5 M 12.5 3.5 L 3.5 12.5";
    }
    if root.kind == "clock": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M 8 1.8 A 6.2 6.2 0 1 1 7.99 1.8 Z M 8 4 L 8 8 L 11 9.5";
    }
    if root.kind == "plus": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 2px;
        fill: transparent;
        commands: "M 8 2.5 L 8 13.5 M 2.5 8 L 13.5 8";
    }
    if root.kind == "minus": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 2px;
        fill: transparent;
        commands: "M 2.5 8 L 13.5 8";
    }
    if root.kind == "warn": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        fill: #e08a00;
        commands: "M 8 1.5 L 15 14 L 1 14 Z M 7.2 5.5 L 8.8 5.5 L 8.5 10 L 7.5 10 Z M 7.3 11.2 L 8.7 11.2 L 8.7 12.6 L 7.3 12.6 Z";
    }
    if root.kind == "down": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.tint;
        commands: "M 6.5 2 L 9.5 2 L 9.5 8 L 13 8 L 8 14 L 3 8 L 6.5 8 Z";
    }
    if root.kind == "up": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.tint;
        commands: "M 6.5 14 L 9.5 14 L 9.5 8 L 13 8 L 8 2 L 3 8 L 6.5 8 Z";
    }
    if root.kind == "caret-down": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.tint;
        commands: "M 4 6 L 12 6 L 8 11 Z";
    }
    if root.kind == "caret-up": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.tint;
        commands: "M 4 10 L 12 10 L 8 5 Z";
    }
    if root.kind == "bulb": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        fill: #ffd54a;
        stroke: #b8860b;
        stroke-width: 1px;
        commands: "M 8 1.5 A 4.8 4.8 0 0 1 11 10 L 10.5 12 L 5.5 12 L 5 10 A 4.8 4.8 0 0 1 8 1.5 Z M 6 13.5 L 10 13.5";
    }
    if root.kind == "queue": Path {
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.tint;
        commands: "M 2 3 L 10 3 L 10 4.6 L 2 4.6 Z M 2 6.5 L 10 6.5 L 10 8.1 L 2 8.1 Z M 2 10 L 7 10 L 7 11.6 L 2 11.6 Z M 9.5 9 L 14.5 12 L 9.5 15 Z";
    }
}

// ------------------------------------------------------------------ icons

export component P inherits Path {
    viewbox-width: 32;
    viewbox-height: 32;
}

// Toolbar icons, drawn on a 32x32 grid.
export component Icon inherits Rectangle {
    in property <string> kind;
    width: 32px;
    height: 32px;
    if root.kind == "add": Rectangle {
        P {
            fill: @linear-gradient(180deg, #45c06a 0%, #23934a 100%);
            commands: "M 16 2 A 14 14 0 1 1 15.99 2 Z";
        }
        P {
            fill: white;
            commands: "M 14 8 L 18 8 L 18 14 L 24 14 L 24 18 L 18 18 L 18 24 L 14 24 L 14 18 L 8 18 L 8 14 L 14 14 Z";
        }
    }
    if root.kind == "batch": Rectangle {
        P {
            fill: #dde6f1;
            stroke: #6b7c90;
            stroke-width: 1.5px;
            commands: "M 11 3 L 26 3 L 26 22 L 11 22 Z";
        }
        P {
            fill: white;
            stroke: #6b7c90;
            stroke-width: 1.5px;
            commands: "M 5 8 L 20 8 L 20 28 L 5 28 Z M 8 13 L 17 13 M 8 17 L 17 17 M 8 21 L 14 21";
        }
        P {
            fill: #2e9e4f;
            commands: "M 24 17 A 7 7 0 1 1 23.99 17 Z";
        }
        P {
            fill: white;
            commands: "M 23 20 L 25 20 L 25 23 L 28 23 L 28 25 L 25 25 L 25 28 L 23 28 L 23 25 L 20 25 L 20 23 L 23 23 Z";
        }
    }
    if root.kind == "playlist": Rectangle {
        // a green player with a list in front of it
        P {
            fill: @linear-gradient(180deg, #4cd47a 0%, #1e9e4c 100%);
            commands: "M 6 4 L 28 4 Q 31 4 31 7 L 31 19 Q 31 22 28 22 L 6 22 Q 3 22 3 19 L 3 7 Q 3 4 6 4 Z";
        }
        P {
            fill: white;
            commands: "M 14 8 L 21 13 L 14 18 Z";
        }
        P {
            fill: #33475b;
            commands: "M 3 24 L 20 24 L 20 26 L 3 26 Z M 3 28 L 20 28 L 20 30 L 3 30 Z";
        }
        P {
            fill: #1f6feb;
            commands: "M 25 21 A 6 6 0 1 1 24.99 21 Z";
        }
        P {
            fill: white;
            commands: "M 24 23 L 26 23 L 26 27 L 28 27 L 25 30 L 22 27 L 24 27 Z";
        }
    }
    if root.kind == "torrent": Rectangle {
        // a red magnet with a download arrow
        P {
            fill: @linear-gradient(180deg, #ff5a7a 0%, #c81e45 100%);
            commands: "M 3 3 L 10 3 L 10 14 A 4 4 0 0 0 18 14 L 18 3 L 25 3 L 25 14 A 11 11 0 0 1 3 14 Z";
        }
        P {
            fill: #dfe6ee;
            commands: "M 3 3 L 10 3 L 10 8 L 3 8 Z M 18 3 L 25 3 L 25 8 L 18 8 Z";
        }
        P {
            fill: #1f6feb;
            commands: "M 25 18 A 6.5 6.5 0 1 1 24.99 18 Z";
        }
        P {
            fill: white;
            commands: "M 24 20.5 L 26 20.5 L 26 24.5 L 28.3 24.5 L 25 28.3 L 21.7 24.5 L 24 24.5 Z";
        }
    }
    if root.kind == "grabber": Rectangle {
        // a globe with a download arrow
        P {
            fill: @linear-gradient(180deg, #5aa8ff 0%, #1f6feb 100%);
            commands: "M 14 3 A 11 11 0 1 1 13.99 3 Z";
        }
        P {
            stroke: white;
            stroke-width: 1.2px;
            fill: transparent;
            commands: "M 3 14 L 25 14 M 14 3 C 8 8 8 20 14 25 M 14 3 C 20 8 20 20 14 25 M 5 8 L 23 8 M 5 20 L 23 20";
        }
        P {
            fill: #2e9e4f;
            commands: "M 24 17 A 7 7 0 1 1 23.99 17 Z";
        }
        P {
            fill: white;
            commands: "M 23 19 L 25 19 L 25 24 L 27.5 24 L 24 28 L 20.5 24 L 23 24 Z";
        }
    }
    if root.kind == "find": Rectangle {
        P {
            stroke: #4b5b70;
            stroke-width: 3px;
            fill: #e8f2ff;
            commands: "M 13 4 A 9 9 0 1 1 12.99 4 Z";
        }
        P {
            stroke: #4b5b70;
            stroke-width: 4px;
            commands: "M 19.5 19.5 L 28 28";
        }
    }
    if root.kind == "resume": P {
        fill: @linear-gradient(180deg, #45c06a 0%, #23934a 100%);
        commands: "M 9 5 L 27 16 L 9 27 Z";
    }
    if root.kind == "stop": P {
        fill: @linear-gradient(180deg, #f5a623 0%, #d97d00 100%);
        commands: "M 8 6 L 14 6 L 14 26 L 8 26 Z M 18 6 L 24 6 L 24 26 L 18 26 Z";
    }
    if root.kind == "stopall": Rectangle {
        P {
            fill: #f2a7a2;
            commands: "M 11 3 L 29 3 L 29 21 L 11 21 Z";
        }
        P {
            fill: @linear-gradient(180deg, #ef5a50 0%, #c62f27 100%);
            commands: "M 4 9 L 22 9 L 22 27 L 4 27 Z";
        }
    }
    if root.kind == "delete": P {
        stroke: #e0443b;
        stroke-width: 4.5px;
        commands: "M 8 8 L 24 24 M 24 8 L 8 24";
    }
    if root.kind == "deletedone": Rectangle {
        P {
            fill: #8a96a3;
            commands: "M 7 7 L 25 7 L 25 10 L 7 10 Z M 13 4 L 19 4 L 19 7 L 13 7 Z M 9 11 L 23 11 L 21.5 29 L 10.5 29 Z";
        }
        P {
            stroke: #3fcf7a;
            stroke-width: 3.5px;
            commands: "M 12 19 L 15.5 23 L 22 15";
        }
    }
    if root.kind == "options": Rectangle {
        P {
            stroke: #7d8b9a;
            stroke-width: 2.5px;
            commands: "M 4 9 L 28 9 M 4 16 L 28 16 M 4 23 L 28 23";
        }
        P {
            fill: #3b82f6;
            stroke: white;
            stroke-width: 1px;
            commands: "M 11 5 A 4 4 0 1 1 10.99 5 Z M 21 12 A 4 4 0 1 1 20.99 12 Z M 14 19 A 4 4 0 1 1 13.99 19 Z";
        }
    }
    if root.kind == "scheduler": Rectangle {
        P {
            fill: white;
            stroke: #3b82f6;
            stroke-width: 3px;
            commands: "M 16 3.5 A 12.5 12.5 0 1 1 15.99 3.5 Z";
        }
        P {
            stroke: #2d3a48;
            stroke-width: 2.5px;
            commands: "M 16 9 L 16 16 L 21.5 19.5";
        }
    }
    if root.kind == "limiter": Rectangle {
        P {
            stroke: #7d8b9a;
            stroke-width: 3px;
            commands: "M 5 22 A 11 11 0 1 1 27 22";
        }
        P {
            stroke: #e0443b;
            stroke-width: 3px;
            commands: "M 16 22 L 22 12";
        }
        P {
            fill: #2d3a48;
            commands: "M 16 19.5 A 2.5 2.5 0 1 1 15.99 19.5 Z";
        }
    }
    if root.kind == "startqueue" || root.kind == "stopqueue": Rectangle {
        P {
            stroke: #7d8b9a;
            stroke-width: 3px;
            commands: "M 3 7 L 19 7 M 3 13 L 19 13 M 3 19 L 12 19";
        }
        if root.kind == "startqueue": P {
            fill: #2e9e4f;
            commands: "M 16 15 L 29 22.5 L 16 30 Z";
        }
        if root.kind == "stopqueue": P {
            fill: #e0443b;
            commands: "M 16 17 L 28 17 L 28 29 L 16 29 Z";
        }
    }
    if root.kind == "folder": P {
        fill: @linear-gradient(180deg, #ffd86b 0%, #f2b632 100%);
        stroke: #c99a1e;
        stroke-width: 1.2px;
        commands: "M 3 8 L 12 8 L 15 11 L 29 11 L 29 27 L 3 27 Z";
    }
}

export component G inherits Path {
    viewbox-width: 16;
    viewbox-height: 16;
}

// File-type icon. Every kind has its own shape and color, so they are told
// apart at a glance: a film strip (video), a round note (music), a zipped
// box (archives), a page with a folded corner (documents)…
export component TypeIcon inherits Rectangle {
    in property <string> kind: "general";
    width: 18px;
    height: 18px;
    // documents: a page with a folded corner in their color
    property <bool> page: root.kind == "pdf" || root.kind == "doc" || root.kind == "sheet" || root.kind == "slides" || root.kind == "text" || root.kind == "general";
    property <color> page-color: root.kind == "pdf" ? #e03131
        : root.kind == "doc" ? #2b6cde
        : root.kind == "sheet" ? #1e8e3e
        : root.kind == "slides" ? #e8710a
        : root.kind == "text" ? #6b7785
        : #8a94a0;
    // ---- video: a blue film strip with a play sign
    if root.kind == "video": Rectangle {
        G {
            fill: @linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
            commands: "M 1.5 3 L 14.5 3 L 14.5 13 L 1.5 13 Z";
        }
        G {
            fill: #dbeafe;
            commands: "M 2.3 4 L 3.5 4 L 3.5 5.2 L 2.3 5.2 Z M 2.3 7.4 L 3.5 7.4 L 3.5 8.6 L 2.3 8.6 Z M 2.3 10.8 L 3.5 10.8 L 3.5 12 L 2.3 12 Z M 12.5 4 L 13.7 4 L 13.7 5.2 L 12.5 5.2 Z M 12.5 7.4 L 13.7 7.4 L 13.7 8.6 L 12.5 8.6 Z M 12.5 10.8 L 13.7 10.8 L 13.7 12 L 12.5 12 Z";
        }
        G {
            fill: white;
            commands: "M 6.4 5.4 L 10.6 8 L 6.4 10.6 Z";
        }
    }
    // ---- music: a purple circle with a note
    if root.kind == "audio": Rectangle {
        G {
            fill: @linear-gradient(180deg, #a855f7 0%, #7e22ce 100%);
            commands: "M 8 1 A 7 7 0 1 1 7.99 1 Z";
        }
        G {
            fill: white;
            commands: "M 7.2 4 L 11.2 3.2 L 11.2 4.7 L 8.4 5.3 L 8.4 10.4 A 1.8 1.5 0 1 1 7.2 9.1 Z";
        }
    }
    // ---- archives: a yellow box with a zipper
    if root.kind == "archive": Rectangle {
        G {
            fill: @linear-gradient(180deg, #fbbf24 0%, #d97706 100%);
            commands: "M 2 4 L 14 4 L 14 14 L 2 14 Z";
        }
        G {
            fill: #b45309;
            commands: "M 1.5 2.2 L 14.5 2.2 L 14.5 4.6 L 1.5 4.6 Z";
        }
        G {
            fill: #3f2a07;
            commands: "M 7 4.6 L 9 4.6 L 9 5.6 L 7 5.6 Z M 7 6.6 L 9 6.6 L 9 7.6 L 7 7.6 Z M 7 8.6 L 9 8.6 L 9 9.6 L 7 9.6 Z";
        }
        G {
            fill: white;
            stroke: #3f2a07;
            stroke-width: 0.6px;
            commands: "M 6.6 10.2 L 9.4 10.2 L 9.4 12.8 L 6.6 12.8 Z";
        }
    }
    // ---- documents: a page with a folded corner and its sign
    if root.page: Rectangle {
        G {
            fill: @linear-gradient(180deg, root.page-color.brighter(20%) 0%, root.page-color 100%);
            commands: "M 3 1 L 10 1 L 14 5 L 14 15 L 3 15 Z";
        }
        G {
            fill: root.page-color.darker(35%);
            commands: "M 10 1 L 14 5 L 10 5 Z";
        }
        if root.kind == "pdf" || root.kind == "doc" || root.kind == "text" || root.kind == "general": G {
            stroke: white;
            stroke-width: 1.1px;
            commands: "M 5 7.5 L 12 7.5 M 5 9.8 L 12 9.8 M 5 12.1 L 10 12.1";
        }
        if root.kind == "sheet": G {
            stroke: white;
            stroke-width: 0.9px;
            commands: "M 5 7 L 12 7 L 12 13 L 5 13 Z M 5 9 L 12 9 M 5 11 L 12 11 M 8 7 L 8 13";
        }
        if root.kind == "slides": G {
            fill: white;
            commands: "M 5 12.5 L 6.6 12.5 L 6.6 10 L 5 10 Z M 7.7 12.5 L 9.3 12.5 L 9.3 8 L 7.7 8 Z M 10.4 12.5 L 12 12.5 L 12 9 L 10.4 9 Z";
        }
    }
    // ---- programs: a dark window with a title bar
    if root.kind == "exe": Rectangle {
        G {
            fill: #334155;
            commands: "M 1.5 2.5 L 14.5 2.5 L 14.5 13.5 L 1.5 13.5 Z";
        }
        G {
            fill: #38bdf8;
            commands: "M 1.5 2.5 L 14.5 2.5 L 14.5 5 L 1.5 5 Z";
        }
        G {
            fill: white;
            commands: "M 4 7 L 7 9.2 L 4 11.4 Z M 8 10.4 L 12 10.4 L 12 11.4 L 8 11.4 Z";
        }
    }
    // ---- apps for phones: a green phone
    if root.kind == "apk": Rectangle {
        G {
            fill: @linear-gradient(180deg, #4ade80 0%, #16a34a 100%);
            commands: "M 4.5 1 L 11.5 1 L 11.5 15 L 4.5 15 Z";
        }
        G {
            fill: white;
            commands: "M 5.5 2.5 L 10.5 2.5 L 10.5 12 L 5.5 12 Z";
        }
        G {
            fill: white;
            commands: "M 7.2 13.2 L 8.8 13.2 L 8.8 14.2 L 7.2 14.2 Z";
        }
    }
    // ---- disc images: a silver disc
    if root.kind == "disc": Rectangle {
        G {
            fill: @linear-gradient(135deg, #e2e8f0 0%, #94a3b8 100%);
            stroke: #64748b;
            stroke-width: 0.6px;
            commands: "M 8 1 A 7 7 0 1 1 7.99 1 Z";
        }
        G {
            fill: #475569;
            commands: "M 8 6 A 2 2 0 1 1 7.99 6 Z";
        }
    }
    // ---- pictures: a teal frame with hills and a sun
    if root.kind == "image": Rectangle {
        G {
            fill: @linear-gradient(180deg, #2dd4bf 0%, #0f766e 100%);
            commands: "M 1.5 2.5 L 14.5 2.5 L 14.5 13.5 L 1.5 13.5 Z";
        }
        G {
            fill: white;
            commands: "M 2.5 12.5 L 6.3 7.6 L 8.7 10.4 L 10.3 8.6 L 13.5 12.5 Z";
        }
        G {
            fill: #fde68a;
            commands: "M 11 4 A 1.4 1.4 0 1 1 10.99 4 Z";
        }
    }
    // ---- torrents: a red and gray magnet
    if root.kind == "torrent": Rectangle {
        G {
            fill: #e11d48;
            commands: "M 2 2 L 6 2 L 6 8 A 2 2 0 0 0 10 8 L 10 2 L 14 2 L 14 8 A 6 6 0 0 1 2 8 Z";
        }
        G {
            fill: #cbd5e1;
            commands: "M 2 2 L 6 2 L 6 4.5 L 2 4.5 Z M 10 2 L 14 2 L 14 4.5 L 10 4.5 Z";
        }
    }
}

// Big icon with the file extension under it (dialogs).
export component BigTypeIcon inherits VerticalLayout {
    in property <string> kind;
    in property <string> ext;
    spacing: 4px;
    alignment: start;
    HRow {
        alignment: center;
        TypeIcon {
            kind: root.kind;
            width: 48px;
            height: 48px;
        }
    }
    Text {
        text: root.ext;
        horizontal-alignment: center;
        font-size: 11px * Theme.font-scale;
        font-weight: 700;
        color: Theme.muted;
    }
}

// ------------------------------------------------------------------ main window parts

// The note under a toolbar button the mouse rests on (one per window).
export global ToolTip {
    in-out property <string> title;
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    // the mouse is on a button (the note shows after a moment)
    in-out property <bool> pending;
    in-out property <bool> shown;
}

export component ToolBtn inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> enabled: true;
    // View > Toolbar > Small buttons: icon only
    in property <bool> small;
    callback clicked();
    // small buttons: every one fits a 960 px wide window
    width: root.small ? 34px : 56px;
    height: root.small ? 34px : 56px;
    // a name that is still too long never covers the next button
    clip: true;
    border-radius: 3px;
    border-width: ta.has-hover && root.enabled ? 1px : 0px;
    border-color: Theme.select-line;
    background: !root.enabled ? transparent : ta.pressed ? Theme.select : ta.has-hover ? Theme.toolbar-hover : transparent;
    // what the button does, shown when the mouse rests on it
    pure function describe(k: string) -> string {
        if (k == "add") { return @tr("Download a file from an address you type or paste (Ctrl+N)."); }
        if (k == "batch") { return @tr("Download many links at once, or numbered files from one address (Ctrl+B)."); }
        if (k == "resume") { return @tr("Continue the selected downloads from where they stopped."); }
        if (k == "stop") { return @tr("Pause the selected downloads; they can be resumed later."); }
        if (k == "stopall") { return @tr("Pause every running download."); }
        if (k == "delete") { return @tr("Remove the selected downloads from the list. The files stay on your computer."); }
        if (k == "deletedone") { return @tr("Remove all finished downloads from the list. The files stay on your computer."); }
        if (k == "options") { return @tr("All the settings of the program."); }
        if (k == "scheduler") { return @tr("Start or stop queues at the times you choose."); }
        if (k == "limiter") { return @tr("Limit the download speed so the internet stays usable for other things."); }
        if (k == "startqueue") { return @tr("Start the files of a queue, one after another."); }
        if (k == "stopqueue") { return @tr("Stop the files of a queue."); }
        if (k == "grabber") { return @tr("Collect the files of a web site: pictures, videos, archives…"); }
        if (k == "playlist") { return @tr("Download all or some videos of a playlist."); }
        if (k == "torrent") { return @tr("Download a .torrent file or a magnet link."); }
        return "";
    }
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: true;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        changed has-hover => {
            if (self.has-hover) {
                ToolTip.title = root.text;
                ToolTip.text = root.describe(root.icon);
                ToolTip.x = root.absolute-position.x;
                ToolTip.y = root.absolute-position.y + root.height + 4px;
                ToolTip.shown = false;
                ToolTip.pending = true;
            } else if (ToolTip.title == root.text) {
                ToolTip.pending = false;
                ToolTip.shown = false;
            }
        }
        pointer-event(ev) => {
            // a click hides the note
            if (ev.kind == PointerEventKind.down) {
                ToolTip.pending = false;
                ToolTip.shown = false;
            }
        }
    }
    if !root.small: VerticalLayout {
        alignment: center;
        spacing: 3px;
        padding-left: 1px;
        padding-right: 1px;
        opacity: root.enabled ? 1.0 : 0.35;
        HRow {
            alignment: center;
            Icon {
                width: 26px;
                height: 26px;
                kind: root.icon;
            }
        }
        // a long name goes on two lines ("Delete / Done"); "…" does not work
        // for right-to-left (Arabic) text, which would spill over the next button
        Text {
            text: root.text;
            font-size: 10px * Theme.font-scale;
            // bold, so the names read well on every theme
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: top;
            wrap: word-wrap;
            max-height: 26px * Theme.font-scale;
            color: Theme.toolbar-text;
        }
    }
    if root.small: Icon {
        x: (parent.width - 24px) / 2;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        kind: root.icon;
        opacity: root.enabled ? 1.0 : 0.35;
    }
}

export component ToolSeparator inherits Rectangle {
    width: 7px;
    Rectangle {
        x: 3px;
        y: 8px;
        width: 1px;
        height: parent.height - 16px;
        background: Theme.line;
    }
}

export component TreeItem inherits Rectangle {
    in property <string> text;
    // "folder", "queue", "unfinished", "finished" or a file kind
    in property <string> icon;
    in property <string> count;
    in property <int> indent;
    in property <bool> selected;
    in property <bool> bold;
    // a branch that opens / closes (+ / - in front)
    in property <bool> expandable;
    in property <bool> expanded;
    callback clicked();
    callback toggle();
    // right click, at this position inside the item
    callback context(length, length);
    height: 23px;
    background: root.selected ? Theme.select : ta.has-hover ? Theme.hover : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.select-line;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.toggle();
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.clicked();
                root.context(self.mouse-x, self.mouse-y);
            }
        }
    }
    HRow {
        padding-left: Theme.rtl ? (6px) : (4px + root.indent * 16px);
        padding-right: Theme.rtl ? (4px + root.indent * 16px) : (6px);
        spacing: 5px;
        Rectangle {
            width: 11px;
            if root.expandable: Rectangle {
                y: (parent.height - 11px) / 2;
                width: 11px;
                height: 11px;
                border-width: 1px;
                border-color: Theme.muted;
                background: Theme.panel;
                Rectangle {
                    x: 2px;
                    y: 5px;
                    width: 7px;
                    height: 1px;
                    background: Theme.text;
                }
                if !root.expanded: Rectangle {
                    x: 5px;
                    y: 2px;
                    width: 1px;
                    height: 7px;
                    background: Theme.text;
                }
                TouchArea {
                    clicked => {
                        root.toggle();
                    }
                }
            }
        }
        Rectangle {
            width: 16px;
            if root.icon == "folder": Icon {
                kind: "folder";
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
            }
            if root.icon == "queue": Icon {
                kind: "startqueue";
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
            }
            if root.icon == "unfinished": Glyph {
                kind: "down";
                y: (parent.height - 16px) / 2;
            }
            if root.icon == "finished": Glyph {
                kind: "check";
                tint: Theme.ok;
                y: (parent.height - 16px) / 2;
            }
            if root.icon != "folder" && root.icon != "queue" && root.icon != "unfinished" && root.icon != "finished": TypeIcon {
                kind: root.icon;
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
            }
        }
        Text {
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            color: Theme.text;
            font-size: 12px * Theme.font-scale;
            font-weight: root.bold ? 600 : 400;
        }
        Text {
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.count;
            vertical-alignment: center;
            color: Theme.muted;
            font-size: 11px * Theme.font-scale;
        }
    }
}

export component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <TextHorizontalAlignment> align: left;
    // sorting: this column's key, the current key and direction
    in property <string> key;
    in property <string> sort-by;
    in property <bool> sort-desc;
    // drag the right edge to resize, drag the title to move it
    in property <bool> adjustable;
    callback sort(string);
    // the new width while the edge is dragged; done when it is let go
    callback resized(length);
    callback resize-done();
    // the title was dragged and let go at `x` (in the header)
    callback dropped(length);
    // a long (Arabic) title is cut at its own column, never over the next one
    clip: true;
    property <bool> moving;
    property <length> start-width;
    property <length> start-x;
    height: 24px;
    background: root.moving ? Theme.select : ta.has-hover && (root.key != "" || root.adjustable) ? Theme.hover : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.key != "" || root.adjustable;
        mouse-cursor: root.moving ? MouseCursor.grabbing : MouseCursor.default;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.moving = false;
            }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up && root.moving) {
                root.dropped(root.x + self.mouse-x);
            }
        }
        moved => {
            if (root.adjustable && self.pressed && abs(self.mouse-x - self.pressed-x) > 10px) {
                root.moving = true;
            }
        }
        clicked => {
            if (!root.moving && root.key != "") {
                root.sort(root.key);
            }
            root.moving = false;
        }
    }
    Text {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.text;
        // Arabic: the sides of the columns are mirrored too
        horizontal-alignment: !Theme.rtl ? root.align : root.align == TextHorizontalAlignment.left ? TextHorizontalAlignment.right : root.align == TextHorizontalAlignment.right ? TextHorizontalAlignment.left : root.align;
        vertical-alignment: center;
        font-size: 12px * Theme.font-scale;
        color: Theme.text;
        overflow: elide;
    }
    if root.key != "" && root.key == root.sort-by: Glyph {
        x: (root.align == TextHorizontalAlignment.right) != Theme.rtl ? 2px : parent.width - 16px;
        y: (parent.height - 16px) / 2;
        kind: root.sort-desc ? "caret-down" : "caret-up";
        tint: Theme.muted;
    }
    Rectangle {
        x: Theme.rtl ? 0px : parent.width - 1px;
        y: 4px;
        width: 1px;
        height: parent.height - 8px;
        background: Theme.line;
    }
    // the edge to resize the column
    if root.adjustable: edge := TouchArea {
        x: Theme.rtl ? -3px : parent.width - 5px;
        width: 8px;
        height: parent.height;
        mouse-cursor: MouseCursor.col-resize;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.start-width = root.width;
                root.start-x = self.absolute-position.x + self.mouse-x;
            }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) {
                root.resize-done();
            }
        }
        moved => {
            if (self.pressed) {
                // measured on the screen: the edge itself moves with the column
                // Arabic: the edge is on the left, pulling it left widens the column
                root.resized(max(36px, root.start-width + (Theme.rtl ? -1 : 1) * (self.absolute-position.x + self.mouse-x - root.start-x)));
            }
        }
    }
}

export component Cell inherits Text {
    vertical-alignment: center;
    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    font-size: 12px * Theme.font-scale;
    color: Theme.text;
    overflow: elide;
}

// ---- right-click menu pieces
export component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <color> glyph-color: Theme.accent;
    in property <bool> enabled: true;
    in property <bool> bold;
    in property <bool> indent;
    callback clicked();
    height: 26px;
    border-radius: 3px;
    background: ta.has-hover && root.enabled ? Theme.select : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    HRow {
        padding-left: Theme.rtl ? (10px) : (root.indent ? 26px : 8px);
        padding-right: Theme.rtl ? (root.indent ? 26px : 8px) : (10px);
        spacing: 8px;
        opacity: root.enabled ? 1.0 : 0.4;
        Rectangle {
            width: 16px;
            if root.glyph != "": Glyph {
                y: (parent.height - 16px) / 2;
                kind: root.glyph;
                tint: root.glyph-color;
            }
        }
        Text {
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
            font-size: 12px * Theme.font-scale;
            font-weight: root.bold ? 700 : 400;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

export component MenuSep inherits Rectangle {
    height: 7px;
    Rectangle {
        x: 6px;
        y: 3px;
        width: parent.width - 12px;
        height: 1px;
        background: Theme.line;
    }
}

export component MenuLabel inherits Rectangle {
    in property <string> text;
    height: 22px;
    Text {
        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        x: Theme.rtl ? 0px : 34px;
        width: parent.width - 34px;
        text: root.text;
        font-size: 11px * Theme.font-scale;
        color: Theme.muted;
        vertical-alignment: center;
        height: parent.height;
    }
}

