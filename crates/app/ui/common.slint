// Ezoo Download – shared look: data types, themes, icons and small widgets.

import { Button, LineEdit, SpinBox, CheckBox, ComboBox, ListView, TabWidget, TextEdit, Palette } from "std-widgets.slint";

export struct DownloadRow {
    id: int,
    name: string,
    // file type icon: video, audio, archive, pdf, doc, sheet, slides, text, exe, apk, disc, image, general
    kind: string,
    category: string,
    queue: string,
    size: string,
    status: string,
    progress: float,
    eta: string,
    speed: string,
    last-try: string,
    description: string,
    added: string,
    // part of the multiple selection (Ctrl / Shift click, Ctrl+A)
    sel: bool,
    save-to: string,
    referer: string,
    parent: string,
    // 0 queued, 1 running, 2 paused, 3 complete, 4 error
    state: int,
}

// a column of the download list, in the order shown (drag to move / resize)
export struct ColDef {
    key: string,
    width: length,
}

// which list columns are visible (View > Columns)
export struct Cols {
    q: bool,
    size: bool,
    status: bool,
    eta: bool,
    speed: bool,
    last: bool,
    desc: bool,
    added: bool,
    saveto: bool,
    referer: bool,
    parent: bool,
}

// a category in the sidebar
export struct CatRow {
    name: string,
    // the name in the current language
    label: string,
    // icon kind
    kind: string,
    count: string,
    unfinished: string,
    finished: string,
    builtin: bool,
}

// one row of a simple two/three column list (logins, server exceptions...)
export struct PairRow {
    a: string,
    b: string,
    c: string,
}

// a file found by the site grabber / "download all links"
export struct LinkRow {
    checked: bool,
    name: string,
    kind: string,
    ext: string,
    text: string,
    url: string,
}

export struct QueueRow {
    id: int,
    name: string,
    count: int,
    running: bool,
}

// one connection of a download (progress window)
export struct SegView {
    // this connection is receiving right now
    busy: bool,
    start: float,
    done: float,
    number: string,
    downloaded: string,
    info: string,
}

// ------------------------------------------------------------------ themes
// Coherent platform surfaces with an optional app-only appearance override.

export global Theme {
    // Appearance choice: 0 System, 1 Light, 2 Dark. Mode is resolved 0/1.
    in-out property <int> appearance: 0;
    in-out property <int> mode: 0;
    in-out property <bool> native-macos: false;
    out property <bool> dark: mode == 1;
    in-out property <float> font-scale: 1.0;
    in-out property <string> font-family: "";
    in-out property <float> glass: 0;
    // Rust supplies resolved AppKit semantic colors on macOS. These opaque
    // fallbacks also keep every legacy theme index in one coherent family.
    in-out property <color> platform-window: dark ? #1c1c1e : #f5f5f7;
    in-out property <color> platform-panel: dark ? #2c2c2e : #ffffff;
    in-out property <color> platform-secondary-surface: dark ? #343436 : #f5f5f7;
    in-out property <color> platform-sidebar: dark ? #1c1c1e : #f5f5f7;
    in-out property <color> platform-text: dark ? #f5f5f7 : #1d1d1f;
    in-out property <color> platform-muted: dark ? #a1a1a6 : #5a5a60;
    in-out property <color> platform-accent: dark ? #0a84ff : #007aff;
    in-out property <color> platform-accent-text: dark ? #459fff : #0064d2;
    in-out property <color> platform-line: dark ? #48484a : #d2d2d7;
    in-out property <color> platform-selection: dark ? #233d59 : #e3eeff;
    in-out property <color> platform-hover: dark ? #39393b : #f2f2f4;
    in-out property <color> platform-ok: dark ? #30d158 : #248a3d;
    in-out property <color> platform-warn: dark ? #ff9f0a : #b25000;
    in-out property <color> platform-err: dark ? #ff453a : #d70015;
    in-out property <color> platform-input: dark ? #2c2c2e : #ffffff;
    in-out property <color> platform-bar: dark ? #48484a : #e5e5ea;
    out property <color> window: platform-window;
    out property <color> panel: platform-panel.transparentize(glass);
    out property <color> secondary-surface: platform-secondary-surface.transparentize(glass);
    out property <color> sidebar: platform-sidebar.transparentize(glass);
    out property <color> toolbar-top: platform-window.transparentize(glass);
    out property <color> toolbar-bottom: toolbar-top;
    out property <color> toolbar-text: platform-text;
    out property <color> toolbar-hover: platform-hover;
    out property <color> header-top: platform-secondary-surface.transparentize(glass);
    out property <color> header-bottom: header-top;
    out property <color> grid: platform-line.transparentize(0.65);
    out property <color> text: platform-text;
    out property <color> muted: platform-muted;
    out property <color> accent: platform-accent;
    out property <color> accent-text: platform-accent-text;
    out property <color> line: platform-line;
    out property <color> select: platform-selection;
    out property <color> select-line: platform-accent.transparentize(0.7);
    out property <color> hover: platform-hover;
    out property <color> ok: platform-ok;
    out property <color> warn: platform-warn;
    out property <color> err: platform-err;
    out property <color> bar-bg: platform-bar;
    out property <color> input-bg: platform-input;
}

// Applies the light/dark look to the standard widgets of every window.
export component ThemedWindow inherits Window {
    property <bool> dark: Theme.dark;
    changed dark => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        Palette.color-scheme = self.dark ? ColorScheme.dark : ColorScheme.light;
    }
    background: Theme.window;
    default-font-size: 13px * Theme.font-scale;
    default-font-family: Theme.font-family;
    icon: @image-url("icon-window.png");
}

// Restrained fields and actions for the download flow. Their surfaces use the
// app's resolved semantic palette rather than a second widget-set palette.
export component QuietField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <InputType> input-type: InputType.text;
    callback edited(string);
    callback accepted(string);
    height: 38px * Theme.font-scale;
    min-width: 60px;
    horizontal-stretch: 1;
    border-radius: 9px;
    background: Theme.secondary-surface;
    border-width: editor.has-focus ? 2px : 1px;
    border-color: editor.has-focus ? Theme.accent : Theme.line.transparentize(0.65);
    opacity: root.enabled ? 1 : 0.45;
    forward-focus: editor;
    accessible-role: text-input;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-value: root.input-type == InputType.password ? "" : root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-read-only: root.read-only;
    accessible-action-set-value(v) => { root.text = v; root.edited(v); }
    accessible-action-set-selection-offsets(anchor, focus) => { editor.set-selection-offsets(anchor, focus); }
    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 14px * Theme.font-scale;
        color: Theme.muted;
        text: root.text == "" && editor.preedit-text == "" ? root.placeholder-text : "";
        accessible-role: none;
    }
    ContextMenuArea {
        enabled: root.enabled;
        Menu {
            MenuItem { title: @tr("Undo"); enabled: !root.read-only; activated => { editor.undo(); } }
            MenuItem { title: @tr("Redo"); enabled: !root.read-only; activated => { editor.redo(); } }
            MenuSeparator { }
            MenuItem { title: @tr("Cut"); enabled: !root.read-only; activated => { editor.cut(); } }
            MenuItem { title: @tr("Copy"); activated => { editor.copy(); } }
            MenuItem { title: @tr("Paste"); enabled: !root.read-only; activated => { editor.paste(); } }
            MenuItem { title: @tr("Select All"); activated => { editor.select-all(); } }
        }
        editor := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            accessible-role: none;
            enabled: root.enabled;
            read-only: root.read-only;
            text <=> root.text;
            input-type: root.input-type;
            font-size: 14px * Theme.font-scale;
            color: Theme.text;
            selection-background-color: Theme.accent;
            selection-foreground-color: white;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
        }
    }
}

export component QuietButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px * Theme.font-scale;
    min-width: caption.preferred-width + 28px;
    border-radius: 9px;
    // A darker system blue keeps small white action text readable in both modes.
    background: root.primary ? (hit.pressed ? #0055b3 : #0066cc) : hit.pressed ? Theme.select : hit.has-hover ? Theme.hover : Theme.secondary-surface;
    opacity: root.enabled ? 1 : 0.38;
    border-width: keyboard.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: keyboard;
    caption := Text {
        text: root.text;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px * Theme.font-scale;
        font-weight: root.primary ? 600 : 500;
        color: root.primary ? white : Theme.text;
    }
    keyboard := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Return || event.text == " ")) { root.clicked(); return accept; }
            reject
        }
    }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { keyboard.focus(); root.clicked(); } }
}

// A button of a window's own title bar (windows drawn without the Windows
// frame): "tray" (hide next to the clock), "min" or "close".
export component CaptionButton inherits Rectangle {
    in property <string> kind;
    callback clicked();
    out property <bool> hovered: ca.has-hover;
    width: 44px;
    background: ca.pressed ? (root.kind == "close" ? Theme.err : Theme.line) : ca.has-hover ? (root.kind == "close" ? Theme.err : Theme.hover) : transparent;
    ca := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Path {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke-width: 1px;
        stroke: root.kind == "close" && ca.has-hover ? white : Theme.text;
        fill: transparent;
        commands: root.kind == "close" ? "M 0 0 L 10 10 M 10 0 L 0 10"
            : root.kind == "min" ? "M 0 5.5 L 10 5.5"
            // an arrow down into a tray
            : "M 5 0 L 5 6.5 M 2.2 3.8 L 5 6.5 L 7.8 3.8 M 0.5 6.5 L 0.5 9.5 L 9.5 9.5 L 9.5 6.5";
    }
}

// Small vector icons for menus, lists and buttons (fonts on Windows don't
// have every symbol, so nothing here depends on a font).
// One quiet, scalable symbol language for navigation and file types.
export component Glyph inherits Rectangle {
    in property <string> kind;
    in property <color> tint: Theme.text;
    width: 16px;
    height: 16px;
    property <bool> solid: root.kind == "play" || root.kind == "pause" || root.kind == "stop" || root.kind == "more";
    property <string> path: root.kind == "play" ? "M 5.1 2.9 Q 4.4 2.5 4.4 3.4 L 4.4 12.6 Q 4.4 13.5 5.1 13.1 L 12.5 8.7 Q 13.3 8 12.5 7.3 Z"
        : root.kind == "progress" ? "M 8 1.8 A 6.2 6.2 0 1 1 7.99 1.8 Z M 8 4.5 L 8 8 L 11 9.5"
        : root.kind == "openwith" ? "M 2 5 L 2 14 L 12 14 L 12 10 M 7 9 L 14 2 M 9 2 L 14 2 L 14 7"
        : root.kind == "folder" ? "M 2 5.5 L 2 4 Q 2 3 3 3 L 6 3 L 7.7 4.8 L 13 4.8 Q 14 4.8 14 5.8 L 14 12 Q 14 13 13 13 L 3 13 Q 2 13 2 12 Z M 2.3 6.2 L 13.7 6.2"
        : root.kind == "pause" ? "M 4.2 3 Q 3.5 3 3.5 3.7 L 3.5 12.3 Q 3.5 13 4.2 13 L 5.8 13 Q 6.5 13 6.5 12.3 L 6.5 3.7 Q 6.5 3 5.8 3 Z M 10.2 3 Q 9.5 3 9.5 3.7 L 9.5 12.3 Q 9.5 13 10.2 13 L 11.8 13 Q 12.5 13 12.5 12.3 L 12.5 3.7 Q 12.5 3 11.8 3 Z"
        : root.kind == "stop" ? "M 4 3 Q 3 3 3 4 L 3 12 Q 3 13 4 13 L 12 13 Q 13 13 13 12 L 13 4 Q 13 3 12 3 Z"
        : root.kind == "redo" ? "M 13.5 8 A 5.5 5.5 0 1 1 11 3.5 M 9.5 1.5 L 12 4 L 8.5 5"
        : root.kind == "refresh" ? "M 2.5 7 A 5.5 5.5 0 0 1 12.8 5 M 13.5 9 A 5.5 5.5 0 0 1 3.2 11 M 13 2 L 13 5.2 L 9.8 5.2 M 3 14 L 3 10.8 L 6.2 10.8"
        : root.kind == "edit" ? "M 2.5 13.5 L 3.2 10.5 L 11 2.7 L 13.3 5 L 5.5 12.8 Z M 9.4 4.2 L 11.8 6.6"
        : root.kind == "check" ? "M 2.5 8.5 L 6.3 12 L 13.5 4"
        : root.kind == "copy" ? "M 6.5 5.5 L 12.5 5.5 Q 13.5 5.5 13.5 6.5 L 13.5 12.5 Q 13.5 13.5 12.5 13.5 L 6.5 13.5 Q 5.5 13.5 5.5 12.5 L 5.5 6.5 Q 5.5 5.5 6.5 5.5 Z M 2.5 10 L 2.5 3.5 Q 2.5 2.5 3.5 2.5 L 10 2.5"
        : root.kind == "hash" ? "M 6 2 L 4.5 14 M 11.5 2 L 10 14 M 2.5 5.5 L 14 5.5 M 2 10.5 L 13.5 10.5"
        : root.kind == "info" ? "M 8 1.8 A 6.2 6.2 0 1 1 7.99 1.8 Z M 8 7 L 8 12 M 8 4 L 8 4.8"
        : root.kind == "close" ? "M 4 4 L 12 12 M 12 4 L 4 12"
        : root.kind == "trash" || root.kind == "delete" ? "M 2.8 4 L 13.2 4 M 6 4 L 6 2.5 L 10 2.5 L 10 4 M 4 4 L 4.5 12.5 Q 4.6 13.5 5.5 13.5 L 10.5 13.5 Q 11.4 13.5 11.5 12.5 L 12 4 M 6.5 6.8 L 6.5 10.8 M 9.5 6.8 L 9.5 10.8"
        : root.kind == "clock" ? "M 8 1.8 A 6.2 6.2 0 1 1 7.99 1.8 Z M 8 4 L 8 8 L 11 9.5"
        : root.kind == "plus" ? "M 8 2.5 L 8 13.5 M 2.5 8 L 13.5 8"
        : root.kind == "minus" ? "M 2.5 8 L 13.5 8"
        : root.kind == "warn" ? "M 8 2 L 14.5 13.5 L 1.5 13.5 Z M 8 6 L 8 9.5 M 8 11 L 8 11.7"
        : root.kind == "down" ? "M 8 2.2 L 8 10.1 M 4.8 7 L 8 10.2 L 11.2 7 M 2.5 10.5 L 2.5 12.5 Q 2.5 13.5 3.5 13.5 L 12.5 13.5 Q 13.5 13.5 13.5 12.5 L 13.5 10.5"
        : root.kind == "up" ? "M 8 14 L 8 4 M 4.5 7.5 L 8 4 L 11.5 7.5"
        : root.kind == "caret-down" ? "M 4 6 L 8 10 L 12 6"
        : root.kind == "caret-up" ? "M 4 10 L 8 6 L 12 10"
        : root.kind == "caret-right" ? "M 6 4 L 10 8 L 6 12"
        : root.kind == "bulb" ? "M 5.5 12 L 5 10 A 4.7 4.7 0 1 1 11 10 L 10.5 12 Z M 6 14 L 10 14"
        : root.kind == "queue" ? "M 2.5 3.5 L 13.5 3.5 M 2.5 7.5 L 13.5 7.5 M 2.5 11.5 L 7 11.5 M 10.5 10 L 13.5 12 L 10.5 14 Z"
        : root.kind == "search" ? "M 7 2 A 5 5 0 1 1 6.99 2 Z M 10.6 10.6 L 14.5 14.5"
        : root.kind == "more" ? "M 3.5 6.8 A 1.2 1.2 0 1 1 3.49 6.8 Z M 8 6.8 A 1.2 1.2 0 1 1 7.99 6.8 Z M 12.5 6.8 A 1.2 1.2 0 1 1 12.49 6.8 Z"
        : root.kind == "settings" ? "M 2.5 4 L 4 4 M 7 4 L 13.5 4 M 5.5 2.5 L 5.5 5.5 M 2.5 8 L 9 8 M 12 8 L 13.5 8 M 10.5 6.5 L 10.5 9.5 M 2.5 12 L 4 12 M 7 12 L 13.5 12 M 5.5 10.5 L 5.5 13.5"
        : root.kind == "sidebar" ? "M 3 2.5 L 13 2.5 Q 14 2.5 14 3.5 L 14 12.5 Q 14 13.5 13 13.5 L 3 13.5 Q 2 13.5 2 12.5 L 2 3.5 Q 2 2.5 3 2.5 Z M 6 2.5 L 6 13.5"
        : root.kind == "archive" ? "M 2 3 L 14 3 L 14 6 L 2 6 Z M 3 6 L 3 14 L 13 14 L 13 6 M 6 9 L 10 9"
        : root.kind == "video" ? "M 3 3 L 13 3 Q 14 3 14 4 L 14 12 Q 14 13 13 13 L 3 13 Q 2 13 2 12 L 2 4 Q 2 3 3 3 Z M 6.5 5.5 L 10 8 L 6.5 10.5 Z"
        : root.kind == "music" ? "M 6 11 L 6 3.5 L 13 2 L 13 9.5 M 6 3.5 L 13 2 M 6 11 A 2 1.5 0 1 1 5.99 11 Z M 13 9.5 A 2 1.5 0 1 1 12.99 9.5 Z"
        : root.kind == "image" ? "M 3 2.5 L 13 2.5 Q 14 2.5 14 3.5 L 14 12.5 Q 14 13.5 13 13.5 L 3 13.5 Q 2 13.5 2 12.5 L 2 3.5 Q 2 2.5 3 2.5 Z M 2.5 11.5 L 6 7.5 L 9 10.7 L 11.2 8.5 L 13.5 11 M 10.5 5.3 L 10.5 5.3"
        : root.kind == "torrent" ? "M 3 2 L 3 8 A 5 5 0 0 0 13 8 L 13 2 M 6 2 L 6 8 A 2 2 0 0 0 10 8 L 10 2 M 3 5 L 6 5 M 10 5 L 13 5"
        : root.kind == "globe" ? "M 8 1.5 A 6.5 6.5 0 1 1 7.99 1.5 Z M 1.5 8 L 14.5 8 M 8 1.5 C 4 5 4 11 8 14.5 M 8 1.5 C 12 5 12 11 8 14.5"
        : root.kind == "program" ? "M 2 3 L 14 3 L 14 13 L 2 13 Z M 2 6 L 14 6 M 5 8 L 7 10 L 5 12 M 9 11 L 12 11"
        : root.kind == "disc" ? "M 8 1.5 A 6.5 6.5 0 1 1 7.99 1.5 Z M 8 6 A 2 2 0 1 1 7.99 6 Z"
        : root.kind == "table" ? "M 3 2.5 L 13 2.5 Q 14 2.5 14 3.5 L 14 12.5 Q 14 13.5 13 13.5 L 3 13.5 Q 2 13.5 2 12.5 L 2 3.5 Q 2 2.5 3 2.5 Z M 2 6 L 14 6 M 7 6 L 7 13.5 M 2 9.8 L 14 9.8"
        : root.kind == "presentation" ? "M 2 2.5 L 14 2.5 M 3 2.5 L 3 10.5 L 13 10.5 L 13 2.5 M 8 10.5 L 8 13.5 M 5 14 L 8 12.5 L 11 14"
        : "M 4.5 2 L 9.5 2 L 12.5 5 L 12.5 13 Q 12.5 14 11.5 14 L 4.5 14 Q 3.5 14 3.5 13 L 3.5 3 Q 3.5 2 4.5 2 Z M 9.5 2 L 9.5 5 L 12.5 5 M 6 8 L 10 8 M 6 11 L 10 11";
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke-width: root.solid ? 0px : 1.6px;
        stroke-line-cap: round;
        stroke-line-join: round;
        stroke: root.tint;
        fill: root.solid ? root.tint : transparent;
        commands: root.path;
    }
}

export component P inherits Path { viewbox-width: 32; viewbox-height: 32; }
export component G inherits Path { viewbox-width: 16; viewbox-height: 16; }

export component Icon inherits Rectangle {
    in property <string> kind;
    width: 24px;
    height: 24px;
    Glyph {
        width: parent.width;
        height: parent.height;
        tint: Theme.text;
        kind: root.kind == "add" ? "plus" : root.kind == "batch" ? "copy"
            : root.kind == "playlist" || root.kind == "startqueue" ? "queue"
            : root.kind == "grabber" ? "globe" : root.kind == "find" ? "search"
            : root.kind == "resume" ? "play" : root.kind == "stop" ? "pause"
            : root.kind == "stopall" || root.kind == "stopqueue" ? "stop"
            : root.kind == "delete" || root.kind == "deletedone" ? "close"
            : root.kind == "options" ? "settings" : root.kind == "scheduler" ? "clock"
            : root.kind == "limiter" ? "settings" : root.kind;
    }
}

export component TypeIcon inherits Rectangle {
    in property <string> kind: "general";
    width: 18px;
    height: 18px;
    Glyph {
        width: parent.width;
        height: parent.height;
        tint: Theme.accent-text;
        kind: root.kind == "audio" ? "music" : root.kind == "exe" || root.kind == "apk" ? "program"
            : root.kind == "sheet" ? "table" : root.kind == "slides" ? "presentation"
            : root.kind == "pdf" || root.kind == "doc" || root.kind == "text" || root.kind == "general" ? "document"
            : root.kind;
    }
}

// The original download ribbon from packaging/ezoo-icon.svg, drawn as vectors
// so the sidebar shares the application icon's identity at every scale.
export component BrandMark inherits Rectangle {
    width: 28px;
    height: 28px;
    Rectangle {
        x: parent.width * 0.0625;
        y: parent.height * 0.0625;
        width: parent.width * 0.875;
        height: parent.height * 0.875;
        border-radius: root.width * 0.1953125;
        background: #007aff;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 1024;
        viewbox-height: 1024;
        fill: white;
        commands: "M376 260H584C606 260 624 278 624 300V482H694C717 482 728 509 712 525L540 697C524 713 500 713 484 697L312 525C296 509 307 482 330 482H424V372H376C345 372 320 347 320 316S345 260 376 260Z M338 752H686C707 752 724 769 724 790S707 828 686 828H338C317 828 300 811 300 790S317 752 338 752Z";
    }
}

// Big icon with the file extension under it (dialogs).
export component BigTypeIcon inherits VerticalLayout {
    in property <string> kind;
    in property <string> ext;
    spacing: 4px;
    alignment: start;
    HorizontalLayout {
        alignment: center;
        TypeIcon {
            kind: root.kind;
            width: 48px;
            height: 48px;
        }
    }
    Text {
        text: root.ext;
        horizontal-alignment: center;
        font-size: 11px * Theme.font-scale;
        font-weight: 700;
        color: Theme.muted;
    }
}

// ------------------------------------------------------------------ main window parts

// The note under a toolbar button the mouse rests on (one per window).
export global ToolTip {
    in-out property <string> title;
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    // the mouse is on a button (the note shows after a moment)
    in-out property <bool> pending;
    in-out property <bool> shown;
}

export component ToolBtn inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> enabled: true;
    // View > Toolbar > Small buttons: icon only
    in property <bool> small;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: keyboard;
    // small buttons: every one fits a 960 px wide window
    width: root.small ? 36px : 68px;
    height: root.small ? 32px : 48px;
    // a name that is still too long never covers the next button
    clip: true;
    border-radius: 6px;
    border-width: (ta.has-hover || keyboard.has-focus) && root.enabled ? 1px : 0px;
    border-color: keyboard.has-focus ? Theme.accent : Theme.select-line;
    background: !root.enabled ? transparent : ta.pressed ? Theme.select : ta.has-hover ? Theme.toolbar-hover : transparent;
    // what the button does, shown when the mouse rests on it
    pure function describe(k: string) -> string {
        if (k == "add") { return @tr("Download a file from an address you type or paste (Ctrl+N)."); }
        if (k == "batch") { return @tr("Download many links at once, or numbered files from one address (Ctrl+B)."); }
        if (k == "resume") { return @tr("Continue the selected downloads from where they stopped."); }
        if (k == "stop") { return @tr("Pause the selected downloads; they can be resumed later."); }
        if (k == "stopall") { return @tr("Pause every running download."); }
        if (k == "delete") { return @tr("Remove the selected downloads from the list. The files stay on your computer."); }
        if (k == "deletedone") { return @tr("Remove all finished downloads from the list. The files stay on your computer."); }
        if (k == "options") { return @tr("All the settings of the program."); }
        if (k == "scheduler") { return @tr("Start or stop queues at the times you choose."); }
        if (k == "limiter") { return @tr("Limit the download speed so the internet stays usable for other things."); }
        if (k == "startqueue") { return @tr("Start the files of a queue, one after another."); }
        if (k == "stopqueue") { return @tr("Stop the files of a queue."); }
        if (k == "grabber") { return @tr("Collect the files of a web site: pictures, videos, archives…"); }
        if (k == "playlist") { return @tr("Download all or some videos of a playlist."); }
        if (k == "torrent") { return @tr("Download a .torrent file or a magnet link."); }
        return "";
    }
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: true;
        clicked => {
            if (root.enabled) {
                keyboard.focus();
                root.clicked();
            }
        }
        changed has-hover => {
            if (self.has-hover) {
                ToolTip.title = root.text;
                ToolTip.text = root.describe(root.icon);
                ToolTip.x = root.absolute-position.x;
                ToolTip.y = root.absolute-position.y + root.height + 4px;
                ToolTip.shown = false;
                ToolTip.pending = true;
            } else if (ToolTip.title == root.text) {
                ToolTip.pending = false;
                ToolTip.shown = false;
            }
        }
        pointer-event(ev) => {
            // a click hides the note
            if (ev.kind == PointerEventKind.down) {
                ToolTip.pending = false;
                ToolTip.shown = false;
            }
        }
    }
    keyboard := FocusScope {
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Return || event.text == " ")) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    if !root.small: VerticalLayout {
        alignment: center;
        spacing: 3px;
        padding-left: 1px;
        padding-right: 1px;
        opacity: root.enabled ? 1.0 : 0.35;
        HorizontalLayout {
            alignment: center;
            Icon {
                width: 18px;
                height: 18px;
                kind: root.icon;
            }
        }
        // a long name goes on two lines ("Delete / Done"); "…" does not work
        // for right-to-left (Arabic) text, which would spill over the next button
        Text {
            text: root.text;
            font-size: 11px * Theme.font-scale;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: top;
            wrap: word-wrap;
            max-height: 26px * Theme.font-scale;
            color: Theme.toolbar-text;
        }
    }
    if root.small: Icon {
        x: (parent.width - 18px) / 2;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        kind: root.icon;
        opacity: root.enabled ? 1.0 : 0.35;
    }
}

export component ToolSeparator inherits Rectangle {
    width: 7px;
    Rectangle {
        x: 3px;
        y: 8px;
        width: 1px;
        height: parent.height - 16px;
        background: Theme.line;
    }
}

export component TreeItem inherits Rectangle {
    in property <string> text;
    // "folder", "queue", "unfinished", "finished" or a file kind
    in property <string> icon;
    in property <string> count;
    in property <int> indent;
    in property <bool> selected;
    in property <bool> bold;
    // a branch that opens / closes (+ / - in front)
    in property <bool> expandable;
    in property <bool> expanded;
    callback clicked();
    callback toggle();
    // right click, at this position inside the item
    callback context(length, length);
    height: 32px;
    background: root.selected ? Theme.select : ta.has-hover ? Theme.hover : transparent;
    border-radius: 6px;
    border-width: 0px;
    border-color: Theme.select-line;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.toggle();
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.clicked();
                root.context(self.mouse-x, self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 4px + root.indent * 16px;
        padding-right: 6px;
        spacing: 5px;
        Rectangle {
            width: 16px;
            if root.expandable: Glyph {
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                kind: root.expanded ? "caret-down" : "caret-right";
                tint: Theme.muted;
            }
            if root.expandable: TouchArea {
                x: -4px;
                width: 24px;
                height: parent.height;
                clicked => { root.toggle(); }
            }
        }
        Rectangle {
            width: 16px;
            if root.icon == "folder": Icon {
                kind: "folder";
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
            }
            if root.icon == "queue": Icon {
                kind: "startqueue";
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
            }
            if root.icon == "unfinished": Glyph {
                kind: "down";
                y: (parent.height - 16px) / 2;
            }
            if root.icon == "finished": Glyph {
                kind: "check";
                tint: Theme.ok;
                y: (parent.height - 16px) / 2;
            }
            if root.icon != "folder" && root.icon != "queue" && root.icon != "unfinished" && root.icon != "finished": TypeIcon {
                kind: root.icon;
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            color: Theme.text;
            font-size: 13px * Theme.font-scale;
            font-weight: root.bold ? 600 : 400;
        }
        Text {
            text: root.count;
            vertical-alignment: center;
            color: Theme.muted;
            font-size: 12px * Theme.font-scale;
        }
    }
}

export component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <TextHorizontalAlignment> align: left;
    // sorting: this column's key, the current key and direction
    in property <string> key;
    in property <string> sort-by;
    in property <bool> sort-desc;
    // drag the right edge to resize, drag the title to move it
    in property <bool> adjustable;
    callback sort(string);
    // the new width while the edge is dragged; done when it is let go
    callback resized(length);
    callback resize-done();
    // the title was dragged and let go at `x` (in the header)
    callback dropped(length);
    // a long (Arabic) title is cut at its own column, never over the next one
    clip: true;
    property <bool> moving;
    property <length> start-width;
    property <length> start-x;
    height: 32px;
    background: root.moving ? Theme.select : ta.has-hover && (root.key != "" || root.adjustable) ? Theme.hover : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.key != "" || root.adjustable;
        mouse-cursor: root.moving ? MouseCursor.grabbing : MouseCursor.default;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.moving = false;
            }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up && root.moving) {
                root.dropped(root.x + self.mouse-x);
            }
        }
        moved => {
            if (root.adjustable && self.pressed && abs(self.mouse-x - self.pressed-x) > 10px) {
                root.moving = true;
            }
        }
        clicked => {
            if (!root.moving && root.key != "") {
                root.sort(root.key);
            }
            root.moving = false;
        }
    }
    Text {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.text;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        font-size: 13px * Theme.font-scale;
        color: Theme.text;
        overflow: elide;
    }
    if root.key != "" && root.key == root.sort-by: Glyph {
        x: root.align == TextHorizontalAlignment.right ? 2px : parent.width - 16px;
        y: (parent.height - 16px) / 2;
        kind: root.sort-desc ? "caret-down" : "caret-up";
        tint: Theme.muted;
    }
    Rectangle {
        x: parent.width - 1px;
        y: 4px;
        width: 1px;
        height: parent.height - 8px;
        background: Theme.line;
    }
    // the edge to resize the column
    if root.adjustable: edge := TouchArea {
        x: parent.width - 5px;
        width: 8px;
        height: parent.height;
        mouse-cursor: MouseCursor.col-resize;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.start-width = root.width;
                root.start-x = self.absolute-position.x + self.mouse-x;
            }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) {
                root.resize-done();
            }
        }
        moved => {
            if (self.pressed) {
                // measured on the screen: the edge itself moves with the column
                root.resized(max(36px, root.start-width + self.absolute-position.x + self.mouse-x - root.start-x));
            }
        }
    }
}

export component Cell inherits Text {
    vertical-alignment: center;
    font-size: 13px * Theme.font-scale;
    color: Theme.text;
    overflow: elide;
}

// ---- right-click menu pieces
export component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <color> glyph-color: Theme.muted;
    in property <bool> enabled: true;
    in property <bool> bold;
    in property <bool> indent;
    callback clicked();
    height: 32px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: keyboard;
    border-width: keyboard.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    keyboard := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Return || event.text == " ")) { root.clicked(); return accept; }
            reject
        }
    }

    border-radius: 6px;
    background: ta.has-hover && root.enabled ? Theme.select : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => {
            keyboard.focus();
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: root.indent ? 26px : 8px;
        padding-right: 10px;
        spacing: 8px;
        opacity: root.enabled ? 1.0 : 0.4;
        Rectangle {
            width: 16px;
            if root.glyph != "": Glyph {
                y: (parent.height - 16px) / 2;
                kind: root.glyph;
                tint: root.glyph-color;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
            font-size: 13px * Theme.font-scale;
            font-weight: root.bold ? 700 : 400;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

export component MenuSep inherits Rectangle {
    height: 7px;
    Rectangle {
        x: 6px;
        y: 3px;
        width: parent.width - 12px;
        height: 1px;
        background: Theme.line;
    }
}

export component MenuLabel inherits Rectangle {
    in property <string> text;
    height: 22px;
    Text {
        x: 34px;
        text: root.text;
        font-size: 11px * Theme.font-scale;
        color: Theme.muted;
        vertical-alignment: center;
        height: parent.height;
    }
}

