        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Add Ezoo Download to my browser…");
                activated => {
                    root.browsers();
                }
            }
            MenuItem {
                title: @tr("Tip of the day…");
                activated => {
                    root.tips();
                }
            }
            MenuItem {
                title: @tr("Check for updates");
                activated => {
                    root.check-app-update();
                }
            }
            MenuItem {
                title: @tr("Check for updates (video downloader)");
                activated => {
                    root.update-tools();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("About Ezoo Download");
                activated => {
