// Ezoo Download – user interface (Slint)
// Native desktop download library with an adaptive appearance, sidebar,
// compact toolbar, and optional detailed table.

import { Button, LineEdit, SpinBox, CheckBox, ComboBox, ListView, TabWidget, TextEdit, Palette, ScrollView } from "std-widgets.slint";
import { ToolTip, DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme, ThemedWindow, CaptionButton, P, Icon, G, TypeIcon, BigTypeIcon, ToolBtn, ToolSeparator, TreeItem, HeaderCell, Cell, MenuEntry, MenuSep, MenuLabel, Glyph, BrandMark, QuietField, QuietButton } from "common.slint";
export { DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme }
export { BrowserRow } from "dialogs.slint";
export { ColumnsDialog, CategoryDialog, FindDialog, PropertiesDialog, DuplicateDialog, CountdownDialog, SchedulerDialog, GrabberDialog, TipDialog, RefreshDialog, SettingsDialog, PlaylistDialog, TorrentDialog, BrowserDialog, AboutDialog, UpdateDialog, WhatsNewDialog } from "dialogs.slint";

// Compact, keyboard-accessible toolbar actions with the same symbols in both appearances.
component ToolbarAction inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 7px;
    background: !root.enabled ? transparent : hit.pressed ? Theme.select : hit.has-hover ? Theme.hover : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    opacity: root.enabled ? 1 : 0.35;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    focus := FocusScope {
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Return || event.text == " ")) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        kind: root.glyph;
        tint: Theme.text;
    }
    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
        changed has-hover => {
            if (self.has-hover) {
                ToolTip.title = root.label;
                ToolTip.text = root.label;
                ToolTip.x = root.absolute-position.x;
                ToolTip.y = root.absolute-position.y + root.height + 6px;
                ToolTip.pending = true;
                ToolTip.shown = false;
            } else { ToolTip.pending = false; ToolTip.shown = false; }
        }
    }
}

component DownloadItem inherits Rectangle {
    in property <DownloadRow> data;
    in property <bool> selected;
    in property <[QueueRow]> queues;
    in property <Cols> cols;
    in property <[ColDef]> columns;
    // how many downloads are selected (the menu then works on all of them)
    in property <int> sel-count;
    // click with Ctrl / Shift
    callback pick(bool, bool);
    // right click: keep a multiple selection that includes this row
    callback right-pick();
    // dragging with the mouse held down: rows below (+) or above (-) this one
    callback drag(int);
    property <int> drag-last;
    callback activated();
    callback action(string);
    callback move-to-queue(int);
    // dragging a finished file out of the program (onto the desktop, a folder…)
    callback drag-out();
    property <bool> dragged-out;
    in property <bool> detailed;
    // Keep the compact cards visually separated while retaining a full-height
    // hit target and a consistent row pitch for drag selection.
    height: root.detailed ? 32px * Theme.font-scale : 86px * Theme.font-scale;
    background: transparent;
    Rectangle {
        y: root.detailed ? 0px : 3px * Theme.font-scale;
        width: parent.width;
        height: root.detailed ? parent.height : parent.height - 6px * Theme.font-scale;
        border-radius: root.detailed ? 0px : 9px;
        background: root.selected ? Theme.select : ta.has-hover ? Theme.hover : transparent;
    }
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        double-clicked => {
            root.activated();
        }
        moved => {
            // a finished file pulled sideways: hand it to Windows to drop elsewhere
            if (self.pressed && root.done && !root.dragged-out && abs(self.mouse-x - self.pressed-x) > 12px) {
                root.dragged-out = true;
                root.drag-out();
                return;
            }
            if (self.pressed && floor(self.mouse-y / root.height) != root.drag-last) {
                root.drag-last = floor(self.mouse-y / root.height);
                root.drag(root.drag-last);
            }
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.drag-last = 0;
                root.dragged-out = false;
                root.pick(ev.modifiers.control, ev.modifiers.shift);
            }
            // right click: select the row and open the menu where the mouse is
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.right-pick();
                root.menu-x = self.mouse-x;
                root.menu-y = self.mouse-y;
                menu.show();
            }
        }
    }
    property <length> menu-x;
    property <length> menu-y;
    property <bool> done: root.data.state == 3;
    property <bool> can-resume: root.data.state == 2 || root.data.state == 4;
    property <bool> can-stop: root.data.state == 0 || root.data.state == 1;
    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 260px;
        height: menu-list.preferred-height;
        Rectangle {
            width: parent.width;
            height: menu-list.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 3px;
            menu-list := VerticalLayout {
                padding: 4px;
                spacing: 0px;
                if root.sel-count > 1: MenuLabel {
                    text: @tr("{} downloads selected", root.sel-count);
                }
                MenuEntry {
                    text: root.done ? @tr("Open") : @tr("Show download progress");
                    glyph: root.done ? "play" : "progress";
                    bold: true;
                    clicked => {
                        root.activated();
                    }
                }
                MenuEntry {
                    text: @tr("Open with…");
                    glyph: "openwith";
                    enabled: root.done;
                    clicked => {
                        root.action("openwith");
                    }
                }
                if !root.done && (root.data.kind == "video" || root.data.kind == "audio"): MenuEntry {
                    text: @tr("Play while downloading");
                    glyph: "play";
                    glyph-color: #d6631d;
                    clicked => {
                        root.action("preview");
                    }
                }
                MenuEntry {
                    text: @tr("Open folder");
                    glyph: "folder";
                    clicked => {
                        root.action("folder");
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Resume download");
                    glyph: "play";
                    glyph-color: #2e9e4f;
                    enabled: root.can-resume || root.sel-count > 1;
                    clicked => {
                        root.action("resume");
                    }
                }
                MenuEntry {
                    text: @tr("Stop download");
                    glyph: "pause";
                    glyph-color: #e08a00;
                    enabled: root.can-stop || root.sel-count > 1;
                    clicked => {
                        root.action("stop");
                    }
                }
                MenuEntry {
                    text: @tr("Redownload");
                    glyph: "redo";
                    clicked => {
                        root.action("restart");
                    }
                }
                MenuEntry {
                    text: @tr("Refresh download address…");
                    glyph: "refresh";
                    enabled: !root.done;
                    clicked => {
                        root.action("refresh");
                    }
                }
                MenuEntry {
                    text: @tr("Move / Rename…");
                    glyph: "edit";
                    clicked => {
                        root.action("move");
                    }
                }
                MenuSep { }
                MenuLabel {
                    text: @tr("Move to queue");
                }
                for q in root.queues: MenuEntry {
                    text: q.name;
                    glyph: root.data.queue == q.id ? "check" : "";
                    indent: true;
                    clicked => {
                        root.move-to-queue(q.id);
                    }
                }
                MenuEntry {
                    text: @tr("Delete from queue");
                    indent: true;
                    enabled: root.data.queue != "";
                    clicked => {
                        root.move-to-queue(-1);
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Copy address");
                    glyph: "copy";
                    clicked => {
                        root.action("copy");
                    }
                }
                MenuEntry {
                    text: @tr("Check file (SHA-256)");
                    glyph: "hash";
                    enabled: root.done;
                    clicked => {
                        root.action("sha256");
                    }
                }
                MenuEntry {
                    text: @tr("Properties");
                    glyph: "info";
                    clicked => {
                        root.action("properties");
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Remove");
                    glyph: "close";
                    glyph-color: #e0443b;
                    clicked => {
                        root.action("delete");
                    }
                }
            }
        }
    }
    if root.detailed: HorizontalLayout {
        padding-left: 6px;
        spacing: 0px;
        Rectangle {
            width: 32px;
            TypeIcon {
                kind: root.data.kind;
                x: 4px;
                y: (parent.height - 18px) / 2;
            }
        }
        // the columns in the order and widths of the header
        for c in root.columns: Rectangle {
            width: c.width;
            // clip: long right-to-left (Arabic) names must never spill over
            clip: true;
            if c.key == "name": Cell {
                x: 0px;
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.name;
                horizontal-alignment: left;
            }
            if c.key == "q": Cell {
                width: parent.width;
                height: parent.height;
                text: root.data.queue;
                horizontal-alignment: center;
                color: Theme.accent;
            }
            if c.key == "size": Cell {
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.size;
                horizontal-alignment: right;
            }
            if c.key == "status": Rectangle {
                // thin progress line under the status, for running downloads
                if root.data.state == 1 || (root.data.state == 2 && root.data.progress > 0): Rectangle {
                    x: 10px;
                    y: parent.height - 5px;
                    width: parent.width - 20px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.bar-bg;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.data.progress;
                        height: parent.height;
                        border-radius: 1.5px;
                        background: root.data.state == 1 ? Theme.accent : Theme.warn;
                        animate width {
                            duration: 250ms;
                            easing: linear;
                        }
                    }
                }
                Cell {
                    width: parent.width;
                    height: parent.height - 2px;
                    text: root.data.status;
                    horizontal-alignment: center;
                    color: root.data.state == 3 ? Theme.ok : root.data.state == 4 ? Theme.err : root.data.state == 1 ? Theme.accent : Theme.text;
                }
            }
            if c.key == "eta": Cell {
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.eta;
                horizontal-alignment: right;
            }
            if c.key == "speed": Cell {
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.speed;
                horizontal-alignment: right;
            }
            if c.key == "last": Cell {
                width: parent.width;
                height: parent.height;
                text: root.data.last-try;
                horizontal-alignment: center;
                color: Theme.muted;
            }
            if c.key == "desc": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.description;
                color: Theme.muted;
            }
            if c.key == "added": Cell {
                width: parent.width;
                height: parent.height;
                text: root.data.added;
                horizontal-alignment: center;
                color: Theme.muted;
            }
            if c.key == "saveto": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.save-to;
                color: Theme.muted;
            }
            if c.key == "referer": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.referer;
                color: Theme.muted;
            }
            if c.key == "parent": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.parent;
                color: Theme.muted;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
    if !root.detailed: HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 14px;
        Rectangle {
            width: 40px;
            height: 44px;
            background: Theme.secondary-surface;
            border-radius: 10px;
            TypeIcon { kind: root.data.kind; width: 26px; height: 28px; x: 7px; y: 8px; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            Text {
                text: root.data.name;
                color: Theme.text;
                font-size: 14px * Theme.font-scale;
                font-weight: 600;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.data.size; color: Theme.muted; font-size: 13px * Theme.font-scale; }
                Text { text: "·"; color: Theme.muted; }
                Text {
                    text: root.data.state == 2 ? (root.data.status != "" ? @tr("Paused") + " · " + root.data.status : @tr("Paused")) : root.data.status;
                    color: root.data.state == 3 ? Theme.ok : root.data.state == 4 ? Theme.err : root.data.state == 2 ? Theme.warn : root.data.state == 1 ? Theme.accent-text : Theme.muted;
                    font-size: 13px * Theme.font-scale;
                }
                if root.data.state == 1 && root.data.speed != "": Text { text: "·  " + root.data.speed; color: Theme.muted; font-size: 13px * Theme.font-scale; }
                if root.data.state == 1 && root.data.eta != "": Text { text: "·  " + root.data.eta; color: Theme.muted; font-size: 13px * Theme.font-scale; }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.data.state != 3 && root.data.progress > 0: Rectangle {
                height: 3px;
                border-radius: 1.5px;
                background: Theme.bar-bg;
                Rectangle { x: 0px; y: 0px; width: parent.width * min(1, max(0, root.data.progress)); height: parent.height; border-radius: 1.5px; background: root.data.state == 2 ? Theme.warn : Theme.accent; }
            }
        }
        VerticalLayout {
            alignment: center;
            ToolbarAction {
                glyph: root.data.state == 3 ? "folder" : root.data.state == 1 ? "pause" : "play";
                label: root.data.state == 3 ? (Theme.native-macos ? @tr("Show in Finder") : @tr("Show in folder")) : root.data.state == 1 ? @tr("Pause") : @tr("Resume");
                clicked => { root.action(root.data.state == 3 ? "folder" : root.data.state == 1 ? "stop" : "resume"); }
            }
        }
    }
}

// right click menu of the sidebar (categories and queues)
component TreeMenu inherits PopupWindow {
    in property <string> target;
    in property <bool> is-queue;
    in property <bool> builtin;
    callback chosen(string);
    width: 210px;
    height: tm-list.preferred-height;
    Rectangle {
        width: parent.width;
        height: tm-list.preferred-height;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 4px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000055;
        drop-shadow-offset-y: 3px;
        tm-list := VerticalLayout {
            padding: 4px;
            if root.is-queue: MenuEntry {
                text: @tr("Start queue");
                glyph: "play";
                glyph-color: #2e9e4f;
                clicked => {
                    root.chosen("start");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("Stop queue");
                glyph: "stop";
                glyph-color: #e0443b;
                clicked => {
                    root.chosen("stop");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("Edit queue / schedule…");
                glyph: "clock";
                clicked => {
                    root.chosen("edit");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("New queue…");
                glyph: "plus";
                clicked => {
                    root.chosen("new");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("Delete queue");
                glyph: "close";
                glyph-color: #e0443b;
                enabled: !root.builtin;
                clicked => {
                    root.chosen("delete");
                }
            }
            if !root.is-queue: MenuEntry {
                text: @tr("Add category…");
                glyph: "plus";
                clicked => {
                    root.chosen("add");
                }
            }
            if !root.is-queue && root.target != "": MenuEntry {
                text: @tr("Delete category");
                glyph: "close";
                glyph-color: #e0443b;
                enabled: !root.builtin;
                clicked => {
                    root.chosen("delete");
                }
            }
            if !root.is-queue && root.target != "": MenuEntry {
                text: @tr("Properties…");
                glyph: "info";
                clicked => {
                    root.chosen("props");
                }
            }
        }
    }
}

// a sidebar item with its own right click menu
component CtxTreeItem inherits TreeItem {
    in property <bool> is-queue;
    in property <bool> builtin;
    in property <string> target;
    callback chosen(string);
    property <length> mx;
    property <length> my;
    context(x, y) => {
        self.mx = x;
        self.my = y;
        pm.show();
    }
    pm := TreeMenu {
        x: root.mx;
        y: root.my;
        target: root.target;
        is-queue: root.is-queue;
        builtin: root.builtin;
        chosen(a) => {
            root.chosen(a);
        }
    }
}

export component MainWindow inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Ezoo Download");
    // Options > General > Background picture (shows through the panels)
    in property <image> bg-image;
    in property <bool> has-bg-image;
    // the size the window opens with
    preferred-width: 1080px;
    preferred-height: 700px;
    min-width: 820px;
    min-height: 520px;

    in property <[DownloadRow]> rows;
    in property <[QueueRow]> queues;
    in property <[CatRow]> categories;
    // counts: all, unfinished, finished
    in property <string> count-all;
    in property <string> count-unfinished;
    in property <string> count-finished;
    in-out property <int> selected-id: -1;
    // "all", "cat:Video", "unfinished", "unf:Video", "finished", "fin:Video", "queue:3"
    in-out property <string> view: "all";
    in-out property <string> search;
    in property <string> status-text;
    in property <string> limiter-text;
    in property <int> selected-state: -1;
    // multiple selection: how many, and whether any can be resumed / stopped
    in property <int> sel-count;
    in property <bool> can-resume;
    in property <bool> can-stop;
    in property <int> current-queue: 1;
    in property <bool> limiter-on;
    in property <bool> hide-categories;
    in property <string> sort-by: "date";
    in property <bool> sort-desc: true;
    // Downloads > When all downloads finish: 0 nothing, 1 shut down, 2 sleep, 3 exit, 4 hibernate
    in property <int> all-done: 0;
    in property <Cols> cols: { q: true, size: true, status: true, eta: true, speed: true, last: true, desc: true };
    in property <bool> toolbar-small;
    in property <string> language: "en";
    in-out property <bool> open-all: true;
    in-out property <bool> open-unf: false;
    in-out property <bool> open-fin: false;
    in-out property <bool> open-queues: true;

    callback add-url();
    callback add-batch();
    callback add-batch-clipboard();
    callback resume(int);
    callback pause(int);
    callback resume-all();
    callback stop-all();
    callback delete(int);
    callback delete-completed();
    callback open-settings(int);
    callback open-scheduler();
    callback open-limiter();
    callback toggle-limiter();
    callback start-queue(int);
    callback stop-queue(int);
    callback new-queue();
    callback edit-queue(int);
    callback delete-queue(int);
    callback view-changed(string);
    callback search-changed();
    callback sort(string);
    callback row-activated(int);
    callback row-clicked(int, bool, bool);
    callback row-right(int);
    callback row-drag(int, int);
    callback row-drag-out(int);
    // the list's columns (order + widths); dragging in the header changes them
    in property <[ColDef]> columns;
    callback column-resized(int, length);
    callback column-dropped(int, length);
    callback columns-changed();
    pure function col-title(k: string) -> string {
        if (k == "name") { return @tr("File Name"); }
        if (k == "q") { return @tr("Q"); }
        if (k == "size") { return @tr("Size"); }
        if (k == "status") { return @tr("Status"); }
        if (k == "eta") { return @tr("Time left"); }
        if (k == "speed") { return @tr("Transfer rate"); }
        if (k == "last") { return @tr("Last Try Date"); }
        if (k == "desc") { return @tr("Description"); }
        if (k == "added") { return @tr("Date Added"); }
        if (k == "saveto") { return @tr("Save To"); }
        if (k == "referer") { return @tr("Referer"); }
        if (k == "parent") { return @tr("Parent Web Page"); }
        return k;
    }
    pure function col-sort-key(k: string) -> string {
        if (k == "q") { return ""; }
        if (k == "last") { return "date"; }
        return k;
    }
    callback select-all();
    callback row-action(int, string);
    callback row-to-queue(int, int);
    callback open-download-folder();
    callback export-list(string);
    callback import-list(string);
    callback set-theme(int);
    callback set-language(string);
    callback toggle-categories();
    callback set-toolbar-small(bool);
    callback open-columns();
    callback update-tools();
    callback check-app-update();
    callback set-all-done(int);
    callback add-category();
    callback category-props(string);
    callback delete-category(string);
    callback find();
    callback find-next();
    callback grabber();
    callback playlist();
    callback torrent();
    callback browsers();
    callback tips();
    callback about();
    callback quit();

    MenuBar {
        Menu {
            title: @tr("Tasks");
            MenuItem {
                title: @tr("Add new download…");
                activated => {
                    root.add-url();
                }
            }
            MenuItem {
                title: @tr("Add batch download…");
                activated => {
                    root.add-batch();
                }
            }
            MenuItem {
                title: @tr("Add batch download from clipboard");
                activated => {
                    root.add-batch-clipboard();
                }
            }
            MenuItem {
                title: @tr("Run site grabber…");
                activated => {
                    root.grabber();
                }
            }
            MenuItem {
                title: @tr("Download a playlist…");
                activated => {
                    root.playlist();
                }
            }
            MenuItem {
                title: @tr("Add a torrent / magnet link…");
                activated => {
                    root.torrent();
                }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Export");
                MenuItem {
                    title: @tr("To download list file (.ef2)…");
                    activated => {
                        root.export-list("ef2");
                    }
                }
                MenuItem {
                    title: @tr("To text file…");
                    activated => {
                        root.export-list("txt");
                    }
                }
            }
            Menu {
                title: @tr("Import");
                MenuItem {
                    title: @tr("From download list file (.ef2)…");
                    activated => {
                        root.import-list("ef2");
                    }
                }
                MenuItem {
                    title: @tr("From text file…");
                    activated => {
                        root.import-list("txt");
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Open download folder");
                activated => {
                    root.open-download-folder();
                }
            }
            MenuItem {
                title: @tr("Exit");
                activated => {
                    root.quit();
                }
            }
        }
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("Download now");
                enabled: root.can-resume;
                activated => {
                    root.resume(root.selected-id);
                }
            }
            MenuItem {
                title: @tr("Stop download");
                enabled: root.can-stop;
                activated => {
                    root.pause(root.selected-id);
                }
            }
            MenuItem {
                title: @tr("Remove");
                enabled: root.selected-id >= 0;
                activated => {
                    root.delete(root.selected-id);
                }
            }
            MenuItem {
                title: @tr("Redownload");
                enabled: root.selected-id >= 0;
                activated => {
                    root.row-action(root.selected-id, "restart");
                }
            }
            MenuItem {
                title: @tr("Refresh download address…");
                enabled: root.selected-id >= 0 && root.selected-state != 3;
                activated => {
                    root.row-action(root.selected-id, "refresh");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Open");
                enabled: root.selected-state == 3;
                activated => {
                    root.row-action(root.selected-id, "open");
                }
            }
            MenuItem {
                title: @tr("Open with…");
                enabled: root.selected-state == 3;
                activated => {
                    root.row-action(root.selected-id, "openwith");
                }
            }
            MenuItem {
                title: @tr("Play while downloading");
                enabled: root.selected-id >= 0 && root.selected-state != 3;
                activated => {
                    root.row-action(root.selected-id, "preview");
                }
            }
            MenuItem {
                title: @tr("Open folder");
                enabled: root.selected-id >= 0;
                activated => {
                    root.row-action(root.selected-id, "folder");
                }
            }
            MenuItem {
                title: @tr("Move / Rename…");
                enabled: root.selected-id >= 0;
                activated => {
                    root.row-action(root.selected-id, "move");
                }
            }
            MenuItem {
                title: @tr("Copy address");
                enabled: root.selected-id >= 0;
                activated => {
                    root.row-action(root.selected-id, "copy");
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Select All");
                activated => {
                    root.select-all();
                }
            }
            MenuItem {
                title: @tr("Properties");
                enabled: root.selected-id >= 0;
                activated => {
                    root.row-action(root.selected-id, "properties");
                }
            }
        }
        Menu {
            title: @tr("Downloads");
            MenuItem {
                title: @tr("Resume all");
                activated => {
                    root.resume-all();
                }
            }
            MenuItem {
                title: @tr("Stop all");
                activated => {
                    root.stop-all();
                }
            }
            MenuItem {
                title: @tr("Delete all completed");
                activated => {
                    root.delete-completed();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Find…");
                activated => {
                    root.find();
                }
            }
            MenuItem {
                title: @tr("Find next   F3");
                activated => {
                    root.find-next();
                }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Start queue");
                for q in root.queues: MenuItem {
                    title: q.name;
                    activated => {
                        root.start-queue(q.id);
                    }
                }
            }
            Menu {
                title: @tr("Stop queue");
                for q in root.queues: MenuItem {
                    title: q.name;
                    activated => {
                        root.stop-queue(q.id);
                    }
                }
            }
            Menu {
                title: @tr("Speed Limiter");
                MenuItem {
                    // a mark in the name, not "checkable": a checkable item flips by itself
                    // and then keeps its mark (two marks at once)
                    title: (root.limiter-on ? "● " : "○ ") + @tr("Turn on");
                    activated => {
                        if (!root.limiter-on) {
                            root.toggle-limiter();
                        }
                    }
                }
                MenuItem {
                    title: (!root.limiter-on ? "● " : "○ ") + @tr("Turn off");
                    activated => {
                        if (root.limiter-on) {
                            root.toggle-limiter();
                        }
                    }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Settings…");
                    activated => {
                        root.open-limiter();
                    }
                }
            }
            Menu {
                title: @tr("When all downloads finish");
                MenuItem {
                    title: (root.all-done == 0 ? "● " : "○ ") + @tr("Do nothing");
                    activated => {
                        root.set-all-done(0);
                    }
                }
                MenuItem {
                    title: (root.all-done == 1 ? "● " : "○ ") + @tr("Shut down the computer");
                    activated => {
                        root.set-all-done(1);
                    }
                }
                MenuItem {
                    title: (root.all-done == 2 ? "● " : "○ ") + @tr("Sleep");
                    activated => {
                        root.set-all-done(2);
                    }
                }
                MenuItem {
                    title: (root.all-done == 4 ? "● " : "○ ") + @tr("Hibernate");
                    activated => {
                        root.set-all-done(4);
                    }
                }
                MenuItem {
                    title: (root.all-done == 3 ? "● " : "○ ") + @tr("Exit Ezoo Download");
                    activated => {
                        root.set-all-done(3);
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Scheduler…");
                activated => {
                    root.open-scheduler();
                }
            }
            MenuItem {
                title: @tr("Settings…");
                activated => {
                    root.open-settings(0);
                }
            }
        }
        Menu {
            title: @tr("View");
            MenuItem {
                title: (!root.hide-categories ? "☑ " : "☐ ") + @tr("Show categories");
                activated => {
                    root.toggle-categories();
                }
            }
            Menu {
                title: @tr("Arrange files");
                for a in [
                    { key: "added", title: @tr("By order of addition") },
                    { key: "name", title: @tr("File name") },
                    { key: "size", title: @tr("Size") },
                    { key: "status", title: @tr("Status") },
                    { key: "eta", title: @tr("Time left") },
                    { key: "speed", title: @tr("Transfer rate") },
                    { key: "date", title: @tr("Last try date") },
                    { key: "desc", title: @tr("Description") },
                    { key: "saveto", title: @tr("Save to") },
                    { key: "referer", title: @tr("Referer") },
                    { key: "parent", title: @tr("Parent web page") }
                ]: MenuItem {
                    title: (root.sort-by == a.key ? "● " : "○ ") + a.title;
                    activated => {
                        root.sort(a.key);
                    }
                }
            }
            Menu {
                title: @tr("Download List");
                MenuItem {
                    title: (!root.detailed-list ? "● " : "○ ") + @tr("List");
                    activated => { root.detailed-list = false; }
                }
                MenuItem {
                    title: (root.detailed-list ? "● " : "○ ") + @tr("Details");
                    activated => { root.detailed-list = true; }
                }
            }
            MenuItem {
                title: @tr("Columns…");
                activated => {
                    root.detailed-list = true;
                    root.open-columns();
                }
            }
            Menu {
                title: @tr("Language");
                MenuItem {
                    title: (root.language == "en" ? "● " : "○ ") + "English";
                    activated => {
                        root.set-language("en");
                    }
                }
                MenuItem {
                    title: (root.language == "ar" ? "● " : "○ ") + "العربية";
                    activated => {
                        root.set-language("ar");
                    }
                }
                MenuItem {
                    title: (root.language == "fr" ? "● " : "○ ") + "Français";
                    activated => {
                        root.set-language("fr");
                    }
                }
                MenuItem {
                    title: (root.language == "es" ? "● " : "○ ") + "Español";
                    activated => {
                        root.set-language("es");
                    }
                }
                MenuItem {
                    title: (root.language == "de" ? "● " : "○ ") + "Deutsch";
                    activated => {
                        root.set-language("de");
                    }
                }
                MenuItem {
                    title: (root.language == "pt" ? "● " : "○ ") + "Português";
                    activated => {
                        root.set-language("pt");
                    }
                }
                MenuItem {
                    title: (root.language == "tr" ? "● " : "○ ") + "Türkçe";
                    activated => {
                        root.set-language("tr");
                    }
                }
                MenuItem {
                    title: (root.language == "ru" ? "● " : "○ ") + "Русский";
                    activated => {
                        root.set-language("ru");
                    }
                }
            }
            Menu {
                title: @tr("Appearance");
                for choice in [{ name: @tr("System"), value: 0 }, { name: @tr("Light"), value: 1 }, { name: @tr("Dark"), value: 2 }]: MenuItem {
                    title: (Theme.appearance == choice.value ? "● " : "○ ") + choice.name;
                    activated => { root.set-theme(choice.value); }
                }
                MenuSeparator { }
                MenuItem { title: @tr("Appearance…"); activated => { root.open-settings(9); } }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Add Ezoo Download to my browser…");
                activated => {
                    root.browsers();
                }
            }
            MenuItem {
                title: @tr("Tip of the day…");
                activated => {
                    root.tips();
                }
            }
            MenuItem {
                title: @tr("Check for updates");
                activated => {
                    root.check-app-update();
                }
            }
            MenuItem {
                title: @tr("Check for updates (video downloader)");
                activated => {
                    root.update-tools();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("About Ezoo Download");
                activated => {
                    root.about();
                }
            }
        }
    }

    function category-menu(target: string, a: string) {
        if (a == "add") {
            root.add-category();
        } else if (a == "delete") {
            root.delete-category(target);
        } else if (a == "props") {
            root.category-props(target);
        }
    }
    function queue-menu-action(q: int, a: string) {
        if (a == "start") {
            root.start-queue(q);
        } else if (a == "stop") {
            root.stop-queue(q);
        } else if (a == "edit") {
            root.edit-queue(q);
        } else if (a == "new") {
            root.new-queue();
        } else if (a == "delete") {
            root.delete-queue(q);
        }
    }

    property <length> qmenu-x;
    property <bool> qmenu-start: true;
    queue-menu := PopupWindow {
        x: root.qmenu-x;
        y: 66px;
        width: 220px;
        height: qm-list.preferred-height;
        Rectangle {
            width: parent.width;
            height: qm-list.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000055;
            qm-list := VerticalLayout {
                padding: 4px;
                MenuLabel {
                    text: root.qmenu-start ? @tr("Start queue") : @tr("Stop queue");
                }
                for q in root.queues: MenuEntry {
                    text: q.name;
                    glyph: q.running ? "play" : "";
                    glyph-color: #2e9e4f;
                    indent: true;
                    clicked => {
                        if (root.qmenu-start) {
                            root.start-queue(q.id);
                        } else {
                            root.stop-queue(q.id);
                        }
                    }
                }
            }
        }
    }

    if root.has-bg-image: Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: root.bg-image;
        image-fit: cover;
    }
    property <bool> detailed-list: false;
    more-menu := PopupWindow {
        x: max(8px, root.width - 284px);
        y: 58px;
        width: 264px;
        height: more-items.preferred-height;
        Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 12px;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000030;
            more-items := VerticalLayout {
                padding: 8px;
                spacing: 2px;
                MenuEntry { text: @tr("Add batch download…"); glyph: "plus"; clicked => { more-menu.close(); root.add-batch(); } }
                MenuEntry { text: @tr("Download a playlist…"); glyph: "video"; clicked => { more-menu.close(); root.playlist(); } }
                MenuEntry { text: @tr("Add a torrent / magnet link…"); glyph: "down"; clicked => { more-menu.close(); root.torrent(); } }
                MenuEntry { text: @tr("Run site grabber…"); glyph: "search"; clicked => { more-menu.close(); root.grabber(); } }
                MenuSep { }
                MenuEntry { text: @tr("Resume all"); glyph: "play"; clicked => { more-menu.close(); root.resume-all(); } }
                MenuEntry { text: @tr("Stop all"); glyph: "pause"; clicked => { more-menu.close(); root.stop-all(); } }
                MenuEntry { text: @tr("Scheduler…"); glyph: "clock"; clicked => { more-menu.close(); root.open-scheduler(); } }
                MenuEntry { text: root.limiter-on ? @tr("Speed Limiter: On") : @tr("Speed Limiter: Off"); glyph: "progress"; clicked => { more-menu.close(); root.open-limiter(); } }
                MenuSep { }
                MenuEntry { text: root.detailed-list ? @tr("Compact List") : @tr("Details View"); glyph: "sidebar"; clicked => { more-menu.close(); root.detailed-list = !root.detailed-list; } }
                MenuEntry { text: @tr("Add Ezoo Download to my browser…"); glyph: "plus"; clicked => { more-menu.close(); root.browsers(); } }
                MenuEntry { text: @tr("Settings…"); glyph: "settings"; clicked => { more-menu.close(); root.open-settings(0); } }
            }
        }
    }
    // Slint normalizes macOS Command to modifiers.control.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "a" || event.text == "A")) { root.select-all(); return accept; }
            if (event.text == Key.Delete && root.selected-id >= 0) { root.delete(root.selected-id); return accept; }
            if (event.text == Key.Return && root.selected-id >= 0) { root.row-activated(root.selected-id); return accept; }
            if (event.text == Key.F3) { root.find-next(); return accept; }
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) { search-box.focus(); return accept; }
            if (event.modifiers.control && (event.text == "n" || event.text == "N")) { root.add-url(); return accept; }
            if (event.modifiers.control && (event.text == "b" || event.text == "B")) { root.add-batch(); return accept; }
            if (Theme.native-macos && event.modifiers.control && event.text == ",") { root.open-settings(0); return accept; }
            reject
        }
        HorizontalLayout {
            spacing: 0px;
            if !root.hide-categories: Rectangle {
                width: 220px * max(1, min(1.25, Theme.font-scale));
                background: Theme.sidebar;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 22px;
                    padding-bottom: 14px;
                    spacing: 14px;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 9px;
                        BrandMark { width: 28px; height: 28px; }
                        Text { text: "Ezoo Download"; color: Theme.text; font-size: 14px * Theme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            spacing: 3px;
                            Text { text: @tr("Library"); color: Theme.muted; font-size: 13px * Theme.font-scale; font-weight: 600; height: 24px; vertical-alignment: center; }
                            CtxTreeItem { text: @tr("All Downloads"); icon: "folder"; count: root.count-all; selected: root.view == "all"; builtin: true; clicked => { root.view = "all"; root.view-changed(root.view); } chosen(a) => { root.category-menu("", a); } }
                            TreeItem { text: @tr("Unfinished"); icon: "unfinished"; count: root.count-unfinished; selected: root.view == "unfinished"; clicked => { root.view = "unfinished"; root.view-changed(root.view); } }
                            TreeItem { text: @tr("Finished"); icon: "finished"; count: root.count-finished; selected: root.view == "finished"; clicked => { root.view = "finished"; root.view-changed(root.view); } }
                            Rectangle { height: 12px; }
                            HorizontalLayout {
                                Text { text: @tr("File Types"); color: Theme.muted; font-size: 13px * Theme.font-scale; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                                ToolbarAction { glyph: "plus"; label: @tr("Add category…"); width: 26px; height: 26px; clicked => { root.add-category(); } }
                            }
                            for c in root.categories: CtxTreeItem {
                                text: c.label; icon: c.kind; category-icon: true; count: c.count; target: c.name; builtin: c.builtin;
                                selected: root.view == "cat:" + c.name;
                                clicked => { root.view = "cat:" + c.name; root.view-changed(root.view); }
                                chosen(a) => { root.category-menu(c.name, a); }
                            }
                            Rectangle { height: 12px; }
                            HorizontalLayout {
                                Text { text: @tr("Queues"); color: Theme.muted; font-size: 13px * Theme.font-scale; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                                ToolbarAction { glyph: "plus"; label: @tr("New queue"); width: 26px; height: 26px; clicked => { root.new-queue(); } }
                            }
                            for q in root.queues: CtxTreeItem {
                                is-queue: true; builtin: q.id == 1; target: q.name;
                                text: q.name; icon: q.running ? "play" : "queue"; count: q.count > 0 ? q.count : "";
                                selected: root.view == "queue:" + q.id;
                                clicked => { root.view = "queue:" + q.id; root.view-changed(root.view); }
                                toggle => { root.edit-queue(q.id); }
                                chosen(a) => { root.queue-menu-action(q.id, a); }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                    HorizontalLayout {
                        ToolbarAction { glyph: "settings"; label: @tr("Settings…"); clicked => { root.open-settings(0); } }
                        Text { text: @tr("Settings"); color: Theme.muted; font-size: 13px * Theme.font-scale; vertical-alignment: center; horizontal-stretch: 1; }
                        ToolbarAction { glyph: "folder"; label: @tr("Open download folder"); clicked => { root.open-download-folder(); } }
                    }
                }
            }
            Rectangle { width: root.hide-categories ? 0px : 1px; background: Theme.line; }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.panel;
                VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 74px;
                        background: Theme.panel;
                        HorizontalLayout {
                            y: 21px;
                            height: 32px;
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 10px;
                            if root.hide-categories: ToolbarAction { glyph: "sidebar"; label: @tr("Show categories"); clicked => { root.toggle-categories(); } }
                            Text { text: root.view == "unfinished" ? @tr("Unfinished") : root.view == "finished" ? @tr("Completed") : @tr("Downloads"); color: Theme.text; font-size: 22px * Theme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            search-box := QuietField {
                                width: 180px;
                                height: 32px;
                                placeholder-text: @tr("Search Downloads");
                                accessible-label: @tr("Search Downloads");
                                text <=> root.search;
                                edited(t) => { root.search-changed(); }
                            }
                            QuietButton { text: @tr("New Download…"); primary: true; height: 32px; clicked => { root.add-url(); } }
                            ToolbarAction { glyph: "more"; label: @tr("More Actions"); clicked => { more-menu.show(); } }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                    Rectangle {
                        height: 48px;
                        background: Theme.panel;
                        HorizontalLayout {
                            y: 8px;
                            height: 32px;
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 6px;
                            Text { text: root.status-text; color: Theme.muted; font-size: 13px * Theme.font-scale; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                            ToolbarAction { glyph: "play"; label: @tr("Resume"); enabled: root.can-resume; clicked => { root.resume(root.selected-id); } }
                            ToolbarAction { glyph: "pause"; label: @tr("Pause"); enabled: root.can-stop; clicked => { root.pause(root.selected-id); } }
                            ToolbarAction { glyph: "folder"; label: (Theme.native-macos ? @tr("Show in Finder") : @tr("Show in folder")); enabled: root.selected-id >= 0; clicked => { root.row-action(root.selected-id, "folder"); } }
                            ToolbarAction { glyph: "trash"; label: @tr("Remove"); enabled: root.selected-id >= 0; clicked => { root.delete(root.selected-id); } }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        min-width: 0px;
                        clip: true;
                        background: Theme.panel;
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            if root.detailed-list: Rectangle {
                                height: 32px * Theme.font-scale;
                                background: Theme.secondary-surface;
                                clip: true;
                                HorizontalLayout {
                                    x: lv.content-x;
                                    width: max(parent.width, lv.content-width);
                                    padding-left: 6px;
                                    HeaderCell { text: ""; width: 32px; }
                                    for c[i] in root.columns: HeaderCell {
                                        width: c.width; adjustable: true; text: root.col-title(c.key); key: root.col-sort-key(c.key);
                                        align: c.key == "size" || c.key == "eta" || c.key == "speed" ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                        sort-by: root.sort-by; sort-desc: root.sort-desc;
                                        sort(k) => { root.sort(k); }
                                        resized(w) => { root.column-resized(i, w); }
                                        resize-done => { root.columns-changed(); }
                                        dropped(x) => { root.column-dropped(i, x); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            lv := ListView {
                                vertical-stretch: 1;
                                for r in root.rows: DownloadItem {
                                    detailed: root.detailed-list;
                                    data: r; queues: root.queues; cols: root.cols; columns: root.columns; selected: r.sel; sel-count: root.sel-count;
                                    pick(ctrl, shift) => { root.row-clicked(r.id, ctrl, shift); keys.focus(); }
                                    right-pick => { root.row-right(r.id); }
                                    drag(offset) => { root.row-drag(r.id, offset); }
                                    drag-out => { root.row-drag-out(r.id); }
                                    activated => { root.row-activated(r.id); }
                                    action(a) => { root.row-action(r.id, a); }
                                    move-to-queue(q) => { root.row-to-queue(r.id, q); }
                                }
                            }
                        }
                        if root.rows.length == 0: VerticalLayout {
                            x: 24px;
                            y: max(36px, (parent.height - self.preferred-height) / 2 - 24px);
                            width: parent.width - 48px;
                            height: self.preferred-height;
                            spacing: 12px;
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 64px; height: 64px; background: Theme.secondary-surface; border-radius: 18px;
                                    Glyph { kind: "down"; tint: Theme.accent; width: 30px; height: 30px; x: 17px; y: 17px; }
                                }
                            }
                            Text { text: root.search != "" ? @tr("No Matches") : @tr("No Downloads Yet"); horizontal-alignment: center; color: Theme.text; font-size: 20px * Theme.font-scale; font-weight: 600; }
                            Text { text: root.search != "" ? @tr("Nothing matches “{}”.", root.search) : @tr("Add a link or send a download from your browser."); horizontal-alignment: center; color: Theme.muted; font-size: 13px * Theme.font-scale; wrap: word-wrap; }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;
                                if root.search != "": Button { text: @tr("Clear Search"); clicked => { root.search = ""; root.search-changed(); } }
                                if root.search == "": Button { text: @tr("New Download…"); primary: true; clicked => { root.add-url(); } }
                                if root.search == "": Button { text: @tr("Connect Browser…"); clicked => { root.browsers(); } }
                            }
                        }
                    }
                    Rectangle {
                        height: 36px;
                        background: Theme.panel;
                        Rectangle { y: 0px; width: parent.width; height: 1px; background: Theme.line; }
                        HorizontalLayout {
                            y: 1px;
                            width: parent.width;
                            height: parent.height - 1px;
                            padding-left: 20px; padding-right: 20px;
                            Text { text: root.sel-count > 0 ? @tr("{} selected", root.sel-count) : @tr("{} downloads", root.rows.length); color: Theme.muted; font-size: 13px * Theme.font-scale; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: root.limiter-text; color: root.limiter-on ? Theme.warn : Theme.muted; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
    // the note of the toolbar button the mouse rests on (drawn above everything)
    Timer {
        interval: 600ms;
        running: ToolTip.pending;
        triggered => {
            ToolTip.pending = false;
            ToolTip.shown = true;
        }
    }
    if ToolTip.shown && ToolTip.text != "": Rectangle {
        x: min(ToolTip.x, root.width - self.width - 6px);
        y: ToolTip.y;
        width: min(320px, tip-box.preferred-width);
        height: tip-box.preferred-height;
        background: Theme.input-bg;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 4px;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000044;
        drop-shadow-offset-y: 2px;
        tip-box := VerticalLayout {
            padding: 8px;
            spacing: 3px;
            Text {
                text: ToolTip.title;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: ToolTip.text;
                wrap: word-wrap;
                color: Theme.muted;
            }
        }
    }
}

// ------------------------------------------------------------------ dialogs

// "Download File Info" – shown for every new download.
export component AddDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("New Download");
    preferred-width: 540px;
    min-width: 500px;

    in-out property <string> url;
    // full path: folder + file name
    in-out property <string> save-as;
    in-out property <string> description;
    in-out property <int> connections: 32;
    in-out property <int> category-index: 0;
    in-out property <bool> remember-path;
    in property <string> category-name: "General";
    in property <string> kind: "general";
    in property <string> ext;
    in property <string> size-text;
    in property <string> info;
    in property <bool> probing;
    in property <bool> info-error;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in property <[string]> category-names: ["General", "Compressed", "Documents", "Music", "Programs", "Video", "Images"];
    in-out property <bool> use-login;
    in-out property <string> user;
    in-out property <string> password;
    // a warning about the address (web page, duplicate...)
    in property <string> warning;
    // the server refused Ezoo Download: offer the browser instead
    in property <bool> can-use-browser;
    callback use-browser();

    callback check-url();
    callback category-changed(int);
    callback browse();
    callback start-now();
    callback later();
    callback cancel();

    // Friendly editing fields never show a signed URL or a full local path.
    in-out property <string> file-name;
    in property <string> destination;
    in property <string> source-host;
    in property <string> name-error;
    in property <bool> manual-url;
    in-out property <bool> show-advanced;
    callback rename-file(string);
    callback refresh-destination();
    out property <length> natural-height: dialog-content.preferred-height;

    dialog-content := VerticalLayout {
        padding: 24px;
        spacing: 18px;
        VerticalLayout {
            alignment: start;
            vertical-stretch: 0;
            spacing: 5px;
            Text {
                vertical-stretch: 0;
                text: @tr("New Download");
                font-size: 22px * Theme.font-scale;
                font-weight: 600;
                color: Theme.text;
            }
            if root.source-host != "": Text {
                vertical-stretch: 0;
                text: root.source-host + (root.size-text != "" ? "  ·  " + root.size-text : "");
                color: Theme.muted;
                font-size: 13px * Theme.font-scale;
                overflow: elide;
            }
        }
        if root.manual-url: VerticalLayout {
            alignment: start;
            vertical-stretch: 0;
            spacing: 7px;
            Text { text: @tr("Download link"); color: Theme.text; font-weight: 600; vertical-stretch: 0; }
            HorizontalLayout {
                spacing: 8px;
                QuietField {
                    text <=> root.url;
                    label: @tr("Download link");
                    placeholder-text: "https://";
                    horizontal-stretch: 1;
                    accepted(t) => { root.check-url(); }
                }
                QuietButton { text: @tr("Check"); clicked => { root.check-url(); } }
            }
        }
        VerticalLayout {
            alignment: start;
            vertical-stretch: 0;
            spacing: 7px;
            Text { text: @tr("Name"); color: Theme.text; font-weight: 600; vertical-stretch: 0; }
            QuietField {
                text <=> root.file-name;
                label: @tr("Name");
                placeholder-text: @tr("File name");
                edited(t) => { root.rename-file(t); }
            }
            if root.name-error != "": Text {
                vertical-stretch: 0;
                text: root.name-error;
                color: Theme.err;
                font-size: 12px * Theme.font-scale;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: start;
            vertical-stretch: 0;
            spacing: 7px;
            Text { text: @tr("Save location"); color: Theme.text; font-weight: 600; vertical-stretch: 0; }
            HorizontalLayout {
                spacing: 10px;
                height: 36px * Theme.font-scale;
                Rectangle {
                    width: 19px;
                    Glyph { kind: "folder"; tint: Theme.accent-text; width: 19px; height: 19px; y: (parent.height - self.height) / 2; }
                }
                Text {
                    text: root.destination;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                QuietButton { text: @tr("Change…"); clicked => { root.browse(); } }
            }
        }
        if root.probing: Text {
            vertical-stretch: 0;
            text: @tr("Checking the file…");
            color: Theme.muted;
            font-size: 12px * Theme.font-scale;
        }
        if root.info-error: Text {
            vertical-stretch: 0;
            text: @tr("Couldn’t check this file. Check the link or try downloading again.");
            color: Theme.err;
            wrap: word-wrap;
            font-size: 12px * Theme.font-scale;
        }
        if root.warning != "": Text {
            vertical-stretch: 0;
            text: root.warning;
            color: Theme.warn;
            wrap: word-wrap;
            font-size: 12px * Theme.font-scale;
        }
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 8px;
            QuietButton {
                text: root.show-advanced ? @tr("Hide Advanced") : @tr("Advanced…");
                clicked => { root.show-advanced = !root.show-advanced; }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.show-advanced: ScrollView {
          height: min(250px, advanced-body.preferred-height + 4px);
          preferred-height: self.height;
          vertical-stretch: 0;
          content-width: self.visible-width;
          content-height: advanced-body.preferred-height;
          horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
          advanced-body := VerticalLayout {
            width: parent.width;
            height: self.preferred-height;
            alignment: start;
            vertical-stretch: 0;
            spacing: 12px;
            Rectangle { height: 1px; background: Theme.line; }
            if !root.manual-url: VerticalLayout {
                alignment: start;
                vertical-stretch: 0;
                spacing: 7px;
                Text { text: @tr("Download link"); color: Theme.muted; }
                HorizontalLayout {
                    spacing: 8px;
                    QuietField {
                        text <=> root.url;
                        label: @tr("Download link");
                        horizontal-stretch: 1;
                        accepted(t) => { root.check-url(); }
                    }
                    QuietButton { text: @tr("Check"); clicked => { root.check-url(); } }
                }
            }
            GridLayout {
                spacing: 10px;
                Row {
                    Text { text: @tr("Category"); color: Theme.muted; vertical-alignment: center; }
                    ComboBox {
                        model: root.category-names;
                        current-index <=> root.category-index;
                        selected(v) => { root.category-changed(root.category-index); }
                    }
                }
                Row {
                    Text { text: @tr("Save As"); color: Theme.muted; vertical-alignment: center; }
                    QuietField {
                        text <=> root.save-as;
                        label: @tr("Save As");
                        edited(t) => { root.refresh-destination(); }
                    }
                }
                Row {
                    Rectangle { }
                    CheckBox {
                        text: @tr("Remember this path for \"{}\" category", root.category-name);
                        checked <=> root.remember-path;
                    }
                }
                Row {
                    Text { text: @tr("Description"); color: Theme.muted; vertical-alignment: center; }
                    QuietField { text <=> root.description; label: @tr("Description"); placeholder-text: @tr("optional note"); }
                }
                Row {
                    Text { text: @tr("Connections"); color: Theme.muted; vertical-alignment: center; }
                    SpinBox { minimum: 1; maximum: 32; value <=> root.connections; }
                }
                Row {
                    Text { text: @tr("Queue"); color: Theme.muted; vertical-alignment: center; }
                    ComboBox { model: root.queue-names; current-index <=> root.queue-index; }
                }
            }
            CheckBox { text: @tr("Use authorization"); checked <=> root.use-login; }
            if root.use-login: HorizontalLayout {
                spacing: 8px;
                QuietField { text <=> root.user; label: @tr("Login"); placeholder-text: @tr("Login"); horizontal-stretch: 1; }
                QuietField { text <=> root.password; label: @tr("Password"); placeholder-text: @tr("Password"); input-type: InputType.password; horizontal-stretch: 1; }
            }
            if !root.info-error && root.info != "": Text {
                text: root.info;
                color: Theme.muted;
                font-size: 12px * Theme.font-scale;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                QuietButton {
                    text: @tr("Download Later");
                    enabled: root.url != "" && root.name-error == "";
                    clicked => { root.later(); }
                }
                if root.can-use-browser: QuietButton {
                    text: @tr("Download with the browser");
                    clicked => { root.use-browser(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
          }
        }
        Rectangle { vertical-stretch: 1; min-height: 0px; preferred-height: 0px; }
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            QuietButton { text: @tr("Cancel"); clicked => { root.cancel(); } }
            QuietButton {
                text: @tr("Download");
                primary: true;
                enabled: root.url != "" && root.name-error == "";
                clicked => { root.start-now(); }
            }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 32px;
    width: label.preferred-width + 28px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    forward-focus: keyboard;
    border-radius: 7px;
    background: root.active ? Theme.panel : ta.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: keyboard.has-focus ? Theme.accent : root.active ? Theme.line : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            keyboard.focus();
            root.clicked();
        }
    }
    keyboard := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px * Theme.font-scale;
        font-weight: root.active ? 600 : 400;
        color: Theme.text;
    }
}

export component BatchDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Add batch download");
    preferred-width: 640px;
    preferred-height: 560px;
    min-width: 600px;

    // 0: list of links, 1: address with a * pattern
    in-out property <int> mode: 0;
    in-out property <string> links;
    in-out property <string> folder;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in-out property <bool> start-now: true;
    in property <string> message;
    // pattern
    in-out property <string> pattern;
    in-out property <bool> letters;
    in-out property <string> from-text: "1";
    in-out property <string> to-text: "10";
    in-out property <int> wildcard-size: 1;
    in-out property <string> user;
    in-out property <string> password;
    in property <string> preview;

    callback paste();
    callback browse();
    callback pattern-changed();
    callback ok();
    callback cancel();

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        Text {
            text: @tr("Add batch download");
            font-size: 20px * Theme.font-scale;
            font-weight: 600;
            color: Theme.text;
        }
        HorizontalLayout {
            spacing: 4px;
            TabButton {
                text: @tr("List of links");
                active: root.mode == 0;
                clicked => {
                    root.mode = 0;
                }
            }
            TabButton {
                text: @tr("Address with a pattern (*)");
                active: root.mode == 1;
                clicked => {
                    root.mode = 1;
                    root.pattern-changed();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.mode == 0: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                text: @tr("Paste the links, one per line. They download one after another in the queue you choose.");
                wrap: word-wrap;
                color: Theme.muted;
            }
            TextEdit {
                text <=> root.links;
                vertical-stretch: 1;
                min-height: 200px;
                font-size: 13px * Theme.font-scale;
            }
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: @tr("Paste from clipboard");
                    clicked => {
                        root.paste();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
        if root.mode == 1: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                text: @tr("Type an address with a * where the number (or letter) goes, for example\nhttps://www.site.com/pictures/img*.jpg");
                wrap: word-wrap;
                color: Theme.muted;
            }
            LineEdit {
                text <=> root.pattern;
                placeholder-text: @tr("https://www.site.com/pictures/img*.jpg");
                edited(t) => {
                    root.pattern-changed();
                }
            }
            HorizontalLayout {
                spacing: 16px;
                CheckBox {
                    text: @tr("Letters (a-z) instead of numbers");
                    checked <=> root.letters;
                    toggled => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("From");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.from-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    text: @tr("To");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.to-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    text: @tr("Wildcard size");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                SpinBox {
                    width: 90px;
                    minimum: 1;
                    maximum: 10;
                    value <=> root.wildcard-size;
                    edited(v) => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: @tr("Wildcard size 3 makes 001, 002 … 010.");
                color: Theme.muted;
                font-size: 13px * Theme.font-scale;
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("Login");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.user;
                    placeholder-text: @tr("optional");
                    horizontal-stretch: 1;
                }
                Text {
                    text: @tr("Password");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.password;
                    input-type: InputType.password;
                    horizontal-stretch: 1;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 80px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                border-radius: 8px;
                Text {
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    text: root.preview;
                    font-size: 13px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        GridLayout {
            spacing: 8px;
            Row {
                Text {
                    text: @tr("Queue");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HorizontalLayout {
                    ComboBox {
                        model: root.queue-names;
                        current-index <=> root.queue-index;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
            }
            Row {
                Text {
                    text: @tr("Save all to");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        text <=> root.folder;
                        placeholder-text: @tr("automatic (by file type)");
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "…";
                        clicked => {
                            root.browse();
                        }
                    }
                }
            }
        }
        CheckBox {
            text: @tr("Start the queue now");
            checked <=> root.start-now;
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.message;
                color: Theme.err;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
            Button {
                text: @tr("Add");
                primary: true;
                clicked => {
                    root.ok();
                }
            }
        }
    }
}

// The per-download progress window (tabs like a classic download manager).
export component DetailsDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: root.percent + " " + root.name;
    preferred-width: 620px;
    preferred-height: 440px;
    min-width: 540px;
    min-height: 370px;
    // macOS supplies a native title bar and resize handles.
    in property <bool> native-frame: false;
    no-frame: !root.native-frame;

    in property <string> name;
    in property <string> percent;
    in property <string> url;
    in property <string> status;
    in property <string> size;
    in property <string> downloaded;
    in property <string> speed;
    in property <string> eta;
    in property <string> resumable;
    in property <bool> resumable-ok;
    in property <string> error;
    in property <string> kind: "general";
    in property <float> progress;
    in property <int> state;
    in property <[SegView]> segs;
    in-out property <bool> show-details: false;
    in-out property <int> tab: 0;
    // speed limiter tab
    in-out property <bool> limit-on;
    in-out property <int> limit-kb: 500;
    // options on completion tab
    in-out property <int> when-done: 0;
    in-out property <bool> complete-dialog: true;
    in-out property <bool> force-close;

    callback pause();
    callback resume();
    callback cancel-download();
    callback close-window();
    callback hide-to-tray();
    callback limit-changed();
    callback completion-changed();
    // title bar: move the window / minimize / the X
    callback start-drag();
    callback minimize();
    callback close-clicked();
    callback start-resize();

    property <bool> tray-tip;
    tip-timer := Timer {
        interval: 600ms;
        running: tray-btn.hovered && !root.tray-tip;
        triggered => {
            root.tray-tip = true;
        }
    }

    Rectangle {
        border-width: 1px;
        border-color: Theme.line;
    }
    VerticalLayout {
      padding: 1px;
      spacing: 0px;
      Rectangle {
        visible: !root.native-frame;
        height: root.native-frame ? 0px : 30px;
        background: Theme.panel;
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                horizontal-stretch: 1;
                drag := TouchArea {
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                            root.start-drag();
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 7px;
                    Image {
                        source: @image-url("icon-window.png");
                        width: 16px;
                        height: 16px;
                        y: 7px;
                    }
                    Text {
                        text: root.title;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Theme.text;
                        horizontal-stretch: 1;
                    }
                }
            }
            tray-btn := CaptionButton {
                kind: "tray";
                visible: root.state != 3;
                width: root.state != 3 ? 44px : 0px;
                changed hovered => {
                    if (!self.hovered) {
                        root.tray-tip = false;
                    }
                }
                clicked => {
                    root.tray-tip = false;
                    root.hide-to-tray();
                }
            }
            CaptionButton {
                kind: "min";
                clicked => {
                    root.minimize();
                }
            }
            CaptionButton {
                kind: "close";
                clicked => {
                    root.close-clicked();
                }
            }
        }
      }
      VerticalLayout {
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 12px;
            TypeIcon { kind: root.kind; width: 40px; height: 40px; }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 4px;
                Text {
                    text: root.name;
                    font-size: 16px * Theme.font-scale;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.status;
                    font-size: 13px * Theme.font-scale;
                    color: root.state == 4 ? Theme.err : Theme.muted;
                    overflow: elide;
                }
            }
            Text {
                text: root.percent;
                color: Theme.text;
                font-size: 22px * Theme.font-scale;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        Rectangle {
            vertical-stretch: 0;
            height: 7px;
            border-radius: 3.5px;
            background: Theme.bar-bg;
            clip: true;
            Rectangle {
                x: 0px;
                y: 0px;
                height: parent.height;
                width: parent.width * max(0, min(1, root.progress));
                border-radius: 3.5px;
                background: root.state == 3 ? Theme.ok : Theme.accent;
            }
        }
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 4px;
            TabButton { text: @tr("Download status"); active: root.tab == 0; clicked => { root.tab = 0; } }
            TabButton { text: @tr("Speed Limiter"); active: root.tab == 1; clicked => { root.tab = 1; } }
            TabButton { text: @tr("Options on completion"); active: root.tab == 2; clicked => { root.tab = 2; } }
            Rectangle { horizontal-stretch: 1; }
        }
        ScrollView {
            vertical-stretch: 1;
            min-height: 100px;
            preferred-height: 150px;
            content-width: self.visible-width;
            content-height: progress-body.preferred-height;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            progress-body := VerticalLayout {
                width: parent.width;
                height: self.preferred-height;
                alignment: start;
                vertical-stretch: 0;
                spacing: 12px;
                if root.tab == 0: VerticalLayout {
                    alignment: start;
                    vertical-stretch: 0;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 18px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: start;
                            spacing: 3px;
                            Text { text: @tr("Downloaded"); color: Theme.muted; font-size: 12px * Theme.font-scale; }
                            Text { text: root.downloaded; color: Theme.text; font-size: 14px * Theme.font-scale; font-weight: 600; overflow: elide; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: start;
                            spacing: 3px;
                            Text { text: @tr("File size"); color: Theme.muted; font-size: 12px * Theme.font-scale; }
                            Text { text: root.size; color: Theme.text; font-size: 14px * Theme.font-scale; font-weight: 600; overflow: elide; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: start;
                            spacing: 3px;
                            Text { text: @tr("Transfer rate"); color: Theme.muted; font-size: 12px * Theme.font-scale; }
                            Text { text: root.speed; color: Theme.text; font-size: 14px * Theme.font-scale; font-weight: 600; overflow: elide; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: start;
                            spacing: 3px;
                            Text { text: @tr("Time left"); color: Theme.muted; font-size: 12px * Theme.font-scale; }
                            Text { text: root.eta; color: Theme.text; font-size: 14px * Theme.font-scale; font-weight: 600; overflow: elide; }
                        }
                    }
                    if root.error != "": Text {
                        text: root.error;
                        color: Theme.err;
                        wrap: word-wrap;
                        font-size: 13px * Theme.font-scale;
                    }
                }
            if root.tab == 1: VerticalLayout {
                vertical-stretch: 0;
                spacing: 12px;
                alignment: start;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Transfer rate");
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.speed;
                        color: Theme.text;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                CheckBox {
                    text: @tr("Use speed limiter for this download");
                    checked <=> root.limit-on;
                    toggled => {
                        root.limit-changed();
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Maximum download speed (KB/s)");
                        color: root.limit-on ? Theme.text : Theme.muted;
                        vertical-alignment: center;
                    }
                    SpinBox {
                        width: 140px;
                        enabled: root.limit-on;
                        minimum: 1;
                        maximum: 1000000;
                        step-size: 50;
                        value <=> root.limit-kb;
                        edited(v) => {
                            root.limit-changed();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    for kb in [128, 256, 512]: QuietButton {
                        text: kb >= 1024 ? @tr("{} MB/s", kb / 1024) : @tr("{} KB/s", kb);
                        clicked => {
                            root.limit-on = true;
                            root.limit-kb = kb;
                            root.limit-changed();
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    for kb in [1024, 2048, 5120]: QuietButton {
                        text: kb >= 1024 ? @tr("{} MB/s", kb / 1024) : @tr("{} KB/s", kb);
                        clicked => {
                            root.limit-on = true;
                            root.limit-kb = kb;
                            root.limit-changed();
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    text: @tr("Changes apply right away, even while downloading.");
                    font-size: 13px * Theme.font-scale;
                    color: Theme.muted;
                }
            }
            if root.tab == 2: VerticalLayout {
                vertical-stretch: 0;
                spacing: 12px;
                alignment: start;
                Text {
                    text: @tr("When this download completes:");
                    color: Theme.text;
                }
                ComboBox {
                    width: 300px;
                    model: [@tr("Do nothing (keep the computer on)"), @tr("Shut down the computer"), @tr("Sleep"), @tr("Exit Ezoo Download"), @tr("Hibernate")];
                    current-index <=> root.when-done;
                    selected(v) => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Force programs to close when shutting down");
                    checked <=> root.force-close;
                    enabled: root.when-done == 1;
                    toggled => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Show the \"Download complete\" window");
                    checked <=> root.complete-dialog;
                    toggled => {
                        root.completion-changed();
                    }
                }
                Text {
                    text: @tr("You get 30 seconds to cancel before the computer shuts down, sleeps or hibernates.");
                    font-size: 13px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }

                if root.show-details: VerticalLayout {
                    alignment: start;
                    vertical-stretch: 0;
                    spacing: 8px;
                    Rectangle { height: 1px; background: Theme.line; }
                    Text { text: @tr("Download link"); color: Theme.muted; font-size: 12px * Theme.font-scale; }
                    Text { text: root.url; color: Theme.text; font-size: 12px * Theme.font-scale; overflow: elide; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: @tr("Resume capability"); color: Theme.muted; }
                        Text { text: root.resumable; color: root.resumable-ok ? Theme.ok : Theme.err; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: @tr("Start positions and download progress by connections"); color: Theme.muted; font-size: 12px * Theme.font-scale; wrap: word-wrap; }
            Rectangle {
                height: 12px;
                border-width: 1px;
                border-color: Theme.line;
                border-radius: 6px;
                background: Theme.panel;
                clip: true;
                for s in root.segs: Rectangle {
                    x: 1px + (parent.width - 2px) * s.start;
                    y: 1px;
                    width: (parent.width - 2px) * (s.done - s.start);
                    height: parent.height - 2px;
                    background: Theme.accent;
                }
                for s in root.segs: Rectangle {
                    x: 1px + (parent.width - 2px) * s.start;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: Theme.line;
                }
            }
            Rectangle {
                height: 180px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                border-radius: 8px;
                clip: true;
                VerticalLayout {
                    padding: 1px;
                    Rectangle {
                        height: 30px;
                        background: Theme.header-bottom;
                        HorizontalLayout {
                            HeaderCell {
                                text: @tr("N.");
                                width: 34px;
                            }
                            HeaderCell {
                                text: @tr("Downloaded");
                                width: 110px;
                            }
                            HeaderCell {
                                text: @tr("Info");
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for s in root.segs: Rectangle {
                            height: 28px;
                            HorizontalLayout {
                                Cell {
                                    text: s.number;
                                    width: 34px;
                                    horizontal-alignment: center;
                                }
                                Cell {
                                    text: " " + s.downloaded;
                                    width: 110px;
                                    horizontal-alignment: left;
                                }
                                Cell {
                                    text: s.info;
                                    horizontal-stretch: 1;
                                    color: s.busy ? Theme.accent-text : Theme.muted;
                                }
                            }
                        }
                    }
                }
            }

                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 8px;
            QuietButton {
                text: root.show-details ? @tr("Hide Details") : @tr("Show Details");
                clicked => { root.show-details = !root.show-details; }
            }
            Rectangle { horizontal-stretch: 1; }
            QuietButton {
                text: root.state == 3 ? @tr("Close") : @tr("Cancel");
                clicked => {
                    if (root.state == 3) { root.close-window(); }
                    else { root.cancel-download(); }
                }
            }
            if root.state == 0 || root.state == 1: QuietButton {
                text: @tr("Pause"); primary: true;
                clicked => { root.pause(); }
            }
            if root.state == 2 || root.state == 4: QuietButton {
                text: @tr("Resume"); primary: true;
                clicked => { root.resume(); }
            }
        }
      }
    }
    // the hint of the tray button
    if root.tray-tip: Rectangle {
        x: max(4px, root.width - 89px - tip-text.preferred-width - 16px);
        y: 32px;
        width: tip-text.preferred-width + 16px;
        height: tip-text.preferred-height + 10px;
        background: Theme.input-bg;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 3px;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000044;
        tip-text := Text {
            text: @tr("Hide next to the clock");
            color: Theme.text;
        }
    }
    // a corner to make the window bigger
    Rectangle {
        visible: !root.native-frame;
        x: root.width - 14px;
        y: root.height - 14px;
        width: 14px;
        height: 14px;
        TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                    root.start-resize();
                }
            }
        }
        Path {
            viewbox-width: 10;
            viewbox-height: 10;
            stroke: Theme.muted;
            stroke-width: 1px;
            commands: "M 9 3 L 3 9 M 9 6 L 6 9";
        }
    }
}

export component CompleteDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download complete");
    preferred-width: 560px;
    min-width: 500px;

    in property <string> name;
    in property <string> size;
    in property <string> path;
    in property <string> url;
    in property <string> kind: "general";
    in property <string> ext;
    in-out property <bool> dont-show;

    callback open-file();
    callback open-with();
    callback open-folder();
    callback close-window();

    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        HorizontalLayout {
            spacing: 16px;
            BigTypeIcon {
                kind: root.kind;
                ext: root.ext;
            }
            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Download complete");
                    font-size: 20px * Theme.font-scale;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: root.name;
                    font-size: 15px * Theme.font-scale;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.size;
                    font-size: 13px * Theme.font-scale;
                    color: Theme.muted;
                }
            }
        }
        Rectangle {
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 10px;
            background: Theme.panel;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: @tr("Saved as");
                    font-size: 13px * Theme.font-scale;
                    color: Theme.muted;
                }
                Text {
                    text: root.path;
                    wrap: word-wrap;
                    font-size: 13px * Theme.font-scale;
                    color: Theme.text;
                }
                Rectangle { height: 1px; background: Theme.line; }
                Text {
                    text: @tr("Address");
                    font-size: 13px * Theme.font-scale;
                    color: Theme.muted;
                }
                Text {
                    text: root.url;
                    overflow: elide;
                    font-size: 13px * Theme.font-scale;
                    color: Theme.accent-text;
                }
            }
        }
        CheckBox {
            text: @tr("Don't show this again");
            checked <=> root.dont-show;
        }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-window();
                }
            }
            // no "Open with…" here: picked by mistake it changes which
            // program opens this kind of file (still in the list's menu)
            Button {
                text: @tr("Open folder");
                clicked => {
                    root.open-folder();
                }
            }
            Button {
                text: @tr("Open");
                primary: true;
                clicked => {
                    root.open-file();
                }
            }
        }
    }
}
