// Ezoo Download – user interface (Slint)
// Classic download-manager layout: menu bar, big icon toolbar, category and
// queue tree, detailed list, one progress window per download. Nine themes.

import { Button, LineEdit, SpinBox, ComboBox, ListView, TabWidget, TextEdit, Palette } from "std-widgets.slint";
import { ToolTip, DownloadRow, QueueRow, SegView, TFileRow, TPeerRow, PieceRun, Cols, ColDef, CatRow, PairRow, LinkRow, Theme, ThemedWindow, CaptionButton, P, Icon, G, TypeIcon, BigTypeIcon, ToolBtn, ToolSeparator, TreeItem, HeaderCell, Cell, MenuEntry, MenuSep, MenuLabel, Glyph, HRow, CheckBox } from "common.slint";
export { DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme }
export { BrowserRow } from "dialogs.slint";
export { ConfirmDialog, ColumnsDialog, CategoryDialog, FindDialog, PropertiesDialog, DuplicateDialog, CountdownDialog, SchedulerDialog, GrabberDialog, TipDialog, RefreshDialog, SettingsDialog, PlaylistDialog, TorrentDialog, BrowserDialog, AboutDialog, UpdateDialog, WhatsNewDialog, SupportDialog, ClipDialog } from "dialogs.slint";

component DownloadItem inherits Rectangle {
    in property <DownloadRow> data;
    in property <bool> selected;
    in property <[QueueRow]> queues;
    in property <Cols> cols;
    in property <[ColDef]> columns;
    // how many downloads are selected (the menu then works on all of them)
    in property <int> sel-count;
    // click with Ctrl / Shift
    callback pick(bool, bool);
    // right click: keep a multiple selection that includes this row
    callback right-pick();
    // Windows: the menu is a real Windows menu (made by the program)
    in property <bool> native-menu;
    callback open-native-menu();
    // dragging with the mouse held down: rows below (+) or above (-) this one
    callback drag(int);
    property <int> drag-last;
    // the left button went down on this row and is still held
    property <bool> left-down;
    callback activated();
    callback action(string);
    callback move-to-queue(int);
    // dragging a finished file out of the program (onto the desktop, a folder…)
    callback drag-out();
    property <bool> dragged-out;
    height: Theme.depth ? max(40px, 34px * Theme.font-scale) : max(24px, 24px * Theme.font-scale);
    // as wide as all the columns (the list then scrolls sideways)
    out property <length> content-w: cells.min-width;
    // wide columns: the row is wider than the list. The look and the mouse
    // cover all of it (in Arabic the name is on the far right side of it)
    if !Theme.depth: Rectangle {
        x: 0px;
        width: cells.width;
        height: parent.height;
        background: root.selected ? Theme.select : ta.has-hover ? Theme.hover : transparent;
        border-width: root.selected ? 1px : 0px;
        border-color: Theme.select-line;
    }
    // the 3D look: every download is a card that floats over the list
    if Theme.depth: Rectangle {
        x: 4px;
        y: 3px;
        width: cells.width - 8px;
        height: parent.height - 6px;
        border-radius: Theme.card-radius;
        background: root.selected ? @linear-gradient(Theme.look == 1 ? 90deg : 180deg, Theme.sel-top 0%, Theme.sel-bottom 100%)
            : ta.has-hover ? @linear-gradient(180deg, Theme.card-hover-top 0%, Theme.card-bottom 100%)
            : @linear-gradient(180deg, Theme.card-top 0%, Theme.card-bottom 100%);
        border-width: 1px;
        border-color: root.selected ? Theme.sel-line : Theme.card-line;
        drop-shadow-blur: root.selected ? 12px : 7px;
        drop-shadow-offset-y: root.selected ? 4px : Theme.look == 3 ? 4px : 2px;
        drop-shadow-color: root.selected ? Theme.sel-shadow : Theme.card-shadow;
    }
    ta := TouchArea {
        x: 0px;
        width: cells.width;
        height: parent.height;
        double-clicked => {
            root.activated();
        }
        moved => {
            // a finished file pulled sideways: hand it to Windows to drop elsewhere
            // (only a clearly sideways pull on its own row: moving up or down
            // over other rows selects them instead). Only while the left button
            // is really held (never after a right click and its menu)
            if (!root.left-down) {
                return;
            }
            if (self.pressed && root.done && !root.dragged-out && root.drag-last == 0 && self.mouse-y >= 0 && self.mouse-y < root.height
                && abs(self.mouse-x - self.pressed-x) > 24px && abs(self.mouse-x - self.pressed-x) > 2 * abs(self.mouse-y - self.pressed-y)) {
                root.dragged-out = true;
                root.drag-out();
                return;
            }
            if (self.pressed && floor(self.mouse-y / root.height) != root.drag-last) {
                root.drag-last = floor(self.mouse-y / root.height);
                root.drag(root.drag-last);
            }
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.left-down = true;
                root.drag-last = 0;
                root.dragged-out = false;
                root.pick(ev.modifiers.control, ev.modifiers.shift);
            }
            if (ev.kind == PointerEventKind.cancel || (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left)) {
                root.left-down = false;
            }
            // right click, as in Explorer: the row is selected the moment the
            // button goes down (seen at once), the menu opens when it is let go
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                root.right-pick();
            }
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.right-pick();
                if (root.native-menu) {
                    root.open-native-menu();
                } else {
                    root.menu-x = self.mouse-x;
                    root.menu-y = self.mouse-y;
                    menu.show();
                }
            }
        }
    }
    property <length> menu-x;
    property <length> menu-y;
    property <color> kind-color: root.data.kind == "video" ? #a56bff : root.data.kind == "audio" ? #2fc76c
        : root.data.kind == "archive" ? #fb8a2e : root.data.kind == "exe" || root.data.kind == "apk" ? #3d8bf5
        : root.data.kind == "pdf" ? #ec4652 : root.data.kind == "image" ? #2ec4b6 : root.data.kind == "torrent" ? #f472b6 : #f0b323;
    property <bool> done: root.data.state == 3;
    property <bool> can-resume: root.data.state == 2 || root.data.state == 4;
    property <bool> can-stop: root.data.state == 0 || root.data.state == 1;
    property <length> queue-pop-y;
    queue-pop := PopupWindow {
        // beside where the menu was (Arabic: to its left)
        x: Theme.rtl ? max(0px, root.menu-x - 260px - 224px) : root.menu-x + 256px;
        y: root.queue-pop-y;
        width: 228px;
        height: queue-list.preferred-height;
        Rectangle {
            width: parent.width;
            height: queue-list.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 3px;
            queue-list := VerticalLayout {
                padding: 4px;
                spacing: 0px;
                MenuLabel {
                    text: @tr("Move to queue");
                }
                for q in root.queues: MenuEntry {
                    text: q.name;
                    glyph: root.data.queue == q.id ? "check" : "";
                    clicked => {
                        root.move-to-queue(q.id);
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Delete from queue");
                    enabled: root.data.queue != "";
                    clicked => {
                        root.move-to-queue(-1);
                    }
                }
            }
        }
    }
    menu := PopupWindow {
        // Arabic: the menu opens to the left of the mouse
        x: Theme.rtl ? max(0px, root.menu-x - 260px) : root.menu-x;
        y: root.menu-y;
        width: 260px;
        height: menu-list.preferred-height;
        Rectangle {
            width: parent.width;
            height: menu-list.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 3px;
            menu-list := VerticalLayout {
                padding: 4px;
                spacing: 0px;
                if root.sel-count > 1: MenuLabel {
                    text: @tr("{} downloads selected", root.sel-count);
                }
                MenuEntry {
                    text: root.done ? @tr("Open") : @tr("Show download progress");
                    glyph: root.done ? "play" : "progress";
                    bold: true;
                    clicked => {
                        root.activated();
                    }
                }
                MenuEntry {
                    text: @tr("Open with…");
                    glyph: "openwith";
                    enabled: root.done;
                    clicked => {
                        root.action("openwith");
                    }
                }
                if !root.done && (root.data.kind == "video" || root.data.kind == "audio"): MenuEntry {
                    text: @tr("Play while downloading");
                    glyph: "play";
                    glyph-color: #d6631d;
                    clicked => {
                        root.action("preview");
                    }
                }
                if (root.data.kind == "video" || root.data.kind == "audio") && root.sel-count <= 1: MenuEntry {
                    text: @tr("Download a part of it…");
                    glyph: "video";
                    clicked => {
                        root.action("clip");
                    }
                }
                MenuEntry {
                    text: @tr("Open folder");
                    glyph: "folder";
                    clicked => {
                        root.action("folder");
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Resume download");
                    glyph: "play";
                    glyph-color: #2e9e4f;
                    enabled: root.can-resume || root.sel-count > 1;
                    clicked => {
                        root.action("resume");
                    }
                }
                MenuEntry {
                    text: @tr("Stop download");
                    glyph: "pause";
                    glyph-color: #e08a00;
                    enabled: root.can-stop || root.sel-count > 1;
                    clicked => {
                        root.action("stop");
                    }
                }
                MenuEntry {
                    text: @tr("Redownload");
                    glyph: "redo";
                    clicked => {
                        root.action("restart");
                    }
                }
                MenuEntry {
                    text: @tr("Refresh download address…");
                    glyph: "refresh";
                    enabled: !root.done;
                    clicked => {
                        root.action("refresh");
                    }
                }
                MenuEntry {
                    text: @tr("Move / Rename…");
                    glyph: "edit";
                    clicked => {
                        root.action("move");
                    }
                }
                MenuSep { }
                // the queues open in a list of their own beside this menu
                // (many queues made the menu longer than the screen)
                MenuEntry {
                    text: @tr("Move to queue") + (Theme.rtl ? "   ◂" : "   ▸");
                    glyph: "queue";
                    clicked => {
                        root.queue-pop-y = root.menu-y + self.y;
                        queue-pop.show();
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Copy address");
                    glyph: "copy";
                    clicked => {
                        root.action("copy");
                    }
                }
                MenuEntry {
                    text: @tr("Check file (SHA-256)");
                    glyph: "hash";
                    enabled: root.done;
                    clicked => {
                        root.action("sha256");
                    }
                }
                MenuEntry {
                    text: @tr("Properties");
                    glyph: "info";
                    clicked => {
                        root.action("properties");
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Remove");
                    glyph: "close";
                    glyph-color: #e0443b;
                    clicked => {
                        root.action("delete");
                    }
                }
            }
        }
    }
    cells := HRow {
        padding-left: Theme.rtl ? (0px) : (6px);
        padding-right: Theme.rtl ? (6px) : (0px);
        spacing: 0px;
        Rectangle {
            width: Theme.depth ? 42px : 32px;
            // the 3D looks: the file's picture on a tile of its color
            if Theme.depth: Rectangle {
                x: 6px;
                y: (parent.height - 28px) / 2;
                width: 28px;
                height: 28px;
                border-radius: Theme.tile-style == 2 ? 7px : 9px;
                background: Theme.tile-style == 2 ? root.kind-color.transparentize(20%) : root.kind-color.transparentize(Theme.dark ? 78% : 82%);
                border-width: 1px;
                border-color: root.kind-color.transparentize(Theme.tile-style == 1 ? 10% : 55%);
                drop-shadow-blur: Theme.tile-style == 0 ? 0px : 9px;
                drop-shadow-color: root.kind-color.transparentize(55%);
            }
            TypeIcon {
                kind: root.data.kind;
                x: Theme.depth ? 11px : 4px;
                y: (parent.height - 18px) / 2;
            }
        }
        // the columns in the order and widths of the header
        for c in root.columns: Rectangle {
            width: c.width;
            // clip: long right-to-left (Arabic) names must never spill over
            clip: true;
            if c.key == "name": Cell {
                x: Theme.rtl ? 4px : 0px;
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.name;
                horizontal-alignment: root.data.name-rtl || Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }
            if c.key == "q": Cell {
                width: parent.width;
                height: parent.height;
                text: root.data.queue;
                horizontal-alignment: center;
                color: Theme.accent;
            }
            if c.key == "size": Cell {
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.size;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            }
            if c.key == "status": Rectangle {
                // thin progress line under the status, for running downloads
                if root.data.state == 1 || (root.data.state == 2 && root.data.progress > 0): Rectangle {
                    x: 10px;
                    y: parent.height - (Theme.depth ? 10px : 5px);
                    width: parent.width - 20px;
                    height: Theme.depth ? 5px : 3px;
                    border-radius: Theme.depth ? 2.5px : 1.5px;
                    background: Theme.bar-bg;
                    Rectangle {
                        x: Theme.rtl ? parent.width - self.width : 0;
                        width: parent.width * root.data.progress;
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: Theme.depth
                            ? (root.data.state == 1 ? @linear-gradient(90deg, Theme.bar-a 0%, Theme.bar-b 100%) : @linear-gradient(90deg, #ffc24a 0%, #e08a00 100%))
                            : root.data.state == 1 ? Theme.accent : Theme.warn;
                        animate width {
                            duration: 250ms;
                            easing: linear;
                        }
                    }
                }
                Cell {
                    width: parent.width;
                    height: parent.height - 2px;
                    text: root.data.status;
                    horizontal-alignment: center;
                    color: root.data.state == 3 ? Theme.ok : root.data.state == 4 ? Theme.err : root.data.state == 1 ? Theme.accent : Theme.text;
                }
            }
            if c.key == "eta": Cell {
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.eta;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            }
            if c.key == "speed": Cell {
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.speed;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            }
            if c.key == "last": Cell {
                width: parent.width;
                height: parent.height;
                text: root.data.last-try;
                horizontal-alignment: center;
                color: Theme.muted;
            }
            if c.key == "desc": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.description;
                color: Theme.muted;
            }
            if c.key == "added": Cell {
                width: parent.width;
                height: parent.height;
                text: root.data.added;
                horizontal-alignment: center;
                color: Theme.muted;
            }
            if c.key == "saveto": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.save-to;
                color: Theme.muted;
            }
            if c.key == "referer": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.referer;
                color: Theme.muted;
            }
            if c.key == "parent": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.parent;
                color: Theme.muted;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
}

// right click menu of the sidebar (categories and queues)
component TreeMenu inherits PopupWindow {
    in property <string> target;
    in property <bool> is-queue;
    in property <bool> builtin;
    callback chosen(string);
    width: 210px;
    height: tm-list.preferred-height;
    Rectangle {
        width: parent.width;
        height: tm-list.preferred-height;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 4px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000055;
        drop-shadow-offset-y: 3px;
        tm-list := VerticalLayout {
            padding: 4px;
            if root.is-queue: MenuEntry {
                text: @tr("Start queue");
                glyph: "play";
                glyph-color: #2e9e4f;
                clicked => {
                    root.chosen("start");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("Stop queue");
                glyph: "stop";
                glyph-color: #e0443b;
                clicked => {
                    root.chosen("stop");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("Edit queue / schedule…");
                glyph: "clock";
                clicked => {
                    root.chosen("edit");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("New queue…");
                glyph: "plus";
                clicked => {
                    root.chosen("new");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("Delete queue");
                glyph: "close";
                glyph-color: #e0443b;
                enabled: !root.builtin;
                clicked => {
                    root.chosen("delete");
                }
            }
            if !root.is-queue: MenuEntry {
                text: @tr("Add category…");
                glyph: "plus";
                clicked => {
                    root.chosen("add");
                }
            }
            if !root.is-queue && root.target != "": MenuEntry {
                text: @tr("Delete category");
                glyph: "close";
                glyph-color: #e0443b;
                enabled: !root.builtin;
                clicked => {
                    root.chosen("delete");
                }
            }
            if !root.is-queue && root.target != "": MenuEntry {
                text: @tr("Properties…");
                glyph: "info";
                clicked => {
                    root.chosen("props");
                }
            }
        }
    }
}

// a sidebar item with its own right click menu
component CtxTreeItem inherits TreeItem {
    in property <bool> is-queue;
    in property <bool> builtin;
    in property <string> target;
    callback chosen(string);
    property <length> mx;
    property <length> my;
    context(x, y) => {
        self.mx = x;
        self.my = y;
        pm.show();
    }
    pm := TreeMenu {
        x: Theme.rtl ? max(0px, root.mx - 210px) : root.mx;
        y: root.my;
        target: root.target;
        is-queue: root.is-queue;
        builtin: root.builtin;
        chosen(a) => {
            root.chosen(a);
        }
    }
}

export component MainWindow inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Ezoo Download");
    // Options > General > Background picture (shows through the panels)
    in property <image> bg-image;
    in property <bool> has-bg-image;
    // the size the window opens with
    preferred-width: 960px;
    preferred-height: 500px;
    min-width: 700px;
    min-height: 380px;

    in property <[DownloadRow]> rows;
    in property <[QueueRow]> queues;
    in property <[CatRow]> categories;
    // counts: all, unfinished, finished
    in property <string> count-all;
    in property <string> count-unfinished;
    in property <string> count-finished;
    in-out property <int> selected-id: -1;
    // "all", "cat:Video", "unfinished", "unf:Video", "finished", "fin:Video", "queue:3"
    in-out property <string> view: "all";
    in-out property <string> search;
    in property <string> status-text;
    in property <string> limiter-text;
    in property <int> selected-state: -1;
    // multiple selection: how many, and whether any can be resumed / stopped
    in property <int> sel-count;
    in property <bool> can-resume;
    in property <bool> can-stop;
    in property <int> current-queue: 1;
    in property <bool> limiter-on;
    in property <bool> hide-categories;
    in property <string> sort-by: "date";
    in property <bool> sort-desc: true;
    // Downloads > When all downloads finish: 0 nothing, 1 shut down, 2 sleep, 3 exit, 4 hibernate
    in property <int> all-done: 0;
    in property <Cols> cols: { q: true, size: true, status: true, eta: true, speed: true, last: true, desc: true };
    in property <bool> toolbar-small;
    in property <string> language: "en";
    in-out property <bool> open-all: true;
    in-out property <bool> open-unf: false;
    in-out property <bool> open-fin: false;
    in-out property <bool> open-queues: true;

    callback add-url();
    callback add-batch();
    callback add-batch-clipboard();
    callback resume(int);
    callback pause(int);
    callback resume-all();
    callback stop-all();
    callback delete(int);
    callback delete-completed();
    callback open-settings(int);
    callback open-scheduler();
    callback open-limiter();
    callback toggle-limiter();
    callback start-queue(int);
    callback stop-queue(int);
    callback new-queue();
    callback edit-queue(int);
    callback delete-queue(int);
    callback view-changed(string);
    callback search-changed();
    callback sort(string);
    callback row-activated(int);
    callback row-clicked(int, bool, bool);
    callback row-right(int);
    // the right-click menu as a Windows menu
    in property <bool> native-menu;
    callback row-menu(int);
    callback row-drag(int, int);
    callback row-drag-out(int);
    // the list's columns (order + widths); dragging in the header changes them
    in property <[ColDef]> columns;
    callback column-resized(int, length);
    callback column-dropped(int, length);
    callback columns-changed();
    pure function col-title(k: string) -> string {
        if (k == "name") { return @tr("File Name"); }
        if (k == "q") { return @tr("Q"); }
        if (k == "size") { return @tr("Size"); }
        if (k == "status") { return @tr("Status"); }
        if (k == "eta") { return @tr("Time left"); }
        if (k == "speed") { return @tr("Transfer rate"); }
        if (k == "last") { return @tr("Last Try Date"); }
        if (k == "desc") { return @tr("Description"); }
        if (k == "added") { return @tr("Date Added"); }
        if (k == "saveto") { return @tr("Save To"); }
        if (k == "referer") { return @tr("Referer"); }
        if (k == "parent") { return @tr("Parent Web Page"); }
        return k;
    }
    pure function col-sort-key(k: string) -> string {
        if (k == "q") { return ""; }
        if (k == "last") { return "date"; }
        return k;
    }
    callback select-all();
    callback row-action(int, string);
    // the keyboard: the next / earlier row (-1 / 1), the first / last (-2 / 2)
    callback move-selection(int, bool);
    callback show-shortcuts();
    callback row-to-queue(int, int);
    callback open-download-folder();
    callback export-list(string);
    callback import-list(string);
    callback set-theme(int);
    callback set-language(string);
    callback toggle-categories();
    callback set-toolbar-small(bool);
    callback open-columns();
    callback update-tools();
    callback check-app-update();
    callback set-all-done(int);
    callback add-category();
    callback category-props(string);
    callback delete-category(string);
    callback find();
    callback find-next();
    callback grabber();
    callback playlist();
    callback clip-part();
    callback torrent();
    callback browsers();
    callback tips();
    callback about();
    callback quit();

    MenuBar {
        Menu {
            title: @tr("Tasks");
            MenuItem {
                title: @tr("Add new download…");
                activated => {
                    root.add-url();
                }
            }
            MenuItem {
                title: @tr("Add batch download…");
                activated => {
                    root.add-batch();
                }
            }
            MenuItem {
