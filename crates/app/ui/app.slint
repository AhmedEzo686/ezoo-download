    }

    function category-menu(target: string, a: string) {
        if (a == "add") {
            root.add-category();
        } else if (a == "delete") {
            root.delete-category(target);
        } else if (a == "props") {
            root.category-props(target);
        }
    }
    function queue-menu-action(q: int, a: string) {
        if (a == "start") {
            root.start-queue(q);
        } else if (a == "stop") {
            root.stop-queue(q);
        } else if (a == "edit") {
            root.edit-queue(q);
        } else if (a == "new") {
            root.new-queue();
        } else if (a == "delete") {
            root.delete-queue(q);
        }
    }

    property <length> qmenu-x;
    property <bool> qmenu-start: true;
    queue-menu := PopupWindow {
        x: Theme.rtl ? max(0px, root.qmenu-x + max(62px, 62px * Theme.font-scale) - 220px) : root.qmenu-x;
        y: max(66px, 40px + 26px * Theme.font-scale);
        width: 220px;
        height: qm-list.preferred-height;
        Rectangle {
            width: parent.width;
            height: qm-list.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000055;
            qm-list := VerticalLayout {
                padding: 4px;
                MenuLabel {
                    text: root.qmenu-start ? @tr("Start queue") : @tr("Stop queue");
                }
                for q in root.queues: MenuEntry {
                    text: q.name;
                    glyph: q.running ? "play" : "";
                    glyph-color: #2e9e4f;
                    indent: true;
                    clicked => {
                        if (root.qmenu-start) {
                            root.start-queue(q.id);
                        } else {
                            root.stop-queue(q.id);
                        }
                    }
                }
            }
        }
    }

    if root.has-bg-image: Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: root.bg-image;
        image-fit: cover;
    }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "a" || event.text == "A" || event.text == "ش")) {
                root.select-all();
                return accept;
            }
            if (event.text == Key.Delete && root.selected-id >= 0) {
                root.delete(root.selected-id);
                return accept;
            }
            // Alt+Enter: the download's properties
            if (event.text == Key.Return && event.modifiers.alt && root.selected-id >= 0) {
                root.row-action(root.selected-id, "properties");
                return accept;
            }
            if (event.text == Key.Return && root.selected-id >= 0) {
                root.row-activated(root.selected-id);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.move-selection(-1, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-selection(1, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.Home) {
                root.move-selection(-2, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.End) {
                root.move-selection(2, event.modifiers.shift);
                return accept;
            }
            // F2: rename / move the file
            if (event.text == Key.F2 && root.selected-id >= 0) {
                root.row-action(root.selected-id, "move");
                return accept;
            }
            if (event.text == Key.F1) {
                root.show-shortcuts();
                return accept;
            }
            if (event.modifiers.control && (event.text == "r" || event.text == "R" || event.text == "ق") && root.selected-id >= 0) {
                root.row-action(root.selected-id, "resume");
                return accept;
            }
            if (event.modifiers.control && (event.text == "s" || event.text == "S" || event.text == "س") && root.selected-id >= 0) {
                root.row-action(root.selected-id, "stop");
                return accept;
            }
            if (event.modifiers.control && (event.text == "o" || event.text == "O" || event.text == "خ") && root.selected-id >= 0) {
                root.row-action(root.selected-id, "open");
                return accept;
            }
            if (event.modifiers.control && (event.text == "e" || event.text == "E" || event.text == "ث") && root.selected-id >= 0) {
                root.row-action(root.selected-id, "folder");
                return accept;
            }
            if (event.text == Key.F3) {
                root.find-next();
                return accept;
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F" || event.text == "ب")) {
                root.find();
                return accept;
            }
            // the selected downloads' addresses / a copied link to download
            if (event.modifiers.control && (event.text == "c" || event.text == "C") && root.selected-id >= 0) {
                root.row-action(root.selected-id, "copy");
                return accept;
            }
            if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                root.add-url();
                return accept;
            }
            if (event.modifiers.control && (event.text == "n" || event.text == "N" || event.text == "ى")) {
                root.add-url();
                return accept;
            }
            if (event.modifiers.control && (event.text == "b" || event.text == "B" || event.text == "لا" || event.text == "ﻻ")) {
                root.add-batch();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // ---- toolbar: when the buttons with their names don't fit (bigger
            // text, a narrow window), they show their pictures only; what still
            // does not fit is cut at the end (the left in Arabic), never the
            // first buttons
            tb := Rectangle {
                // 13 + 2 wider buttons, 5 lines between them, the filter box
                property <length> full-need: 13 * max(56px, 56px * Theme.font-scale) + 2 * max(62px, 62px * Theme.font-scale) + 5 * 7px + 14px + 96px + 16px;
                property <length> small-need: 15 * 34px + 5 * 7px + 14px + 96px + 16px;
                // only with bigger text (at the usual size the last buttons
                // are cut in a narrow window, as before)
                property <bool> small-now: root.toolbar-small || (Theme.font-scale > 1.05 && self.width < self.full-need);
                // bigger text (Options > Appearance): a taller bar, the names are never cut
                height: tb.small-now ? 42px : max(64px, 38px + 26px * Theme.font-scale);
                min-width: 0px;
                clip: true;
                background: @linear-gradient(180deg, Theme.toolbar-top 0%, Theme.toolbar-bottom 100%);
                HRow {
                    width: max(parent.width, tb.small-now ? tb.small-need : tb.full-need);
                    x: Theme.rtl ? parent.width - self.width : 0;
                    padding: 4px;
                    padding-left: Theme.rtl ? (10px) : (6px);
                    padding-right: Theme.rtl ? (6px) : (10px);
                    spacing: 1px;
                    ToolBtn {
                        icon: "add";
                        text: @tr("Add URL");
                        small: tb.small-now;
                        clicked => {
                            root.add-url();
                        }
                    }
                    ToolBtn {
                        icon: "batch";
                        text: @tr("Add Batch");
                        small: tb.small-now;
                        clicked => {
                            root.add-batch();
                        }
                    }
                    ToolSeparator { }
                    ToolBtn {
                        icon: "resume";
                        text: @tr("Resume");
                        small: tb.small-now;
                        enabled: root.can-resume;
                        clicked => {
                            root.resume(root.selected-id);
                        }
                    }
                    ToolBtn {
                        icon: "stop";
                        text: @tr("Stop");
                        small: tb.small-now;
                        enabled: root.can-stop;
                        clicked => {
                            root.pause(root.selected-id);
                        }
                    }
                    ToolBtn {
                        icon: "stopall";
                        text: @tr("Stop All");
                        small: tb.small-now;
                        clicked => {
                            root.stop-all();
                        }
                    }
                    ToolSeparator { }
                    ToolBtn {
                        icon: "delete";
                        text: @tr("Delete");
                        small: tb.small-now;
                        enabled: root.selected-id >= 0;
                        clicked => {
                            root.delete(root.selected-id);
                        }
                    }
                    ToolBtn {
                        icon: "deletedone";
                        text: @tr("Delete Done");
                        small: tb.small-now;
                        clicked => {
                            root.delete-completed();
                        }
                    }
                    ToolSeparator { }
                    ToolBtn {
                        icon: "options";
                        text: @tr("Options");
                        small: tb.small-now;
                        clicked => {
                            root.open-settings(0);
                        }
                    }
                    ToolBtn {
                        icon: "scheduler";
                        text: @tr("Scheduler");
                        small: tb.small-now;
                        clicked => {
                            root.open-scheduler();
                        }
                    }
                    ToolBtn {
                        icon: "limiter";
                        text: root.limiter-on ? @tr("Limiter: On") : @tr("Limiter: Off");
                        small: tb.small-now;
                        clicked => {
                            root.toggle-limiter();
                        }
                    }
                    ToolSeparator { }
                    start-q := ToolBtn {
                        icon: "startqueue";
                        text: @tr("Start Queue");
                        small: tb.small-now;
                        width: tb.small-now ? 34px : max(62px, 62px * Theme.font-scale);
                        clicked => {
                            root.qmenu-start = true;
                            root.qmenu-x = self.x;
                            queue-menu.show();
                        }
                    }
                    stop-q := ToolBtn {
                        icon: "stopqueue";
                        text: @tr("Stop Queue");
                        small: tb.small-now;
                        width: tb.small-now ? 34px : max(62px, 62px * Theme.font-scale);
                        clicked => {
                            root.qmenu-start = false;
                            root.qmenu-x = self.x;
                            queue-menu.show();
                        }
                    }
                    ToolSeparator { }
                    ToolBtn {
                        icon: "grabber";
                        text: @tr("Grabber");
                        small: tb.small-now;
                        clicked => {
                            root.grabber();
                        }
                    }
                    ToolBtn {
                        icon: "playlist";
                        text: @tr("Playlist");
                        small: tb.small-now;
                        clicked => {
                            root.playlist();
                        }
                    }
                    ToolBtn {
                        icon: "torrent";
                        text: @tr("Torrent");
                        small: tb.small-now;
                        clicked => {
                            root.torrent();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        LineEdit {
                            width: 96px;
                            placeholder-text: @tr("Filter the list…");
                            text <=> root.search;
                            edited(t) => {
                                root.search-changed();
                            }
                        }
                    }
                }
                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.line;
                }
            }

            HRow {
                vertical-stretch: 1;
                padding: 4px;
                spacing: 4px;
                // ---- tree
                if !root.hide-categories: Rectangle {
                    width: 210px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line;
                    VerticalLayout {
                        padding: 2px;
                        Rectangle {
                            height: 23px;
                            background: Theme.window;
                            Text {
                                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                x: 6px;
                                width: parent.width - 12px;
                                height: parent.height;
                                text: @tr("Categories");
                                vertical-alignment: center;
                                font-size: 12px * Theme.font-scale;
                                font-weight: 600;
                                color: Theme.text;
                            }
                        }
                        Flickable {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                CtxTreeItem {
                                    text: @tr("All Downloads");
                                    icon: "folder";
                                    bold: true;
                                    expandable: true;
                                    expanded: root.open-all;
                                    count: root.count-all;
                                    selected: root.view == "all";
                                    clicked => {
                                        root.view = "all";
                                        root.view-changed(root.view);
                                    }
                                    toggle => {
                                        root.open-all = !root.open-all;
                                    }
                                    builtin: true;
                                    chosen(a) => {
                                        root.category-menu("", a);
                                    }
                                }
                                if root.open-all: VerticalLayout {
                                    for c in root.categories: CtxTreeItem {
                                        text: c.label;
                                        icon: c.kind;
                                        indent: 1;
                                        count: c.count;
                                        target: c.name;
                                        builtin: c.builtin;
                                        selected: root.view == "cat:" + c.name;
                                        clicked => {
                                            root.view = "cat:" + c.name;
                                            root.view-changed(root.view);
                                        }
                                        chosen(a) => {
                                            root.category-menu(c.name, a);
                                        }
                                    }
                                }
                                TreeItem {
                                    text: @tr("Unfinished");
                                    icon: "unfinished";
                                    expandable: true;
                                    expanded: root.open-unf;
                                    count: root.count-unfinished;
                                    selected: root.view == "unfinished";
                                    clicked => {
                                        root.view = "unfinished";
                                        root.view-changed(root.view);
                                    }
                                    toggle => {
                                        root.open-unf = !root.open-unf;
                                    }
                                }
                                if root.open-unf: VerticalLayout {
                                    for c in root.categories: TreeItem {
                                        text: c.label;
                                        icon: c.kind;
                                        indent: 1;
                                        count: c.unfinished;
                                        selected: root.view == "unf:" + c.name;
                                        clicked => {
                                            root.view = "unf:" + c.name;
                                            root.view-changed(root.view);
                                        }
                                    }
                                }
                                TreeItem {
                                    text: @tr("Finished");
                                    icon: "finished";
                                    expandable: true;
                                    expanded: root.open-fin;
                                    count: root.count-finished;
                                    selected: root.view == "finished";
                                    clicked => {
                                        root.view = "finished";
                                        root.view-changed(root.view);
                                    }
                                    toggle => {
                                        root.open-fin = !root.open-fin;
                                    }
                                }
                                if root.open-fin: VerticalLayout {
                                    for c in root.categories: TreeItem {
                                        text: c.label;
                                        icon: c.kind;
                                        indent: 1;
                                        count: c.finished;
                                        selected: root.view == "fin:" + c.name;
                                        clicked => {
                                            root.view = "fin:" + c.name;
                                            root.view-changed(root.view);
                                        }
                                    }
                                }
                                TreeItem {
                                    text: @tr("Queues");
                                    icon: "folder";
                                    bold: true;
                                    expandable: true;
                                    expanded: root.open-queues;
                                    toggle => {
                                        root.open-queues = !root.open-queues;
                                    }
                                    clicked => {
                                        root.open-queues = !root.open-queues;
                                    }
                                }
                                if root.open-queues: VerticalLayout {
                                    for q in root.queues: CtxTreeItem {
                                        is-queue: true;
                                        builtin: q.id == 1;
                                        target: q.name;
                                        text: q.running ? @tr("{} (running)", q.name) : q.name;
                                        icon: "queue";
                                        indent: 1;
                                        count: q.count > 0 ? q.count : "";
                                        selected: root.view == "queue:" + q.id;
                                        clicked => {
                                            root.view = "queue:" + q.id;
                                            root.view-changed(root.view);
                                        }
                                        toggle => {
                                            root.edit-queue(q.id);
                                        }
                                        chosen(a) => {
                                            root.queue-menu-action(q.id, a);
                                        }
                                    }
                                }
                            }
                        }
                        HRow {
                            padding: 4px;
                            spacing: 4px;
                            Button {
                                text: @tr("New queue");
                                horizontal-stretch: 1;
                                clicked => {
                                    root.new-queue();
                                }
                            }
                            Button {
                                text: @tr("Edit");
                                clicked => {
                                    root.edit-queue(root.current-queue);
                                }
                            }
                        }
                    }
                }

                // ---- list (columns that don't fit are cut off on the right)
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 300px;
                    clip: true;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line;
                    VerticalLayout {
                        padding: 1px;
                        Rectangle {
                            height: 24px;
                            background: @linear-gradient(180deg, Theme.header-top 0%, Theme.header-bottom 100%);
                            clip: true;
                            // scrolls sideways together with the list (wide columns)
                            hdr := HRow {
                                x: lv.content-x;
                                width: max(parent.width, lv.content-width);
                                padding-left: Theme.rtl ? (0px) : (6px);
                                padding-right: Theme.rtl ? (6px) : (0px);
                                HeaderCell {
                                    text: "";
                                    width: 32px;
                                }
                                for c[i] in root.columns: HeaderCell {
                                    width: c.width;
                                    adjustable: true;
                                    text: root.col-title(c.key);
                                    key: root.col-sort-key(c.key);
                                    align: c.key == "size" || c.key == "eta" || c.key == "speed" ? TextHorizontalAlignment.right : c.key == "q" || c.key == "status" || c.key == "last" || c.key == "added" ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
                                    sort-by: root.sort-by;
                                    sort-desc: root.sort-desc;
                                    sort(k) => {
                                        root.sort(k);
                                    }
                                    resized(w) => {
                                        root.column-resized(i, w);
                                    }
                                    resize-done => {
                                        root.columns-changed();
                                    }
                                    dropped(x) => {
                                        // measured from the side where the columns start
                                        root.column-dropped(i, Theme.rtl ? hdr.width - x : x);
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            Rectangle {
                                x: 0;
                                y: parent.height - 1px;
                                width: parent.width;
                                height: 1px;
                                background: Theme.line;
                            }
                        }
                        lv := ListView {
                            vertical-stretch: 1;
                            // Arabic: wide columns start at the right edge, so
                            // the list first shows its right side
                            property <length> rtl-start: Theme.rtl ? min(0px, self.visible-width - self.content-width) : 0px;
                            changed rtl-start => {
                                self.content-x = self.rtl-start;
                            }
                            init => {
                                self.content-x = self.rtl-start;
                            }
                            for r in root.rows: DownloadItem {
                                // every row as wide as its columns: the mouse and
                                // the highlight reach the name in Arabic too
                                width: max(lv.visible-width, self.content-w);
                                data: r;
                                queues: root.queues;
                                cols: root.cols;
                                columns: root.columns;
                                selected: r.sel;
                                sel-count: root.sel-count;
                                native-menu: root.native-menu;
                                open-native-menu => {
                                    root.row-menu(r.id);
                                }
                                pick(ctrl, shift) => {
                                    root.row-clicked(r.id, ctrl, shift);
                                    keys.focus();
                                }
                                right-pick => {
                                    root.row-right(r.id);
                                }
                                drag(offset) => {
                                    root.row-drag(r.id, offset);
                                }
                                drag-out => {
                                    root.row-drag-out(r.id);
                                }
                                activated => {
                                    root.row-activated(r.id);
                                }
                                action(a) => {
                                    root.row-action(r.id, a);
                                }
                                move-to-queue(q) => {
                                    root.row-to-queue(r.id, q);
                                }
                            }
                        }
                    }
                    if root.rows.length == 0: Text {
                        x: 0;
                        y: 120px;
                        width: parent.width;
                        text: root.search != "" ? @tr("Nothing matches “{}”.", root.search) : @tr("No downloads here.\nClick “Add URL”, copy a link, or download something in your browser.");
                        horizontal-alignment: center;
                        color: Theme.muted;
                    }
                }
            }

            // ---- status bar
            Rectangle {
                height: 22px;
                background: Theme.window;
                Rectangle {
                    width: parent.width;
                    height: 1px;
                    y: 0;
                    background: Theme.line;
                }
                HRow {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.status-text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        font-size: 11px * Theme.font-scale;
                        color: Theme.muted;
                    }
                    // the speed limiter: on / off with one click
                    lim := Rectangle {
                        width: lim-row.preferred-width;
                        border-radius: 3px;
                        background: lim-ta.pressed ? Theme.line : lim-ta.has-hover ? Theme.hover : transparent;
                        lim-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.toggle-limiter();
                            }
                        }
                        lim-row := HRow {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 6px;
                            Rectangle {
                                width: 24px;
                                Rectangle {
                                    y: (parent.height - 12px) / 2;
                                    width: 24px;
                                    height: 12px;
                                    border-radius: 6px;
                                    background: root.limiter-on ? Theme.warn : Theme.line;
                                    Rectangle {
                                        x: (root.limiter-on != Theme.rtl) ? 14px : 2px;
                                        y: 2px;
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: white;
                                        animate x {
                                            duration: 120ms;
                                        }
                                    }
                                }
                            }
                            Text {
                                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                text: root.limiter-text;
                                vertical-alignment: center;
                                font-size: 11px * Theme.font-scale;
                                color: root.limiter-on ? Theme.warn : Theme.muted;
                            }
                        }
                    }
                }
            }
        }
    }
    // the note of the toolbar button the mouse rests on (drawn above everything)
    Timer {
        interval: 600ms;
        running: ToolTip.pending;
        triggered => {
            ToolTip.pending = false;
            ToolTip.shown = true;
        }
    }
    if ToolTip.shown && ToolTip.text != "": Rectangle {
        x: min(ToolTip.x, root.width - self.width - 6px);
        y: ToolTip.y;
        width: min(320px, tip-box.preferred-width);
        height: tip-box.preferred-height;
        background: Theme.input-bg;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 4px;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000044;
        drop-shadow-offset-y: 2px;
        tip-box := VerticalLayout {
            padding: 8px;
            spacing: 3px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: ToolTip.title;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: ToolTip.text;
                wrap: word-wrap;
                color: Theme.muted;
            }
        }
    }
}

// ------------------------------------------------------------------ dialogs

// "Download File Info" – shown for every new download.
export component AddDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download File Info");
    preferred-width: 640px;
    min-width: 540px;

    in-out property <string> url;
    // full path: folder + file name
    in-out property <string> save-as;
    in-out property <string> description;
    in-out property <string> checksum;
    in-out property <int> connections: 32;
    in-out property <int> category-index: 0;
    in-out property <bool> remember-path;
    in property <string> category-name: "General";
    in property <string> kind: "general";
    in property <string> ext;
    in property <string> size-text;
    in property <string> info;
    in property <bool> probing;
    in property <bool> info-error;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in property <[string]> category-names: ["General", "Compressed", "Documents", "Music", "Programs", "Video", "Images"];
    in-out property <bool> use-login;
    in-out property <string> user;
    in-out property <string> password;
    // a warning about the address (web page, duplicate...)
    in property <string> warning;
    // the server refused Ezoo Download: offer the browser instead
    in property <bool> can-use-browser;
    callback use-browser();

    callback check-url();
    callback category-changed(int);
    callback browse();
    callback start-now();
    callback later();
    callback cancel();

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HRow {
            spacing: 14px;
            GridLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 0;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("URL");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HRow {
                    col: Theme.rtl ? 0 : 1;
                    row: 0;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.url;
                        placeholder-text: @tr("https://example.com/file");
                        horizontal-stretch: 1;
                        accepted(t) => {
                            root.check-url();
                        }
                    }
                    Button {
                        text: @tr("Check");
                        clicked => {
                            root.check-url();
                        }
                    }
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 1;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Category");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HRow {
                    col: Theme.rtl ? 0 : 1;
                    row: 1;
                    ComboBox {
                        width: 200px;
                        model: root.category-names;
                        current-index <=> root.category-index;
                        selected(v) => {
                            root.category-changed(root.category-index);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 2;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Save As");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HRow {
                    col: Theme.rtl ? 0 : 1;
                    row: 2;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.save-as;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "…";
                        clicked => {
                            root.browse();
                        }
                    }
                }
                Rectangle {
                    col: Theme.rtl ? 1 : 0;
                    row: 3;
                }
                CheckBox {
                    col: Theme.rtl ? 0 : 1;
                    row: 3;
                    text: @tr("Remember this path for \"{}\" category", root.category-name);
                    checked <=> root.remember-path;
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 4;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Description");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    col: Theme.rtl ? 0 : 1;
                    row: 4;
                    text <=> root.description;
                    placeholder-text: @tr("optional note");
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 5;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Checksum");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    col: Theme.rtl ? 0 : 1;
                    row: 5;
                    text <=> root.checksum;
                    placeholder-text: @tr("MD5 / SHA-1 / SHA-256 (optional)");
                }
            }
            VerticalLayout {
                width: 110px;
                spacing: 6px;
                alignment: start;
                padding-top: 4px;
                BigTypeIcon {
                    kind: root.kind;
                    ext: root.ext;
                }
                Text {
                    text: root.size-text;
                    horizontal-alignment: center;
                    font-size: 12px * Theme.font-scale;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }
        HRow {
            spacing: 8px;
            CheckBox {
                text: @tr("Use authorization");
                checked <=> root.use-login;
            }
            if root.use-login: Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Login");
                vertical-alignment: center;
                color: Theme.text;
            }
            if root.use-login: LineEdit {
                text <=> root.user;
                horizontal-stretch: 1;
            }
            if root.use-login: Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Password");
                vertical-alignment: center;
                color: Theme.text;
            }
            if root.use-login: LineEdit {
                text <=> root.password;
                input-type: InputType.password;
                horizontal-stretch: 1;
            }
            if !root.use-login: Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.warning != "": GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 6px;
            Glyph {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                kind: "warn";
            }
            Text {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.warning;
                color: Theme.warn;
                wrap: word-wrap;
                font-size: 12px * Theme.font-scale;
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            height: 32px;
            border-width: 1px;
            border-color: root.info-error ? Theme.err : Theme.line;
            background: Theme.panel;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                vertical-alignment: center;
                text: root.probing ? @tr("Checking the address…") : root.info;
                color: root.info-error ? Theme.err : Theme.muted;
                overflow: elide;
                font-size: 12px * Theme.font-scale;
            }
        }
        HRow {
            spacing: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Connections");
                vertical-alignment: center;
                color: Theme.text;
            }
            SpinBox {
                width: 110px;
                minimum: 1;
                maximum: 64;
                value <=> root.connections;
            }
            Rectangle {
                width: 10px;
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Queue");
                vertical-alignment: center;
                color: Theme.text;
            }
            ComboBox {
                model: root.queue-names;
                current-index <=> root.queue-index;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        HRow {
            spacing: 8px;
            alignment: end;
            if root.can-use-browser: Button {
                text: @tr("Download with the browser");
                clicked => {
                    root.use-browser();
                }
            }
            if root.can-use-browser: Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Download Later");
                enabled: root.url != "";
                clicked => {
                    root.later();
                }
            }
            Button {
                text: @tr("Start Download");
                primary: true;
                enabled: root.url != "";
                clicked => {
                    root.start-now();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 26px;
    width: label.preferred-width + 24px;
    background: root.active ? Theme.panel : ta.has-hover ? Theme.hover : Theme.window;
    border-width: 1px;
    border-color: Theme.line;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px * Theme.font-scale;
        font-weight: root.active ? 600 : 400;
        color: Theme.text;
    }
    if root.active: Rectangle {
        x: 1px;
        y: parent.height - 1px;
        width: parent.width - 2px;
        height: 2px;
        background: Theme.panel;
    }
}

export component BatchDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Add batch download");
    preferred-width: 640px;
    preferred-height: 520px;

    // 0: list of links, 1: address with a * pattern
    in-out property <int> mode: 0;
    in-out property <string> links;
    in-out property <string> folder;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in-out property <bool> start-now: true;
    in property <string> message;
    // pattern
    in-out property <string> pattern;
    in-out property <bool> letters;
    in-out property <string> from-text: "1";
    in-out property <string> to-text: "10";
    in-out property <int> wildcard-size: 1;
    in-out property <string> user;
    in-out property <string> password;
    in property <string> preview;

    callback paste();
    callback browse();
    callback pattern-changed();
    callback ok();
    callback cancel();

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HRow {
            spacing: 2px;
            TabButton {
                text: @tr("List of links");
                active: root.mode == 0;
                clicked => {
                    root.mode = 0;
                }
            }
            TabButton {
                text: @tr("Address with a pattern (*)");
                active: root.mode == 1;
                clicked => {
                    root.mode = 1;
                    root.pattern-changed();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.mode == 0: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Paste the links, one per line. They download one after another in the queue you choose.");
                wrap: word-wrap;
                color: Theme.text;
            }
            TextEdit {
                text <=> root.links;
                vertical-stretch: 1;
                min-height: 200px;
                font-size: 12px * Theme.font-scale;
            }
            HRow {
                spacing: 6px;
                Button {
                    text: @tr("Paste from clipboard");
                    clicked => {
                        root.paste();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
        if root.mode == 1: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Type an address with a * where the number (or letter) goes, for example\nhttps://www.site.com/pictures/img*.jpg");
                wrap: word-wrap;
                color: Theme.text;
            }
            LineEdit {
                text <=> root.pattern;
                placeholder-text: @tr("https://www.site.com/pictures/img*.jpg");
                edited(t) => {
                    root.pattern-changed();
                }
            }
            HRow {
                spacing: 16px;
                CheckBox {
                    text: @tr("Letters (a-z) instead of numbers");
                    checked <=> root.letters;
                    toggled => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            HRow {
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("From");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.from-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("To");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.to-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Wildcard size");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                SpinBox {
                    width: 90px;
                    minimum: 1;
                    maximum: 10;
                    value <=> root.wildcard-size;
                    edited(v) => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Wildcard size 3 makes 001, 002 … 010.");
                color: Theme.muted;
                font-size: 11px * Theme.font-scale;
            }
            HRow {
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Login");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.user;
                    placeholder-text: @tr("optional");
                    horizontal-stretch: 1;
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Password");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.password;
                    input-type: InputType.password;
                    horizontal-stretch: 1;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 80px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    text: root.preview;
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        GridLayout {
            spacing: 8px;
            Text {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Queue");
                vertical-alignment: center;
                color: Theme.text;
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                ComboBox {
                    model: root.queue-names;
                    current-index <=> root.queue-index;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                col: Theme.rtl ? 1 : 0;
                row: 1;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Save all to");
                vertical-alignment: center;
                color: Theme.text;
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 1;
                spacing: 6px;
                LineEdit {
                    text <=> root.folder;
                    placeholder-text: @tr("automatic (by file type)");
                    horizontal-stretch: 1;
                }
                Button {
                    text: "…";
                    clicked => {
                        root.browse();
                    }
                }
            }
        }
        CheckBox {
            text: @tr("Start the queue now");
            checked <=> root.start-now;
        }
        HRow {
            spacing: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.message;
                color: Theme.err;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Add");
                primary: true;
                clicked => {
                    root.ok();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

// The per-download progress window (tabs like a classic download manager).
// A floating card of the 3D looks (the download window).
component DCard inherits Rectangle {
    border-radius: Theme.card-radius;
    background: @linear-gradient(180deg, Theme.card-top 0%, Theme.card-bottom 100%);
    border-width: 1px;
    border-color: Theme.card-line;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: Theme.look == 3 ? 3px : 2px;
    drop-shadow-color: Theme.card-shadow;
}

// One number of the download window in the 3D looks.
component StatCard inherits DCard {
    horizontal-stretch: 1;
    in property <string> label;
    in property <string> value;
    in property <color> tint: Theme.text;
    min-width: 0px;
    VerticalLayout {
        padding: 9px;
        padding-left: 11px;
        padding-right: 11px;
        spacing: 2px;
        Text {
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.label;
            font-size: 10.5px * Theme.font-scale;
            color: Theme.muted;
        }
        Text {
            min-width: 0px;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.value;
            font-size: 13px * Theme.font-scale;
            font-weight: 700;
            color: root.tint;
            overflow: elide;
        }
    }
}

export component DetailsDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: root.percent + " " + root.name;
    preferred-width: 500px;
    min-width: 440px;
    // the Windows title bar: a window drawn without it answered the mouse
    // in the wrong place on some Windows 10 / 11 computers

    in property <string> name;
    in property <string> percent;
    in property <string> url;
    in property <string> status;
    in property <string> size;
    in property <string> downloaded;
    in property <string> speed;
    in property <string> eta;
    in property <string> resumable;
    in property <bool> resumable-ok;
    in property <string> error;
    in property <string> kind: "general";
    in property <float> progress;
    // after the data: what it does now ("Joining…: 45%") and how far
    in property <string> step;
    in property <float> step-progress;
    in property <int> state;
    in property <[SegView]> segs;
    // the 3D looks: the progress ring and the speed of the last minute, as
    // drawings (made by the program)
    in property <string> ring-path;
    in property <string> speed-line;
    in property <string> speed-area;
    in-out property <bool> show-details: false;
    in-out property <int> tab: 0;
    // speed limiter tab
    in-out property <bool> limit-on;
    in-out property <int> limit-kb: 500;
    // options on completion tab
    in-out property <int> when-done: 0;
    in-out property <bool> complete-dialog: true;
    in-out property <bool> force-close;

    callback pause();
    callback resume();
    callback cancel-download();
    callback close-window();
    callback hide-to-tray();
    callback limit-changed();
    callback completion-changed();
    // "Hide details" / "Show details": the window takes the size it needs
    out property <length> content-height: outer.preferred-height;
    callback details-toggled();
    // a torrent: its files, people, trackers and pieces
    in property <bool> is-torrent;
    in property <[TFileRow]> t-files;
    in property <[TPeerRow]> t-peers;
    in property <[string]> t-trackers;
    in property <[PieceRun]> t-pieces;
    in property <string> t-summary;
    in-out property <int> t-view: 0;
    in-out property <bool> t-first-last;
    in-out property <string> t-new-tracker;
    in-out property <string> t-note;
    callback t-file-toggled(int);
    callback t-add-tracker();
    callback t-recheck();
    callback t-copy-magnet();
    callback t-first-last-changed();

    outer := VerticalLayout {
      padding: 0px;
      spacing: 0px;
      VerticalLayout {
        padding: 10px;
        spacing: 0px;
        HRow {
            spacing: 2px;
            TabButton {
                text: @tr("Download status");
                active: root.tab == 0;
                clicked => {
                    root.tab = 0;
                }
            }
            TabButton {
                text: @tr("Speed Limiter");
                active: root.tab == 1;
                clicked => {
                    root.tab = 1;
                }
            }
            TabButton {
                text: @tr("Options on completion");
                active: root.tab == 2;
                clicked => {
                    root.tab = 2;
                }
            }
            if root.is-torrent: TabButton {
                text: @tr("Torrent");
                active: root.tab == 3;
                clicked => {
                    root.tab = 3;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            background: Theme.depth && root.tab == 0 ? transparent : Theme.panel;
            border-width: Theme.depth && root.tab == 0 ? 0px : 1px;
            border-color: Theme.line;
            border-radius: Theme.depth ? Theme.card-radius : 0px;
            // its own size: a taller window gives the room to the connections
            vertical-stretch: root.show-details ? 0 : 1;
            // the 3D looks: the ring, the cards and the numbers
            min-height: Theme.depth && root.tab == 0 ? (root.error != "" ? 330px : 300px) * max(1, Theme.font-scale) : 150px;
            if root.tab == 0 && Theme.depth: VerticalLayout {
                padding: 10px;
                spacing: 10px;
                alignment: start;
                HRow {
                    spacing: 14px;
                    // how much is here, as a ring
                    Rectangle {
                        width: 150px;
                        height: 150px;
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 100;
                            viewbox-height: 100;
                            fill: transparent;
                            stroke: Theme.bar-bg;
                            stroke-width: 11px;
                            commands: "M 50 7 A 43 43 0 1 1 49.99 7";
                        }
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 100;
                            viewbox-height: 100;
                            fill: transparent;
                            stroke: @linear-gradient(135deg, Theme.bar-a 0%, Theme.bar-b 100%);
                            stroke-width: 11px;
                            commands: root.ring-path;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: root.percent;
                                horizontal-alignment: center;
                                font-size: 30px * Theme.font-scale;
                                font-weight: 800;
                                color: Theme.text;
                            }
                            Text {
                                text: root.speed;
                                horizontal-alignment: center;
                                font-size: 11px * Theme.font-scale;
                                color: Theme.muted;
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;
                        DCard {
                            HRow {
                                padding: 10px;
                                spacing: 10px;
                                Rectangle {
                                    width: 30px;
                                    TypeIcon {
                                        kind: root.kind;
                                        x: 3px;
                                        y: (parent.height - 22px) / 2;
                                        width: 22px;
                                        height: 22px;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        min-width: 0px;
                                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                        text: root.name;
                                        font-weight: 700;
                                        font-size: 13px * Theme.font-scale;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        min-width: 0px;
                                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                        text: root.url;
                                        font-size: 10.5px * Theme.font-scale;
                                        color: Theme.muted;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        // the speed of the last minute
                        DCard {
                            vertical-stretch: 1;
                            min-height: 84px;
                            Text {
                                x: Theme.rtl ? parent.width - self.width - 10px : 10px;
                                y: 6px;
                                text: @tr("Transfer rate");
                                font-size: 10.5px * Theme.font-scale;
                                color: Theme.muted;
                            }
                            Path {
                                x: 8px;
                                y: 22px;
                                width: parent.width - 16px;
                                height: parent.height - 28px;
                                viewbox-width: 200;
                                viewbox-height: 30;
                                fill: @linear-gradient(180deg, Theme.bar-a.transparentize(45%) 0%, Theme.bar-a.transparentize(100%) 100%);
                                stroke: transparent;
                                commands: root.speed-area;
                            }
                            Path {
                                x: 8px;
                                y: 22px;
                                width: parent.width - 16px;
                                height: parent.height - 28px;
                                viewbox-width: 200;
                                viewbox-height: 30;
                                fill: transparent;
                                stroke: Theme.bar-a;
                                stroke-width: 2px;
                                commands: root.speed-line;
                            }
                        }
                    }
                }
                GridLayout {
                    spacing: 8px;
                    StatCard {
                        row: 0;
                        col: Theme.rtl ? 2 : 0;
                        label: @tr("Status");
                        value: root.status;
                        tint: root.state == 4 ? Theme.err : Theme.text;
                    }
                    StatCard {
                        row: 0;
                        col: 1;
                        label: @tr("File size");
                        value: root.size;
                    }
                    StatCard {
                        row: 0;
                        col: Theme.rtl ? 0 : 2;
                        label: @tr("Downloaded");
                        value: root.downloaded;
                    }
                    StatCard {
                        row: 1;
                        col: Theme.rtl ? 2 : 0;
                        label: @tr("Transfer rate");
                        value: root.speed;
                    }
                    StatCard {
                        row: 1;
                        col: 1;
                        label: @tr("Time left");
                        value: root.eta;
                    }
                    StatCard {
                        row: 1;
                        col: Theme.rtl ? 0 : 2;
                        label: @tr("Resume capability");
                        value: root.resumable;
                        tint: root.resumable-ok ? Theme.ok : Theme.err;
                    }
                }
                if root.error != "": Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.error;
                    color: Theme.err;
                    wrap: word-wrap;
                    font-size: 11px * Theme.font-scale;
                }
            }
            if root.tab == 0 && !Theme.depth: VerticalLayout {
                padding: 8px;
                spacing: 4px;
                alignment: start;
                HRow {
                    spacing: 8px;
                    TypeIcon {
                        kind: root.kind;
                        width: 20px;
                        height: 20px;
                    }
                    Text {
                        // a long name is cut ("…"), it never makes the window wider
                        min-width: 0px;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.url;
                        font-size: 11px * Theme.font-scale;
                        overflow: elide;
                        color: Theme.accent;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.grid;
                }
                VerticalLayout {
                    spacing: 2px;
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Status");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.status;
                            color: root.state == 4 ? Theme.err : Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("File size");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.size;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Downloaded");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.downloaded;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Transfer rate");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.speed;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Time left");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.eta;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Resume capability");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.resumable;
                            color: root.resumable-ok ? Theme.ok : Theme.err;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
                if root.error != "": Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.error;
                    color: Theme.err;
                    wrap: word-wrap;
                    font-size: 11px * Theme.font-scale;
                }
            }
            if root.tab == 1: VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                HRow {
                    spacing: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Transfer rate");
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.speed;
                        color: Theme.text;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                CheckBox {
                    text: @tr("Use speed limiter for this download");
                    checked <=> root.limit-on;
                    toggled => {
                        root.limit-changed();
                    }
                }
                HRow {
                    spacing: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Maximum download speed (KB/s)");
                        color: root.limit-on ? Theme.text : Theme.muted;
                        vertical-alignment: center;
                    }
                    SpinBox {
                        width: 140px;
                        enabled: root.limit-on;
                        minimum: 1;
                        maximum: 1000000;
                        step-size: 50;
                        value <=> root.limit-kb;
                        edited(v) => {
                            root.limit-changed();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                HRow {
                    spacing: 6px;
                    for kb in [128, 256, 512, 1024, 2048, 5120]: Button {
                        text: kb >= 1024 ? @tr("{} MB/s", kb / 1024) : @tr("{} KB/s", kb);
                        clicked => {
                            root.limit-on = true;
                            root.limit-kb = kb;
                            root.limit-changed();
                        }
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Changes apply right away, even while downloading.");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                }
            }
            if root.tab == 2: VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("When this download completes:");
                    color: Theme.text;
                }
                ComboBox {
                    width: 300px;
                    model: [@tr("Do nothing (keep the computer on)"), @tr("Shut down the computer"), @tr("Sleep"), @tr("Exit Ezoo Download"), @tr("Hibernate")];
                    current-index <=> root.when-done;
                    selected(v) => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Force programs to close when shutting down");
                    checked <=> root.force-close;
                    enabled: root.when-done == 1;
                    toggled => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Show the \"Download complete\" window");
                    checked <=> root.complete-dialog;
                    toggled => {
                        root.completion-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("You get 30 seconds to cancel before the computer shuts down, sleeps or hibernates.");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
            // ---- a torrent: its pieces, files, people and trackers
            if root.tab == 3 && root.is-torrent: VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.t-summary;
                    color: Theme.muted;
                    font-size: 11px * Theme.font-scale;
                }
                // which pieces are here
                Rectangle {
                    height: 12px;
                    background: Theme.bar-bg;
                    border-width: 1px;
                    border-color: Theme.line;
                    clip: true;
                    for run in root.t-pieces: Rectangle {
                        y: 0px;
                        height: parent.height;
                        x: (Theme.rtl ? 1 - run.to : run.from) * parent.width;
                        width: max(1px, (run.to - run.from) * parent.width);
                        background: run.here ? Theme.accent : transparent;
                    }
                }
                HRow {
                    spacing: 2px;
                    TabButton {
                        text: @tr("Files");
                        active: root.t-view == 0;
                        clicked => {
                            root.t-view = 0;
                        }
                    }
                    TabButton {
                        text: @tr("People");
                        active: root.t-view == 1;
                        clicked => {
                            root.t-view = 1;
                        }
                    }
                    TabButton {
                        text: @tr("Trackers");
                        active: root.t-view == 2;
                        clicked => {
                            root.t-view = 2;
                        }
                    }
                }
                if root.t-view == 0: ListView {
                    height: 150px;
                    for f[i] in root.t-files: HRow {
                        spacing: 8px;
                        padding: 2px;
                        CheckBox {
                            text: "";
                            checked: f.selected;
                            toggled => {
                                root.t-file-toggled(i);
                            }
                        }
                        Text {
                            text: f.name;
                            color: Theme.text;
                            overflow: elide;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: f.size;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Text {
                            text: round(f.done * 100) + "%";
                            color: Theme.muted;
                            vertical-alignment: center;
                            width: 44px;
                        }
                    }
                }
                if root.t-view == 1: ListView {
                    height: 150px;
                    for p in root.t-peers: HRow {
                        spacing: 8px;
                        padding: 2px;
                        Text {
                            text: p.address + (p.seeder ? "  ★" : "");
                            color: Theme.text;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            overflow: elide;
                        }
                        Text {
                            text: "↓ " + p.down;
                            color: Theme.muted;
                        }
                        Text {
                            text: "↑ " + p.up;
                            color: Theme.muted;
                        }
                        Text {
                            text: p.have;
                            color: Theme.muted;
                            width: p.have == "" ? 0px : 44px;
                        }
                    }
                }
                if root.t-view == 2: VerticalLayout {
                    spacing: 6px;
                    ListView {
                        height: 118px;
                        for tr in root.t-trackers: Text {
                            text: tr;
                            color: Theme.text;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        LineEdit {
                            text <=> root.t-new-tracker;
                            placeholder-text: "udp://… / https://…";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: @tr("Add tracker");
                            clicked => {
                                root.t-add-tracker();
                            }
                        }
                    }
                }
                HRow {
                    spacing: 8px;
                    CheckBox {
                        text: @tr("First and last pieces first");
                        checked <=> root.t-first-last;
                        toggled => {
                            root.t-first-last-changed();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: @tr("Check the files again");
                        clicked => {
                            root.t-recheck();
                        }
                    }
                    Button {
                        text: @tr("Copy magnet link");
                        clicked => {
                            root.t-copy-magnet();
                        }
                    }
                }
                if root.t-note != "": Text {
                    text: root.t-note;
                    color: Theme.muted;
                    font-size: 11px * Theme.font-scale;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle {
            height: 8px;
        }
        Rectangle {
            height: Theme.depth ? 12px : 18px;
            border-width: Theme.depth ? 0px : 1px;
            border-color: Theme.line;
            border-radius: Theme.depth ? 6px : 0px;
            background: Theme.bar-bg;
            clip: true;
            Rectangle {
                x: Theme.rtl ? parent.width - 1px - self.width : 1px;
                y: 1px;
                height: parent.height - 2px;
                width: (parent.width - 2px) * root.progress;
                border-radius: Theme.depth ? 5px : 0px;
                background: Theme.depth ? @linear-gradient(90deg, Theme.bar-a 0%, Theme.bar-b 100%) : @linear-gradient(180deg, #4fd06a 0%, #1f9d3e 100%);
                animate width {
                    duration: 100ms;
                    easing: linear;
                }
            }
        }
        // the second bar: joining the picture and the sound, moving the file...
        if root.step != "": VerticalLayout {
            padding-top: 6px;
            spacing: 3px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.step;
                font-size: 11px * Theme.font-scale;
                color: Theme.text;
            }
            Rectangle {
                height: 12px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.bar-bg;
                clip: true;
                Rectangle {
                    x: Theme.rtl ? parent.width - 1px - self.width : 1px;
                    y: 1px;
                    height: parent.height - 2px;
                    width: (parent.width - 2px) * root.step-progress;
                    background: @linear-gradient(180deg, #5aa2ff 0%, #1d63d6 100%);
                    animate width {
                        duration: 250ms;
                        easing: linear;
                    }
                }
            }
        }
        Rectangle {
            height: 8px;
        }
        HRow {
            spacing: 8px;
            Button {
                text: root.show-details ? @tr("<< Hide details") : @tr("Show details >>");
                clicked => {
                    root.show-details = !root.show-details;
                    root.details-toggled();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            // the window goes, a small icon with the progress stays next to the clock
            if root.state != 3: Button {
                text: @tr("Next to the clock");
                clicked => {
                    root.hide-to-tray();
                }
            }
            if root.state == 0 || root.state == 1: Button {
                text: @tr("Pause");
                clicked => {
                    root.pause();
                }
            }
            if root.state == 2 || root.state == 4: Button {
                text: @tr("Resume");
                primary: true;
                clicked => {
                    root.resume();
                }
            }
            Button {
                text: root.state == 3 ? @tr("Close") : @tr("Cancel");
                clicked => {
                    if (root.state == 3) {
                        root.close-window();
                    } else {
                        root.cancel-download();
                    }
                }
            }
        }
        // a taller window gives its room to the list of connections (never
        // as empty space between the parts)
        if root.show-details: VerticalLayout {
            spacing: 6px;
            padding-top: 8px;
            vertical-stretch: 1;
            Text {
                vertical-stretch: 0;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Start positions and download progress by connections");
                font-size: 11px * Theme.font-scale;
                color: Theme.muted;
            }
            Rectangle {
                height: 20px;
                vertical-stretch: 0;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;
                clip: true;
                for s in root.segs: Rectangle {
                    x: Theme.rtl ? parent.width - 1px - (parent.width - 2px) * s.start - self.width : 1px + (parent.width - 2px) * s.start;
                    y: 1px;
                    width: (parent.width - 2px) * (s.done - s.start);
                    height: parent.height - 2px;
                    background: Theme.accent;
                    animate width {
                        duration: 100ms;
                        easing: linear;
                    }
                }
                for s in root.segs: Rectangle {
                    x: Theme.rtl ? parent.width - 2px - (parent.width - 2px) * s.start : 1px + (parent.width - 2px) * s.start;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: Theme.err;
                }
            }
            Rectangle {
                min-height: 150px;
                vertical-stretch: 1;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 1px;
                    Rectangle {
                        height: 22px;
                        background: @linear-gradient(180deg, Theme.header-top 0%, Theme.header-bottom 100%);
                        HRow {
                            HeaderCell {
                                text: @tr("N.");
                                width: 34px;
                            }
                            HeaderCell {
                                text: @tr("Downloaded");
                                width: 110px;
                            }
                            HeaderCell {
                                text: @tr("Info");
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for s in root.segs: Rectangle {
                            height: 19px;
                            HRow {
                                Cell {
                                    text: s.number;
                                    width: 34px;
                                    horizontal-alignment: center;
                                }
                                Cell {
                                    text: " " + s.downloaded;
                                    width: 110px;
                                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                }
                                Cell {
                                    text: s.info;
                                    horizontal-stretch: 1;
                                    color: s.busy ? Theme.accent : Theme.muted;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
}

// The finished file's icon with "Drag me" under it: pulled with the mouse,
// the file goes where it is let go (the desktop, a folder, a chat, an
// editor…) as a copy; the file itself stays where it is.
component DragFile inherits Rectangle {
    in property <string> kind;
    in property <string> ext;
    callback drag-out();
    property <bool> gone;
    min-width: max(72px, col.min-width);
    min-height: col.min-height;
    border-radius: 6px;
    background: ta.pressed ? Theme.select : ta.has-hover ? Theme.hover : transparent;
    border-width: ta.has-hover ? 1px : 0px;
    border-color: Theme.select-line;
    col := VerticalLayout {
        padding: 6px;
        spacing: 4px;
        alignment: start;
        BigTypeIcon {
            kind: root.kind;
            ext: root.ext;
        }
        HRow {
            alignment: center;
            spacing: 4px;
            // arrows to all four sides: "pull me"
            Rectangle {
                width: 14px;
                height: 14px;
                Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    stroke: Theme.accent;
                    stroke-width: 1.4px;
                    fill: transparent;
                    commands: "M 7 1 L 7 13 M 1 7 L 13 7 M 5 3 L 7 1 L 9 3 M 5 11 L 7 13 L 9 11 M 3 5 L 1 7 L 3 9 M 11 5 L 13 7 L 11 9";
                }
            }
            Text {
                text: @tr("Drag me");
                font-size: 11px * Theme.font-scale;
                color: Theme.accent;
                vertical-alignment: center;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.grab;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.gone = false;
            }
        }
        moved => {
            if (self.pressed && !root.gone && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px)) {
                root.gone = true;
                root.drag-out();
            }
        }
    }
}

export component CompleteDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download complete");
    preferred-width: 540px;

    in property <string> name;
    in property <string> size;
    in property <string> path;
    in property <string> url;
    in property <string> kind: "general";
    in property <string> ext;
    in-out property <bool> dont-show;

    callback open-file();
    callback open-with();
    callback open-folder();
    callback close-window();
    // the file pulled out of the window (onto the desktop, a folder, a chat…)
    callback drag-out();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 16px;
            DragFile {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                kind: root.kind;
                ext: root.ext;
                drag-out => {
                    root.drag-out();
                }
            }
            VerticalLayout {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Download complete");
                    font-size: 15px * Theme.font-scale;
                    font-weight: 700;
                    color: Theme.ok;
                }
                GridLayout {
                    spacing: 6px;
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 0;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Address");
                        color: Theme.muted;
                    }
                    Text {
                        // a long name is cut ("…"), it never makes the window wider
                        min-width: 0px;
                        col: Theme.rtl ? 0 : 1;
                        row: 0;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.url;
                        overflow: elide;
                        font-size: 11px * Theme.font-scale;
                        color: Theme.accent;
                    }
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 1;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("File size");
                        color: Theme.muted;
                    }
                    Text {
                        col: Theme.rtl ? 0 : 1;
                        row: 1;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.size;
                        color: Theme.text;
                    }
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 2;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Saved as");
                        color: Theme.muted;
                    }
                    Text {
                        col: Theme.rtl ? 0 : 1;
                        row: 2;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.path;
                        wrap: word-wrap;
                        font-size: 11px * Theme.font-scale;
                        color: Theme.text;
                    }
                }
            }
        }
        HRow {
            spacing: 8px;
            CheckBox {
                text: @tr("Don't show this again");
                checked <=> root.dont-show;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Open");
                primary: true;
                clicked => {
                    root.open-file();
                }
            }
            // no "Open with…" here: picked by mistake it changes which
            // program opens this kind of file (still in the list's menu)
            Button {
                text: @tr("Open folder");
                clicked => {
                    root.open-folder();
                }
            }
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}
